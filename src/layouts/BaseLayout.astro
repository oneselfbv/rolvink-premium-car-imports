---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';
import ChatbotWidget from '../components/ChatbotWidget.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noIndex?: boolean;
}

const {
  title,
  description = "Persoonlijke sourcing-service voor Duitse premium-auto's en -motoren uit Europa en Japan. BMW, Mercedes-Benz, Audi, Porsche.",
  ogImage = '/og-image.jpg',
  noIndex = false,
} = Astro.props;

const rawPath = Astro.url.pathname || '/';
const pathname = rawPath.endsWith('/') ? rawPath : rawPath + '/';
const canonicalURL = new URL(pathname, Astro.site).toString();

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://www.rolvinkpremiumcarimports.nl/#organization',
  name: 'Rolvink Premium Imports',
  url: 'https://www.rolvinkpremiumcarimports.nl/',
  logo: 'https://www.rolvinkpremiumcarimports.nl/favicon.svg',
  founder: { '@type': 'Person', name: 'Theo Rolvink', '@id': 'https://www.rolvinkpremiumcarimports.nl/over/#theo' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Veldweg 15',
    postalCode: '8196 KS',
    addressLocality: 'Welsum',
    addressRegion: 'Overijssel',
    addressCountry: 'NL',
  },
  telephone: '+31638441395',
  email: 'contact@rolvinkpremiumcarimports.nl',
  description: "Persoonlijke sourcing-service voor Duitse premium-auto's en -motoren (BMW, Mercedes-Benz, Audi, Porsche) uit Europa en Japan.",
  sameAs: [],
};

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': ['AutomotiveBusiness', 'AutoDealer'],
  '@id': 'https://www.rolvinkpremiumcarimports.nl/#localbusiness',
  name: 'Rolvink Premium Imports',
  url: 'https://www.rolvinkpremiumcarimports.nl/',
  image: 'https://www.rolvinkpremiumcarimports.nl/og-image.jpg',
  telephone: '+31638441395',
  email: 'contact@rolvinkpremiumcarimports.nl',
  priceRange: '€€€',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Veldweg 15',
    postalCode: '8196 KS',
    addressLocality: 'Welsum',
    addressRegion: 'Overijssel',
    addressCountry: 'NL',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 52.394,
    longitude: 6.141,
  },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
    opens: '09:00',
    closes: '18:00',
    description: 'Op afspraak',
  }],
  areaServed: { '@type': 'Country', name: 'Netherlands' },
  description: "Persoonlijke sourcing-service voor Duitse premium-auto's en -motoren uit Europa en Japan. Bezichtigingen en afspraken in Welsum, gemeente Olst-Wijhe.",
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Automotive Import Sourcing',
  provider: { '@type': 'Organization', name: 'Rolvink Premium Imports', '@id': 'https://www.rolvinkpremiumcarimports.nl/#organization' },
  areaServed: { '@type': 'Country', name: 'Netherlands' },
  description: "Persoonlijke sourcing van Duitse premium-auto's en -motoren (BMW, Mercedes-Benz, Audi, Porsche) uit Europa en Japan. Inclusief import, BPM, RDW-keuring en aflevering aan huis.",
  audience: { '@type': 'Audience', audienceType: 'Particuliere kopers en kleine dealers' },
};
---
<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  {noIndex && <meta name="robots" content="noindex,nofollow" />}
  {!noIndex && <meta name="robots" content="index,follow,max-image-preview:large" />}

  <meta name="google-site-verification" content="IbEdRJTvXwFSEJ18axbjZiBWKHgmbUKPQL150eOCIwM" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  {pathname === '/' && <link rel="preload" as="image" href="/images/hero-911.webp" type="image/webp" fetchpriority="high" />}

  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(ogImage, Astro.site)} />
  <meta property="og:locale" content="nl_NL" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&family=EB+Garamond:wght@500;600&family=Inter:wght@300;400;500;600&family=Inter+Tight:wght@500;600;700&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&family=EB+Garamond:wght@500;600&family=Inter:wght@300;400;500;600&family=Inter+Tight:wght@500;600;700&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&family=EB+Garamond:wght@500;600&family=Inter:wght@300;400;500;600&family=Inter+Tight:wght@500;600;700&display=swap" /></noscript>

  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <slot name="head" />

  <script is:inline>
    /* GA4 consent-gated: stub altijd aanwezig (geen cookies/netwerk); echte GA4 pas na toestemming */
    window.dataLayer = window.dataLayer || [];
    window.gtag = function(){ dataLayer.push(arguments); };
    window.rvLoadGA = function(){
      if (window.__rvGA) return; window.__rvGA = true;
      var s = document.createElement('script'); s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-QM941210BY';
      document.head.appendChild(s);
      gtag('js', new Date());
      gtag('config', 'G-QM941210BY', { anonymize_ip: true });
    };
    try { if (localStorage.getItem('rv-consent') === 'granted') window.rvLoadGA(); } catch (e) {}
  </script>
  <script is:inline>
    try { if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('reveal-on'); } catch (e) {}
  </script>
</head>
<body>
  <a href="#main" class="skip-link">Spring naar hoofdinhoud</a>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <StickyMobileCTA />
  <ChatbotWidget />
  <ConsentBanner />
  <script is:inline>
    (function(){
      var root = document.documentElement;
      if (!root.classList.contains('reveal-on')) return;
      var sel = '.content-section, .moto-card, .step, .usp, .tier, .moto-tariff, .incl-block, .pillar-card, .route-block, .intro';
      var els = [].slice.call(document.querySelectorAll(sel));
      if (!('IntersectionObserver' in window) || !els.length) { root.classList.remove('reveal-on'); return; }
      var io = new IntersectionObserver(function(ents){
        ents.forEach(function(en){ if (en.isIntersecting){ en.target.classList.add('is-visible'); io.unobserve(en.target); } });
      }, { rootMargin: '0px 0px -6% 0px', threshold: 0.04 });
      els.forEach(function(e){ io.observe(e); });
      setTimeout(function(){ els.forEach(function(e){ e.classList.add('is-visible'); }); }, 2600);
    })();
  </script>
</body>
</html>

<style is:global>
  /* Skip-link — visueel verborgen tot keyboard-focus (sr-only techniek) */
  .skip-link {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .skip-link:focus {
    position: fixed;
    top: 12px;
    left: 12px;
    width: auto;
    height: auto;
    margin: 0;
    overflow: visible;
    clip: auto;
    white-space: normal;
    padding: 8px 16px;
    background: var(--color-charcoal-dark);
    color: var(--color-cream);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    z-index: 1000;
    outline: 2px solid var(--color-copper);
    outline-offset: 2px;
  }

  /* Scroll-reveal — subtiel infaden van content (alleen wanneer JS .reveal-on zet; reduced-motion = uit) */
  .reveal-on .content-section,
  .reveal-on .moto-card,
  .reveal-on .step,
  .reveal-on .usp,
  .reveal-on .tier,
  .reveal-on .moto-tariff,
  .reveal-on .incl-block,
  .reveal-on .pillar-card,
  .reveal-on .route-block,
  .reveal-on .intro {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.55s ease, transform 0.55s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .reveal-on .is-visible { opacity: 1; transform: none; }

  /* Micro-interacties — pijltjes en links schuiven subtiel bij hover */
  @media (prefers-reduced-motion: no-preference) {
    .page-cta-btn .arrow, .hero-btn .arrow, .tier-cta .arrow, .tier-cta-feature .arrow { transition: transform 0.2s ease; }
    .page-cta-btn:hover .arrow, .hero-btn:hover .arrow, .tier-cta:hover .arrow, .tier-cta-feature:hover .arrow { transform: translateX(4px); }
    .moto-card .card-link { display: inline-block; transition: transform 0.2s ease; }
    .moto-card:hover .card-link { transform: translateX(3px); }
  }
</style>
