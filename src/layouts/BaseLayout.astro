---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noIndex?: boolean;
}

const {
  title,
  description = "Persoonlijke sourcing-service voor Duitse premium-auto's uit Europa en Japan. BMW, Mercedes-Benz, Audi, Porsche.",
  ogImage = '/og-image.jpg',
  noIndex = false,
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonicalURL = new URL(pathname, Astro.site).toString().replace(/\/$/, '');

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://rolvinkpremiumcarimports.nl/#organization',
  name: 'Rolvink Premium Car Imports',
  url: 'https://rolvinkpremiumcarimports.nl',
  logo: 'https://rolvinkpremiumcarimports.nl/favicon.svg',
  founder: { '@type': 'Person', name: 'Theo Rolvink', '@id': 'https://rolvinkpremiumcarimports.nl/over#theo' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Veldweg 15',
    postalCode: '8196 KS',
    addressLocality: 'Welsum',
    addressRegion: 'Overijssel',
    addressCountry: 'NL',
  },
  telephone: '+31638441395',
  email: 'contact@rolvinkpremiumcarimports.nl',
  description: "Persoonlijke sourcing-service voor Duitse premium-auto's (BMW, Mercedes-Benz, Audi, Porsche) uit Europa en Japan.",
  sameAs: [],
};

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'AutomotiveBusiness',
  '@id': 'https://rolvinkpremiumcarimports.nl/#localbusiness',
  name: 'Rolvink Premium Car Imports',
  url: 'https://rolvinkpremiumcarimports.nl',
  image: 'https://rolvinkpremiumcarimports.nl/og-image.jpg',
  telephone: '+31638441395',
  email: 'contact@rolvinkpremiumcarimports.nl',
  priceRange: '€€€',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Veldweg 15',
    postalCode: '8196 KS',
    addressLocality: 'Welsum',
    addressRegion: 'Overijssel',
    addressCountry: 'NL',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 52.394,
    longitude: 6.141,
  },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
    opens: '09:00',
    closes: '18:00',
    description: 'Op afspraak',
  }],
  areaServed: { '@type': 'Country', name: 'Netherlands' },
  description: "Persoonlijke sourcing-service voor Duitse premium-auto's uit Europa en Japan. Bezichtigingen en afspraken in Welsum, gemeente Olst-Wijhe.",
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Automotive Import Sourcing',
  provider: { '@type': 'Organization', name: 'Rolvink Premium Car Imports', '@id': 'https://rolvinkpremiumcarimports.nl/#organization' },
  areaServed: { '@type': 'Country', name: 'Netherlands' },
  description: "Persoonlijke sourcing van Duitse premium-auto's (BMW, Mercedes-Benz, Audi, Porsche) uit Europa en Japan. Inclusief import, BPM, RDW-keuring en aflevering aan huis.",
  audience: { '@type': 'Audience', audienceType: 'Particuliere kopers en kleine dealers' },
};
---
<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  {noIndex && <meta name="robots" content="noindex,nofollow" />}

  <meta name="google-site-verification" content="IbEdRJTvXwFSEJ18axbjZiBWKHgmbUKPQL150eOCIwM" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(ogImage, Astro.site)} />
  <meta property="og:locale" content="nl_NL" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&family=EB+Garamond:wght@500;600&family=Inter:wght@300;400;500;600&family=Inter+Tight:wght@500;600;700&display=swap" />

  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <slot name="head" />

  <script async src="https://www.googletagmanager.com/gtag/js?id=G-QM941210BY"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-QM941210BY', { anonymize_ip: true });
  </script>
</head>
<body>
  <a href="#main" class="skip-link">Spring naar hoofdinhoud</a>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <StickyMobileCTA />
</body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    top: -40px;
    left: 12px;
    padding: 8px 16px;
    background: var(--color-charcoal-dark);
    color: var(--color-cream);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    z-index: 1000;
    transition: top 0.2s;
  }
  .skip-link:focus {
    top: 12px;
    outline: 2px solid var(--color-copper);
    outline-offset: 2px;
  }
</style>
