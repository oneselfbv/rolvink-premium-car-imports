---
import LogoHorizontal from './LogoHorizontal.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { uiDict, pick, asLocale, routeFor, LOCALES, LOCALE_LABELS } from '../i18n';

interface Props {
  /** Route-key uit src/i18n/config.ts — voor de taalwisselaar. */
  i18nKey?: string;
}
const { i18nKey } = Astro.props;
const locale = asLocale(Astro.currentLocale);
const t = pick(uiDict, Astro.currentLocale);
---

<div class="topbar">
  <div class="container">
    <span class="topbar-tagline">{t.topbar.tagline}</span>
    <span class="topbar-right">
      <nav class="lang-switch" aria-label={t.langSwitcher.aria}>
        {LOCALES.map((l) => (
          l === locale
            ? <span class="lang-current" aria-current="true">{LOCALE_LABELS[l]}</span>
            : <a href={routeFor(i18nKey, l)} hreflang={l} rel="alternate">{LOCALE_LABELS[l]}</a>
        ))}
      </nav>
      <a href={t.topbar.ctaHref} class="topbar-cta">{t.topbar.ctaLabel}</a>
    </span>
  </div>
</div>

<header class="site-header">
  <div class="container">
    <div class="inner">
      <a href={t.header.homeHref} class="brand-link" aria-label={t.header.brandAria}>
        <LogoHorizontal width={240} />
      </a>

      <button
        class="menu-toggle"
        aria-label={t.header.menuOpenAria}
        aria-expanded="false"
        aria-controls="primary-nav"
        type="button"
      >
        <span class="menu-toggle-bar"></span>
        <span class="menu-toggle-bar"></span>
        <span class="menu-toggle-bar"></span>
      </button>

      <nav id="primary-nav" class="primary-nav" aria-label={t.header.navAria}>
        <ul>
          {t.header.nav.map((item) => (
            item.children ? (
              <li class="nav-sub">
                <button type="button" class="nav-sub-toggle" aria-expanded="false" aria-haspopup="true">
                  {item.label}<span class="nav-caret" aria-hidden="true"></span>
                </button>
                <ul class="nav-sub-menu">
                  {item.children.map((c) => (
                    <li><a href={c.href}>{c.label}</a></li>
                  ))}
                </ul>
              </li>
            ) : (
              <li><a href={item.href}>{item.label}</a></li>
            )
          ))}
          <li class="nav-lang-row" aria-hidden="false">
            {LOCALES.map((l) => (
              l === locale
                ? <span class="lang-current" aria-current="true">{LOCALE_LABELS[l]}</span>
                : <a class="nav-lang-link" href={routeFor(i18nKey, l)} hreflang={l} rel="alternate">{LOCALE_LABELS[l]}</a>
            ))}
          </li>
        </ul>
      </nav>

      <div class="header-cta">
        <WhatsAppButton />
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector('.menu-toggle');
  const nav = document.querySelector('.primary-nav');
  const body = document.body;

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    nav?.classList.toggle('is-open');
    body.classList.toggle('menu-open');
  });

  // Submenu ("Auto's"): klik opent/sluit; buiten klikken of Escape sluit. Hover/focus
  // opent op desktop via CSS; op mobiel staat het submenu altijd open.
  document.querySelectorAll('.nav-sub').forEach((sub) => {
    const btn = sub.querySelector('.nav-sub-toggle');
    btn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = sub.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', String(open));
    });
  });
  document.addEventListener('click', () => {
    document.querySelectorAll('.nav-sub.is-open').forEach((sub) => {
      sub.classList.remove('is-open');
      sub.querySelector('.nav-sub-toggle')?.setAttribute('aria-expanded', 'false');
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    document.querySelectorAll('.nav-sub.is-open').forEach((sub) => {
      sub.classList.remove('is-open');
      sub.querySelector('.nav-sub-toggle')?.setAttribute('aria-expanded', 'false');
    });
  });

  // Close menu when clicking a nav link (mobile UX)
  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      nav.classList.remove('is-open');
      body.classList.remove('menu-open');
    });
  });
</script>

<style>
  /* Taalwisselaar in de topbar */
  .topbar-right { display: inline-flex; align-items: center; gap: 20px; }
  .lang-switch { display: inline-flex; align-items: center; gap: 10px; }
  .lang-switch a { color: rgba(245, 241, 234, 0.65); font-weight: 400; }
  .lang-switch a:hover { color: var(--color-copper); }
  .lang-switch .lang-current { color: var(--color-cream); font-weight: 600; }

  /* Taalwisselaar in het mobiele menu */
  .nav-lang-row { display: none; }

  /* Submenu "Auto's" (desktop): knop in de menustijl + uitklaplijst */
  .nav-sub { position: relative; }
  .nav-sub-toggle {
    background: none; border: 0; padding: 0; margin: 0; cursor: pointer;
    font: inherit; color: inherit; display: inline-flex; align-items: center; gap: 6px;
  }
  .nav-sub-toggle:hover { color: var(--color-copper); }
  .nav-caret {
    width: 6px; height: 6px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor;
    transform: translateY(-2px) rotate(45deg); transition: transform 0.2s;
  }
  .nav-sub.is-open .nav-caret { transform: translateY(1px) rotate(-135deg); }
  .nav-sub-menu {
    display: none; position: absolute; top: calc(100% + 14px); left: -18px; min-width: 220px;
    background: var(--color-cream); border: 1px solid var(--color-border-soft);
    box-shadow: 0 12px 32px rgba(20, 18, 15, 0.12); padding: 8px 0; margin: 0; list-style: none; z-index: 150;
  }
  .nav-sub-menu::before { content: ""; position: absolute; top: -14px; left: 0; right: 0; height: 14px; }
  .nav-sub-menu li { display: block; }
  .nav-sub-menu a { display: block; padding: 10px 18px; white-space: nowrap; font-size: 14px; }
  .nav-sub-menu a:hover { background: var(--color-cream-warm); }
  .nav-sub:hover .nav-sub-menu,
  .nav-sub:focus-within .nav-sub-menu,
  .nav-sub.is-open .nav-sub-menu { display: block; }

  /* Smal scherm: tagline wijkt zodat taalkeuze + CTA passen */
  @media (max-width: 640px) {
    .topbar-tagline { display: none; }
    .topbar-right { width: 100%; justify-content: space-between; }
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    width: 44px;
    height: 44px;
    padding: 11px 8px;
    background: transparent;
    border: none;
    cursor: pointer;
    position: relative;
    z-index: 210;
  }
  .menu-toggle-bar {
    display: block;
    width: 28px;
    height: 2px;
    background: var(--color-charcoal-dark);
    transition: transform 0.25s ease, opacity 0.2s ease;
    transform-origin: center;
  }
  .menu-toggle[aria-expanded="true"] .menu-toggle-bar:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  .menu-toggle[aria-expanded="true"] .menu-toggle-bar:nth-child(2) {
    opacity: 0;
  }
  .menu-toggle[aria-expanded="true"] .menu-toggle-bar:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  @media (max-width: 900px) {
    .menu-toggle { display: flex; }
    .header-cta { display: none; }

    .primary-nav {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: var(--color-cream);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      transform: translateX(100%);
      transition: transform 0.3s ease;
      z-index: 200;
      visibility: hidden;
      overflow-y: auto;
    }
    .primary-nav.is-open {
      transform: translateX(0);
      visibility: visible;
    }
    .primary-nav ul {
      display: flex;
      flex-direction: column;
      gap: 26px;
      text-align: center;
      padding: 0;
      margin: 0;
    }
    .primary-nav a {
      font-family: var(--font-serif);
      font-size: 28px;
      letter-spacing: 0.04em;
      color: var(--color-charcoal-dark);
    }
    /* Submenu op mobiel: label + kinderen altijd zichtbaar, geen hover/klik nodig */
    .nav-sub-toggle {
      font-family: var(--font-serif);
      font-size: 28px;
      letter-spacing: 0.04em;
      color: var(--color-charcoal-dark);
      cursor: default;
      pointer-events: none;
      gap: 0;
    }
    .nav-caret { display: none; }
    .primary-nav .nav-sub-menu {
      display: flex; flex-direction: column; gap: 0; position: static; min-width: 0;
      background: none; border: 0; box-shadow: none; padding: 10px 0 0; margin: 0;
    }
    .nav-sub-menu::before { display: none; }
    .nav-sub-menu li { padding: 0; }
    .primary-nav .nav-sub-menu a {
      font-family: var(--font-sans, inherit);
      font-size: 16px;
      letter-spacing: 0.06em;
      padding: 4px 0;
      opacity: 0.8;
    }
    .nav-lang-row {
      display: flex;
      justify-content: center;
      gap: 18px;
      margin-top: 8px;
    }
    .primary-nav .nav-lang-row a,
    .nav-lang-row .lang-current {
      font-family: var(--font-sans, inherit);
      font-size: 15px;
      letter-spacing: 0.08em;
    }
    .nav-lang-row .lang-current { font-weight: 700; color: var(--color-copper-text, var(--color-copper)); }
    .nav-lang-row a { color: var(--color-charcoal-dark); opacity: 0.65; }
    :global(body.menu-open) { overflow: hidden; }
  }
</style>
