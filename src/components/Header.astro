---
import LogoHorizontal from './LogoHorizontal.astro';
import WhatsAppButton from './WhatsAppButton.astro';
---

<div class="topbar">
  <div class="container">
    <span>Persoonlijke sourcing — Japan & Duitsland</span>
    <a href="/contact">Plan gesprek →</a>
  </div>
</div>

<header class="site-header">
  <div class="container">
    <div class="inner">
      <a href="/" class="brand-link" aria-label="Rolvink Premium Car Imports — Home">
        <LogoHorizontal width={220} />
      </a>

      <button
        class="menu-toggle"
        aria-label="Menu openen"
        aria-expanded="false"
        aria-controls="primary-nav"
        type="button"
      >
        <span class="menu-toggle-bar"></span>
        <span class="menu-toggle-bar"></span>
        <span class="menu-toggle-bar"></span>
      </button>

      <nav id="primary-nav" class="primary-nav" aria-label="Hoofdmenu">
        <ul>
          <li><a href="/werkwijze">Werkwijze</a></li>
          <li><a href="/selectie">Selectie</a></li>
          <li><a href="/route-advies">Route-advies</a></li>
          <li><a href="/kennisbank">Kennisbank</a></li>
          <li><a href="/over">Over</a></li>
        </ul>
      </nav>

      <div class="header-cta">
        <WhatsAppButton />
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector('.menu-toggle');
  const nav = document.querySelector('.primary-nav');
  const body = document.body;

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    nav?.classList.toggle('is-open');
    body.classList.toggle('menu-open');
  });

  // Close menu when clicking a nav link (mobile UX)
  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      nav.classList.remove('is-open');
      body.classList.remove('menu-open');
    });
  });
</script>

<style>
  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    width: 44px;
    height: 44px;
    padding: 11px 8px;
    background: transparent;
    border: none;
    cursor: pointer;
    position: relative;
    z-index: 210;
  }
  .menu-toggle-bar {
    display: block;
    width: 28px;
    height: 2px;
    background: var(--color-charcoal-dark);
    transition: transform 0.25s ease, opacity 0.2s ease;
    transform-origin: center;
  }
  .menu-toggle[aria-expanded="true"] .menu-toggle-bar:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  .menu-toggle[aria-expanded="true"] .menu-toggle-bar:nth-child(2) {
    opacity: 0;
  }
  .menu-toggle[aria-expanded="true"] .menu-toggle-bar:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  @media (max-width: 900px) {
    .menu-toggle { display: flex; }
    .header-cta { display: none; }

    .primary-nav {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: var(--color-cream);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      transform: translateX(100%);
      transition: transform 0.3s ease;
      z-index: 200;
      visibility: hidden;
    }
    .primary-nav.is-open {
      transform: translateX(0);
      visibility: visible;
    }
    .primary-nav ul {
      display: flex;
      flex-direction: column;
      gap: 32px;
      text-align: center;
      padding: 0;
      margin: 0;
    }
    .primary-nav a {
      font-family: var(--font-serif);
      font-size: 28px;
      letter-spacing: 0.04em;
      color: var(--color-charcoal-dark);
    }
    :global(body.menu-open) { overflow: hidden; }
  }
</style>
