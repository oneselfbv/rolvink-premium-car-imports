---
// D5: GradesSection wordt teaser op homepage; volledige uitleg op /kennisbank/japanse-veiling-grades
import { homeDict, pick } from '../i18n';
const t = pick(homeDict, Astro.currentLocale).grades;
---

<section class="grades-teaser">
  <div class="container">
    <div class="teaser-grid">
      <div class="teaser-inner">
        <div class="section-eyebrow">{t.eyebrow}</div>
        <h2>{t.heading}</h2>
        <p class="teaser-body" set:html={t.bodyHtml} />
        {t.linkHref && t.linkLabel && (
          <a href={t.linkHref} class="teaser-link">{t.linkLabel} <span class="arrow">→</span></a>
        )}
      </div>
      <!-- Slot 5: grade 4:3, light. /public/images/grades-inspection.jpg -->
      <figure class="teaser-image">
        <div class="image-slot image-slot--placeholder image-slot--light grade-img-box" data-label="paint gauge / inspection sheet">
          <picture>
            <source srcset="/images/grades-inspection.webp" type="image/webp" />
            <img class="img-graded" src="/images/grades-inspection.jpg" alt={t.imgAlt} loading="lazy" width="600" height="900" decoding="async" />
          </picture>
        </div>
      </figure>
    </div>
  </div>
</section>

<style>
  .grades-teaser { padding: var(--space-section-top) 0 var(--space-section-bottom); background: var(--color-white); }
  .teaser-grid {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 48px;
    align-items: center;
  }
  .teaser-inner { max-width: 760px; }
  .teaser-image { margin: 0; }
  .teaser-image .grade-img-box {
    aspect-ratio: 4 / 3;
    max-width: 260px;
    margin: 0;
    overflow: hidden;
  }
  .grade-img-box picture { display: block; width: 100%; height: 100%; }
  .grade-img-box img { width: 100%; height: 100%; object-fit: cover; display: block; }
  @media (max-width: 900px) {
    .teaser-grid { grid-template-columns: 1fr; gap: 32px; }
  }
  .grades-teaser h2 { font-size: 48px; margin-bottom: 24px; font-weight: 600; line-height: 1.1; }
  .teaser-body { font-size: 17px; color: var(--color-text-secondary); line-height: 1.7; margin-bottom: 24px; }
  .teaser-body strong { color: var(--color-text-primary); font-weight: 600; }
  .teaser-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-copper-text);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: gap 0.2s;
  }
  .teaser-link:hover { gap: 14px; }
  .teaser-link .arrow { font-size: 16px; }

  @media (max-width: 768px) {
    .grades-teaser h2 { font-size: 32px; }
  }
</style>
