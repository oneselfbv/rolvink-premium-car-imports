---
import { homeDict, pick } from '../i18n';
const t = pick(homeDict, Astro.currentLocale).tiers;
const deBullets = t.de.bullets;
const jpBullets = t.jp.bullets;
---

<section class="tiers">
  <div class="container">
    <div class="section-eyebrow">{t.eyebrow}</div>
    <h2>{t.heading}</h2>
    <p class="tiers-intro">{t.intro}</p>
    <div class="tier-grid">
      <article class="tier">
        <!-- Slot 4a: bronmarkten Duitsland 4:3, light. /public/images/bron-duitsland.jpg -->
        <figure class="tier-image">
          <div class="image-slot image-slot--placeholder image-slot--light tier-img-box" data-label="German autobahn">
            <picture>
              <source srcset="/images/bron-duitsland.webp" type="image/webp" />
              <img class="img-graded" src="/images/bron-duitsland.jpg" alt={t.de.imgAlt} loading="lazy" width="1170" height="780" decoding="async" />
            </picture>
          </div>
        </figure>
        <div class="tier-tag">{t.de.tag}</div>
        <h3>{t.de.title}</h3>
        <div class="tier-time">{t.de.time}</div>
        <p class="tier-desc" set:html={t.de.descHtml} />
        <ul class="tier-features">
          {deBullets.map((b) => (
            <li>{b.bold && <strong>{b.bold}</strong>}{b.extra}</li>
          ))}
        </ul>
      </article>
      <article class="tier featured">
        <!-- Slot 4b: bronmarkten Japan 4:3, dark overlay. /public/images/bron-japan.jpg -->
        <figure class="tier-image">
          <div class="image-slot image-slot--placeholder img-on-dark tier-img-box" data-label="classic JDM import">
            <picture>
              <source srcset="/images/bron-japan.webp" type="image/webp" />
              <img class="img-graded" src="/images/bron-japan.jpg" alt={t.jp.imgAlt} loading="lazy" width="600" height="901" decoding="async" />
            </picture>
          </div>
        </figure>
        <div class="tier-tag">{t.jp.tag}</div>
        <h3>{t.jp.title}</h3>
        <div class="tier-time">{t.jp.time}</div>
        <p class="tier-desc" set:html={t.jp.descHtml} />
        <ul class="tier-features">
          {jpBullets.map((b) => <li>{b}</li>)}
        </ul>
      </article>
    </div>
  </div>
</section>

<style>
  .tiers { padding: var(--space-section-top) 0 var(--space-section-bottom); }
  .tiers h2 { font-size: 64px; margin-bottom: 24px; max-width: 720px; font-weight: 600; }
  .tiers-intro { font-size: 17px; color: var(--color-text-secondary); max-width: 680px; margin-bottom: 48px; line-height: 1.55; }
  .tier-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .tier { padding: 56px 48px; border: 1px solid var(--color-border-medium); background: var(--color-white); }
  .tier.featured { background: var(--color-charcoal-dark); color: var(--color-cream); border: 1px solid var(--color-charcoal-dark); }
  .tier-tag { display: inline-block; padding: 5px 12px; border: 1px solid var(--color-copper-text); color: var(--color-copper-text); font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 36px; }
  .tier h3 { font-size: 36px; margin-bottom: 12px; font-weight: 600; }
  .tier-time { font-size: 15px; color: var(--color-copper-text); margin-bottom: 28px; font-weight: 500; }
  .tier-desc { font-size: 15px; margin-bottom: 36px; color: var(--color-text-secondary); }
  .tier.featured .tier-desc { color: rgba(245,241,234,0.7); }
  .tier-features li { padding: 14px 0; font-size: 14px; display: flex; gap: 14px; align-items: start; border-bottom: 1px solid rgba(0,0,0,0.06); font-weight: 400; }
  .tier.featured .tier-features li { border-bottom: 1px solid rgba(184,115,51,0.15); color: rgba(245,241,234,0.85); }
  .tier-features li::before { content: "→"; color: var(--color-copper-text); font-weight: 600; }

  .tier-image { margin: 0 0 28px; max-width: 300px; }
  .tier-image .tier-img-box {
    aspect-ratio: 3 / 2;
    margin: 0;
  }
  .tier-img-box { overflow: hidden; }
  .tier-img-box picture { display: block; width: 100%; height: 100%; }
  .tier-img-box img { width: 100%; height: 100%; object-fit: cover; display: block; }

  @media (max-width: 768px) {
    .tier-grid { grid-template-columns: 1fr; }
    .tiers h2 { font-size: 40px; }
    .tier-image { max-width: 240px; }
  }
</style>
