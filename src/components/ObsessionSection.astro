---
import { homeDict, pick } from '../i18n';
const t = pick(homeDict, Astro.currentLocale).obsession;
const items = t.items;
---

<section class="obsession">
  <div class="container">
    <div class="obsession-header">
      <div class="section-eyebrow">{t.eyebrow}</div>
      <h2>{t.heading}</h2>
      <p class="obsession-lead">{t.lead}</p>
    </div>
    <ol class="obsession-list">
      {items.map((item) => (
        <li class="obsession-item">
          <div class="obsession-num">{item.num}</div>
          <div class="obsession-content">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .obsession { padding: var(--space-section-top) 0 var(--space-section-bottom); background: var(--color-cream-warm); }
  .obsession-header { max-width: 720px; margin-bottom: 56px; }
  .obsession-header h2 { font-size: 64px; margin-bottom: 28px; font-weight: 600; }
  .obsession-lead { font-size: 19px; color: var(--color-text-secondary); line-height: 1.55; max-width: 580px; }
  .obsession-list { display: flex; flex-direction: column; }
  .obsession-item { display: grid; grid-template-columns: 100px 1fr; gap: 48px; padding: 36px 0; border-top: 1px solid var(--color-border-medium); align-items: start; }
  .obsession-item:last-child { border-bottom: 1px solid var(--color-border-medium); }
  .obsession-num { font-family: var(--font-display); font-size: 36px; font-weight: 600; color: var(--color-copper); letter-spacing: -0.04em; line-height: 1; }
  .obsession-content h3 { font-family: var(--font-display); font-size: 24px; font-weight: 600; margin-bottom: 10px; letter-spacing: -0.02em; color: var(--color-charcoal-dark); }
  .obsession-content p { font-size: 15px; color: var(--color-text-secondary); max-width: 680px; line-height: 1.6; }
</style>
