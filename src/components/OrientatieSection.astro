---
// Homepage -> kennisbank interne linking (SEO: link equity + thematische relevantie)
const gidsen = [
  { href: '/kennisbank/bmw-motor-importeren-duitsland', title: 'BMW-motor importeren uit Duitsland', desc: 'Het complete proces \u2014 van advertentie tot Nederlands kenteken, met kosten en doorlooptijd.' },
  { href: '/kennisbank/bmw-r100gs-importeren', title: 'BMW R 100 GS \u2014 kopen & importeren', desc: 'Velgen, cardan en originaliteit: waar het bij de klassieke GS echt op aankomt.' },
  { href: '/kennisbank/bmw-r80gs-importeren', title: 'BMW R 80 GS \u2014 kopen & importeren', desc: 'G/S, GS of Basic: welke uitvoering u voor zich heeft en wat dat doet met de prijs.' },
  { href: '/kennisbank/bmw-r65-importeren', title: 'BMW R 65 \u2014 de instap-boxer', desc: 'De goedkoopste manier om aan een airhead te beginnen \u2014 en de valkuilen daarbij.' },
  { href: '/kennisbank/motor-bpm-importeren', title: 'BPM bij motorimport', desc: 'Hoe de motor-BPM werkt, wanneer u niets betaalt en wat het doet met de eindprijs.' },
  { href: '/kennisbank/bmw-motoren-prijspeiling-2026', title: 'Prijspeiling BMW-motoren DE/NL', desc: 'Wat modellen in Duitsland en Nederland kosten \u2014 en waar het verschil in zit.' },
];
---

<section class="orientatie">
  <div class="container">
    <div class="section-eyebrow">Begin met oriënteren</div>
    <h2>Eerst lezen, dan pas zoeken.</h2>
    <p class="orientatie-intro">Voordat u een motor koopt, helpt het om de modellen, kosten en valkuilen te kennen. Dit zijn de gidsen waar de meeste kopers mee starten.</p>

    <ul class="orientatie-grid">
      {gidsen.map((g) => (
        <li class="orientatie-card">
          <a href={g.href}>
            <span class="oc-title">{g.title}<span class="oc-arrow" aria-hidden="true">→</span></span>
            <span class="oc-desc">{g.desc}</span>
          </a>
        </li>
      ))}
    </ul>

    <a href="/kennisbank" class="orientatie-all">Bekijk de volledige kennisbank<span class="arrow" aria-hidden="true">→</span></a>
  </div>
</section>

<style>
  .orientatie { padding: 88px 0; background: var(--color-cream-warm); }
  .orientatie h2 { font-size: 40px; font-weight: 600; margin: 8px 0 14px; line-height: 1.1; }
  .orientatie-intro { max-width: 620px; font-size: 18px; color: var(--color-text-secondary); line-height: 1.6; margin-bottom: 44px; }
  .orientatie-grid { list-style: none; padding: 0; margin: 0 0 40px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .orientatie-card { background: var(--color-white); border-left: 3px solid var(--color-copper-text); }
  .orientatie-card a { display: block; padding: 22px 24px; height: 100%; text-decoration: none; transition: background 0.2s; }
  .orientatie-card a:hover { background: var(--color-cream); }
  .oc-title { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; font-family: var(--font-display); font-size: 19px; color: var(--color-charcoal-dark); margin-bottom: 8px; line-height: 1.2; }
  .oc-arrow { color: var(--color-copper-text); font-size: 16px; transition: transform 0.2s; flex-shrink: 0; }
  .orientatie-card a:hover .oc-arrow { transform: translateX(3px); }
  .oc-desc { display: block; font-size: 14px; color: var(--color-text-secondary); line-height: 1.55; }
  .orientatie-all { display: inline-flex; align-items: center; gap: 12px; font-size: 13px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-copper-text); text-decoration: none; }
  .orientatie-all .arrow { transition: transform 0.2s; }
  .orientatie-all:hover .arrow { transform: translateX(4px); }
  @media (max-width: 900px) { .orientatie-grid { grid-template-columns: 1fr; } .orientatie h2 { font-size: 30px; } }
</style>
