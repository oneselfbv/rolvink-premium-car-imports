---
import LogoHorizontal from './LogoHorizontal.astro';
import { uiDict, pick } from '../i18n';
const t = pick(uiDict, Astro.currentLocale).footer;
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div style="margin-bottom: 20px;">
          <LogoHorizontal width={240} variant="on-dark" />
        </div>
        <p style="font-size: 14px; color: rgba(245, 241, 234, 0.72); max-width: 320px; line-height: 1.6;">
          {t.blurb}
        </p>
      </div>
      {t.columns.map((col) => (
        <div>
          <h3>{col.title}</h3>
          <ul>
            {col.links.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
      <div>
        <h3>{t.contactTitle}</h3>
        <ul>
          <li><a href="mailto:contact@rolvinkpremiumcarimports.nl">contact@rolvinkpremiumcarimports.nl</a></li>
          <li><a href="https://wa.me/31638441395" target="_blank" rel="noopener noreferrer">{t.whatsappLabel}</a></li>
          {t.addressLines.map((line) => <li>{line}</li>)}
          <li>{t.hours}</li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {currentYear} Rolvink Premium Imports</span>
      <span><a href={t.privacy.href}>{t.privacy.label}</a> · <a href={t.voorwaarden.href}>{t.voorwaarden.label}</a></span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-charcoal-dark);
    color: var(--color-cream);
    padding: 64px 0 32px;
    margin-top: 80px;
  }
  .site-footer .container { color: var(--color-cream); }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.4fr;
    gap: 40px;
    margin-bottom: 48px;
    align-items: start;
  }
  .footer-grid h3 {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-copper-text);
    margin-bottom: 16px;
  }
  .footer-grid ul {
    display: flex;
    flex-direction: column;
    gap: 8px;
    list-style: none;
    padding: 0;
  }
  .footer-grid a {
    color: rgba(245, 241, 234, 0.85);
    font-size: 14px;
    transition: color 0.2s;
  }
  .footer-grid a:hover { color: var(--color-copper-text); }
  .footer-grid li {
    font-size: 14px;
    color: rgba(245, 241, 234, 0.7);
  }
  .footer-bottom {
    border-top: 1px solid rgba(245, 241, 234, 0.12);
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 12px;
    color: rgba(245, 241, 234, 0.55);
  }
  .footer-bottom a {
    color: rgba(245, 241, 234, 0.7);
    transition: color 0.2s;
  }
  .footer-bottom a:hover { color: var(--color-copper-text); }

  @media (max-width: 900px) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 32px; }
  }
  @media (max-width: 600px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>
