---
import LogoHorizontal from './LogoHorizontal.astro';
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div style="margin-bottom: 20px;">
          <LogoHorizontal width={240} />
        </div>
        <p style="font-size: 14px; color: var(--color-text-secondary); max-width: 320px;">
          Een persoonlijke sourcing-service voor Duitse premium-auto's uit Europa en Japan. Welsum, Nederland.
        </p>
      </div>
      <div>
        <h4>Service</h4>
        <ul>
          <li><a href="/werkwijze">Werkwijze</a></li>
          <li><a href="/selectie">Selectie</a></li>
          <li><a href="/route-advies">Route-advies</a></li>
          <li><a href="/bpm-calculator">BPM-tool</a></li>
          <li><a href="/tarieven">Tarieven</a></li>
          <li><a href="/voorbeeld-traject">Voorbeeld-traject</a></li>
          <li><a href="/referenties">Referenties</a></li>
          <li><a href="/over">Over Theo</a></li>
        </ul>
      </div>
      <div>
        <h4>Kennis</h4>
        <ul>
          <li><a href="/kennisbank">Kennisbank</a></li>
          <li><a href="/kennisbank/faq-japan">FAQ Japan</a></li>
          <li><a href="/kennisbank/faq-duitsland">FAQ Duitsland</a></li>
        </ul>
      </div>
      <div>
        <h4>Contact</h4>
        <ul>
          <li><a href="mailto:contact@rolvinkpremiumcarimports.nl">contact@rolvinkpremiumcarimports.nl</a></li>
          <li><a href="https://wa.me/31638441395" target="_blank" rel="noopener noreferrer">+31 6 38 44 13 95 (WhatsApp)</a></li>
          <li>Veldweg 15, 8196 KS Welsum</li>
          <li>Op afspraak</li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {currentYear} Rolvink Premium Car Imports</span>
      <span><a href="/privacy">Privacy</a> · <a href="/voorwaarden">Voorwaarden</a></span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-charcoal-dark);
    color: var(--color-cream);
    padding: 64px 0 32px;
    margin-top: 80px;
  }
  .site-footer .container { color: var(--color-cream); }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 48px;
  }
  .footer-grid h4 {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-copper);
    margin-bottom: 16px;
  }
  .footer-grid ul {
    display: flex;
    flex-direction: column;
    gap: 8px;
    list-style: none;
    padding: 0;
  }
  .footer-grid a {
    color: rgba(245, 241, 234, 0.85);
    font-size: 14px;
    transition: color 0.2s;
  }
  .footer-grid a:hover { color: var(--color-copper-text); }
  .footer-grid li {
    font-size: 14px;
    color: rgba(245, 241, 234, 0.7);
  }
  .footer-bottom {
    border-top: 1px solid rgba(245, 241, 234, 0.12);
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 12px;
    color: rgba(245, 241, 234, 0.55);
  }
  .footer-bottom a {
    color: rgba(245, 241, 234, 0.7);
    transition: color 0.2s;
  }
  .footer-bottom a:hover { color: var(--color-copper-text); }

  @media (max-width: 900px) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 32px; }
  }
  @media (max-width: 600px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>
