---
// Motoren-teaser op de homepage — zelfde prominentie-familie als de bronmarkten.
// Tekst + foto, dict-gedreven per taal (home.moto), link naar de motoren-pagina.
import { homeDict, pick } from '../i18n';
const t = pick(homeDict, Astro.currentLocale).moto;
---

<section class="moto-teaser">
  <div class="container">
    <div class="mt-grid">
      <figure class="mt-image">
        <picture>
          <img class="img-graded" src={t.img} alt={t.imgAlt} loading="lazy" width="1600" height="700" decoding="async" />
        </picture>
      </figure>
      <div class="mt-inner">
        <div class="section-eyebrow">{t.eyebrow}</div>
        <h2>{t.heading}</h2>
        <p class="mt-body">{t.body}</p>
        <ul class="mt-points">
          {t.points.map((p) => <li>{p}</li>)}
        </ul>
        <a href={t.linkHref} class="mt-link">{t.linkLabel} <span class="arrow">→</span></a>
      </div>
    </div>
  </div>
</section>

<style>
  .moto-teaser { padding: var(--space-section-top) 0 var(--space-section-bottom); background: var(--color-cream-warm); }
  .mt-grid { display: grid; grid-template-columns: 440px 1fr; gap: 56px; align-items: center; }
  .mt-image { margin: 0; overflow: hidden; }
  .mt-image img { width: 100%; height: 100%; min-height: 320px; object-fit: cover; display: block; }
  .mt-inner h2 { font-size: 44px; font-weight: 600; letter-spacing: -0.02em; margin: 0 0 16px; }
  .mt-body { font-size: 16px; line-height: 1.6; color: var(--color-text-secondary); margin: 0 0 20px; max-width: 560px; }
  .mt-points { list-style: none; padding: 0; margin: 0 0 28px; }
  .mt-points li { position: relative; padding: 9px 0 9px 26px; font-size: 15px; color: var(--color-text-primary); border-bottom: 1px solid var(--color-border-medium); }
  .mt-points li::before { content: "→"; position: absolute; left: 0; color: var(--color-copper); }
  .mt-link { color: var(--color-copper-text); font-weight: 600; font-size: 15px; }
  .mt-link .arrow { transition: transform 0.2s ease; display: inline-block; }
  .mt-link:hover .arrow { transform: translateX(4px); }

  @media (max-width: 900px) {
    .mt-grid { grid-template-columns: 1fr; gap: 28px; }
    .mt-image img { min-height: 220px; }
    .mt-inner h2 { font-size: 36px; }
  }
</style>
