---
// Breadcrumbs met BreadcrumbList schema-markup
interface Crumb {
  name: string;
  url?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
const baseUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: item.name,
    ...(item.url && { item: `${baseUrl}${item.url}` }),
  })),
};
---

<nav class="breadcrumbs" aria-label="Broodkruimels">
  <ol>
    {items.map((item, idx) => (
      <li>
        {item.url && idx < items.length - 1 ? (
          <a href={item.url}>{item.name}</a>
        ) : (
          <span aria-current="page">{item.name}</span>
        )}
        {idx < items.length - 1 && <span class="separator" aria-hidden="true">›</span>}
      </li>
    ))}
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<style>
  .breadcrumbs {
    margin-bottom: 24px;
  }
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }
  .breadcrumbs a {
    color: var(--color-text-secondary);
    transition: color 0.2s;
  }
  .breadcrumbs a:hover { color: var(--color-copper); }
  .breadcrumbs .separator {
    color: var(--color-copper);
    margin: 0 4px;
  }
  .breadcrumbs [aria-current="page"] {
    color: var(--color-copper);
    font-weight: 500;
  }
</style>
