---
// Homepage hero — full-bleed dark backdrop, koptekst overlaid
// Vervangt eerdere 2-column layout met losse image-rectangle.
// Auditor brief: laat beeld ademen, full-bleed met overlay, niet als geïsoleerd blokje.
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="container">
    <div class="hero-content">
      <h1>Duitse premium-auto's, <br/>uit Europa en <span class="accent">Japan</span>.</h1>
      <p class="hero-lead">Persoonlijk gesourced voor wie het juiste exemplaar zoekt — niet het eerste.</p>
      <div class="hero-cta-row">
        <a href="/contact" class="cta">Start uw zoekopdracht<span class="arrow">→</span></a>
        <a href="/werkwijze" class="hero-secondary-link">of bekijk eerst de werkwijze <span class="arrow-small">→</span></a>
      </div>
      <div class="hero-brands">
        <span class="hero-brands-label">Onze focus</span>
        <ul class="hero-brand-list">
          <li><a href="/merk/bmw">BMW</a></li>
          <li><span aria-hidden="true">·</span></li>
          <li><a href="/merk/mercedes-benz">Mercedes-Benz</a></li>
          <li><span aria-hidden="true">·</span></li>
          <li><a href="/merk/audi">Audi</a></li>
          <li><span aria-hidden="true">·</span></li>
          <li><a href="/merk/porsche">Porsche</a></li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: center;
    padding: 80px 0 64px;
    overflow: hidden;
    color: var(--color-cream);
    background: var(--color-charcoal-dark);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background-image: url('/images/hero-911.jpg');
    background-size: cover;
    background-position: center 40%;
    filter: saturate(0.85) contrast(0.92) brightness(0.85) sepia(0.10);
    z-index: 0;
  }
  .hero-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(20,18,15,0.88) 0%, rgba(20,18,15,0.55) 55%, rgba(20,18,15,0.20) 100%);
  }
  .hero .container { position: relative; z-index: 1; }
  .hero-content {
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .hero h1 {
    font-size: clamp(40px, 7.2vw, 82px);
    letter-spacing: clamp(-1.5px, -0.3vw, -2.46px);
    line-height: 0.95;
    font-weight: 600;
    margin: 0;
    color: var(--color-cream);
  }
  .hero h1 .accent { color: var(--color-copper); }
  .hero-lead {
    font-size: 19px;
    max-width: 540px;
    color: rgba(245, 241, 234, 0.82);
    line-height: 1.55;
    margin: 0;
  }
  .hero-cta-row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }
  .hero .cta { color: var(--color-cream); }
  .hero .cta::after { background: var(--color-copper); }
  .hero .cta .arrow { color: var(--color-copper); }
  .hero-secondary-link {
    font-family: var(--font-display);
    font-size: 15px;
    font-style: italic;
    color: rgba(245, 241, 234, 0.72);
    text-decoration: none;
    transition: color 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .hero-secondary-link:hover { color: var(--color-copper); }
  .hero-secondary-link .arrow-small {
    font-size: 13px;
    color: var(--color-copper);
    transition: transform 0.2s;
  }

  .hero-brands {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid rgba(245, 241, 234, 0.18);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .hero-brands-label {
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-copper);
    font-weight: 500;
  }
  .hero-brand-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }
  .hero-brand-list li { line-height: 1; }
  .hero-brand-list a {
    font-family: var(--font-serif);
    font-size: 17px;
    letter-spacing: 0.06em;
    color: rgba(245, 241, 234, 0.92);
    text-decoration: none;
    transition: color 0.2s;
  }
  .hero-brand-list a:hover { color: var(--color-copper); }
  .hero-brand-list li[aria-hidden] { color: rgba(245, 241, 234, 0.35); font-family: var(--font-serif); font-size: 15px; }

  @media (max-width: 900px) {
    .hero { min-height: 82vh; padding: 64px 0 48px; }
    .hero-bg::after {
      background: linear-gradient(180deg, rgba(20,18,15,0.65) 0%, rgba(20,18,15,0.82) 100%);
    }
    .hero-content { max-width: 100%; gap: 24px; }
    .hero-brand-list { gap: 12px; }
  }
</style>
