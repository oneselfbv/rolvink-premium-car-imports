---
// Homepage hero — H1 + brands list + sources list + CTAs
// D1: subtiele SVG-noise textuur als achtergrond (papier-grain)
// D3: primary CTA als button, secondary als tekst-link daaronder
---

<section class="hero">
  <div class="hero-texture" aria-hidden="true"></div>
  <div class="container">
    <div class="hero-grid">
      <div class="hero-text">
        <h1>Duitse premium-auto's,<br/>uit Europa en <span class="accent">Japan</span>.</h1>
        <p class="hero-lead">Persoonlijk gesourced voor wie het juiste exemplaar zoekt — niet het eerste.</p>
        <div class="hero-cta-row">
          <a href="/contact" class="cta">Start uw zoekopdracht<span class="arrow">→</span></a>
          <a href="/werkwijze" class="hero-secondary-link">of bekijk eerst de werkwijze <span class="arrow-small">→</span></a>
        </div>
      </div>
      <aside class="hero-side">
        <div class="hero-block">
          <div class="hero-block-label">Onze focus</div>
          <ul class="hero-list">
            <li><a href="/merk/bmw">BMW</a></li>
            <li><a href="/merk/mercedes-benz">Mercedes-Benz</a></li>
            <li><a href="/merk/audi">Audi</a></li>
            <li><a href="/merk/porsche">Porsche</a></li>
          </ul>
        </div>
        <div class="hero-block">
          <div class="hero-block-label">Wij sourcen uit</div>
          <ul class="hero-list">
            <li><a href="/bron/europa">Europa</a></li>
            <li><a href="/bron/japan">Japan</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: var(--space-hero-top) 0 var(--space-section-bottom);
    overflow: hidden;
  }
  /* D1: subtiele papier-grain textuur als achtergrond — tactiel, niet schreeuwerig */
  .hero-texture {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.5;
    background-image: url("data:image/svg+xml;utf8,<svg viewBox='0 0 240 240' xmlns='http://www.w3.org/2000/svg'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.16 0 0 0 0 0.16 0 0 0 0 0.16 0 0 0 0.06 0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
    background-size: 240px 240px;
    z-index: 0;
  }
  .hero .container { position: relative; z-index: 1; }
  .hero-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 100px; align-items: end; }
  .hero h1 { font-size: 82px; margin-bottom: 32px; line-height: 0.95; font-weight: 600; }
  .hero-lead { font-size: 19px; max-width: 480px; color: var(--color-text-secondary); margin-bottom: 40px; }
  .hero-cta-row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }
  /* D3: secondary link i.p.v. tweede button — minder retail-occasion energie */
  .hero-secondary-link {
    font-family: var(--font-display);
    font-size: 15px;
    font-style: italic;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .hero-secondary-link:hover { color: var(--color-copper); }
  .hero-secondary-link .arrow-small {
    font-size: 13px;
    color: var(--color-copper);
    transition: transform 0.2s;
  }
  .hero-secondary-link:hover .arrow-small { transform: translateX(3px); }

  .hero-side { padding-bottom: 16px; }
  .hero-block { padding: 18px 0; border-top: 1px solid var(--color-border-medium); }
  .hero-block:last-child { border-bottom: 1px solid var(--color-border-medium); }
  .hero-block-label { font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--color-copper-text); margin-bottom: 10px; font-weight: 500; }
  .hero-list li { font-family: var(--font-serif); font-size: 17px; font-weight: 500; letter-spacing: 0.04em; padding: 2px 0; line-height: 1.4; }
  .hero-list a { color: var(--color-charcoal-dark); display: inline-flex; align-items: center; gap: 8px; transition: color 0.2s; }
  .hero-list a::after { content: "→"; color: var(--color-copper); opacity: 0; transform: translateX(-6px); transition: opacity 0.2s, transform 0.2s; font-size: 14px; }
  .hero-list a:hover { color: var(--color-copper); }
  .hero-list a:hover::after { opacity: 1; transform: translateX(0); }

  @media (max-width: 768px) {
    .hero-grid { grid-template-columns: 1fr; gap: 40px; }
    .hero h1 { font-size: 44px; }
  }
</style>
