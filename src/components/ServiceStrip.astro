---
const services = [
  { num: '01', title: 'Sourcing', body: 'Gericht zoeken op Japanse veilingen en Duitse premium-aanbieders, volgens uw exacte profiel.' },
  { num: '02', title: 'Advies', body: 'Duiding van veilingsheets, valkuilen per modelreeks, en eerlijke marktwaarde.' },
  { num: '03', title: 'Levering', body: 'Volledige import, BPM, RDW. Aflevering tot aan uw voordeur.' },
  { num: '04', title: 'Detailing', body: 'Optionele deep clean, lederrenovatie en keramische coating door geselecteerde partners.' },
];
---

<section class="strip dark-section">
  <div class="container">
    <div class="strip-inner">
      <div>
        <div class="strip-label">Onze service</div>
        <h2>Een traject van A tot <span class="accent">Z</span>.</h2>
      </div>
      <ol class="strip-list">
        {services.map((s) => (
          <li>
            <div class="strip-num">{s.num}</div>
            <div class="strip-item">
              <h4>{s.title}</h4>
              <p>{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .strip { background: var(--color-charcoal-dark); color: var(--color-cream); padding: var(--space-section-top) 0 var(--space-section-bottom); }
  .strip-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 100px; align-items: start; }
  .strip-label { color: var(--color-copper); font-size: 12px; font-weight: 500; margin-bottom: 24px; letter-spacing: 0.05em; text-transform: uppercase; }
  .strip h2 { font-size: 60px; max-width: 480px; color: var(--color-cream); font-weight: 600; }
  .strip-list { list-style: none; }
  .strip-list li { padding: 28px 0; border-bottom: 1px solid rgba(184,115,51,0.15); display: grid; grid-template-columns: 60px 1fr; gap: 28px; align-items: start; }
  .strip-list li:first-child { border-top: 1px solid rgba(184,115,51,0.15); }
  .strip-num { font-family: var(--font-display); font-size: 32px; font-weight: 600; color: var(--color-copper); letter-spacing: -0.04em; line-height: 1; }
  .strip-item h4 { font-family: var(--font-display); font-size: 22px; font-weight: 600; margin-bottom: 8px; letter-spacing: -0.02em; color: var(--color-cream); }
  .strip-item p { font-size: 14px; color: rgba(245,241,234,0.65); font-weight: 400; }

  @media (max-width: 768px) {
    .strip-inner { grid-template-columns: 1fr; gap: 40px; }
    .strip h2 { font-size: 40px; }
  }
</style>
