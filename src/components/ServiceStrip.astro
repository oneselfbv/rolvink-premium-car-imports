---
// D4: 3 disciplines (Sourcing / Levering / Nazorg) — 3:2 cards in vertical column
// Image + text per discipline, niet meer kleine vierkante thumbs
const disciplines = [
  {
    num: '01',
    title: 'Sourcing',
    body: 'Gerichte zoektocht op Japanse veilingen en bij Duitse premium-dealers, gestuurd door uw exacte profiel. Wekelijkse kandidaten met onze duiding.',
    img: '/images/traject-auction.jpg',
    alt: 'Donkere Audi RS7 Sportback in stadshof — sourcing van premium-uitvoeringen'
  },
  {
    num: '02',
    title: 'Levering',
    body: 'Volledige import, BPM-aangifte, RDW-keuring en kentekenregistratie. Aflevering aan huis tot 200 km vanaf Welsum.',
    img: '/images/traject-transport.jpg',
    alt: 'Porsche 911 op autotransport-trailer — import en aflevering'
  },
  {
    num: '03',
    title: 'Nazorg',
    body: 'Optionele detailing door geselecteerde partners. Begeleiding bij eventuele garantie-correspondentie. Een directe lijn — geen call-center.',
    img: '/images/traject-handover.jpg',
    alt: 'Hand met Mercedes-Benz autosleutel bij sleuteloverdracht'
  },
];
---

<section class="strip dark-section">
  <div class="container">
    <div class="strip-intro">
      <div class="strip-label">Onze service</div>
      <h2>Een traject van A tot Z.</h2>
      <p class="strip-intro-text">Drie disciplines, één gestroomlijnd traject. Voor het volledige stappenplan ziet u onze werkwijze.</p>
      <a href="/werkwijze" class="strip-link">Bekijk de werkwijze in 8 stappen <span class="arrow">→</span></a>
    </div>

    <ol class="strip-list">
      {disciplines.map((d) => (
        <li class="strip-card">
          <figure class="strip-card-img">
            <img class="img-graded" src={d.img} alt={d.alt} loading="lazy" width="1200" height="800" />
          </figure>
          <div class="strip-card-body">
            <div class="strip-num">{d.num}</div>
            <div class="strip-card-text">
              <h4>{d.title}</h4>
              <p>{d.body}</p>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .strip { background: var(--color-charcoal-dark); color: var(--color-cream); padding: var(--space-section-top) 0 var(--space-section-bottom); }
  .strip-intro { display: flex; flex-direction: column; gap: 18px; max-width: 720px; margin-bottom: 64px; }
  .strip-label { color: var(--color-copper-text); font-size: 12px; font-weight: 500; letter-spacing: 0.05em; text-transform: uppercase; }
  .strip h2 { font-size: 60px; max-width: 560px; color: var(--color-cream); font-weight: 600; margin: 0; }
  .strip-intro-text { font-size: 16px; color: rgba(245,241,234,0.7); line-height: 1.6; max-width: 540px; margin: 0; }
  .strip-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-copper-text);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-top: 12px;
    transition: gap 0.2s;
  }
  .strip-link:hover { gap: 14px; }
  .strip-link .arrow { font-size: 16px; }

  .strip-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }
  .strip-card {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .strip-card-img {
    margin: 0;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 4px;
    border: 1px solid rgba(184, 115, 51, 0.25);
    background: rgba(245, 241, 234, 0.04);
  }
  .strip-card-img img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .strip-card-body {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 16px;
    align-items: start;
  }
  .strip-num { font-family: var(--font-display); font-size: 32px; font-weight: 600; color: var(--color-copper); letter-spacing: -0.04em; line-height: 1; }
  .strip-card-text h4 { font-family: var(--font-display); font-size: 22px; font-weight: 600; margin-bottom: 8px; letter-spacing: -0.02em; color: var(--color-cream); }
  .strip-card-text p { font-size: 14px; color: rgba(245,241,234,0.7); font-weight: 400; line-height: 1.6; }

  @media (max-width: 900px) {
    .strip h2 { font-size: 40px; }
    .strip-list { grid-template-columns: 1fr; gap: 40px; }
  }
</style>
