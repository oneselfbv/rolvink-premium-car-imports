---
// Full vertical logo (banner + shield with R + PREMIUM IMPORTS)
// Use in hero, business cards, signage
interface Props {
  width?: number;
  variant?: 'on-cream' | 'on-dark';
}
const { width = 200, variant = 'on-cream' } = Astro.props;
const shieldFill = variant === 'on-dark' ? '#F5F1EA' : '#2A2A2A';
const bannerFill = variant === 'on-dark' ? '#B87333' : '#2A2A2A';
const bannerText = variant === 'on-dark' ? '#2A2A2A' : '#B87333';
const monogramFill = variant === 'on-dark' ? '#2A2A2A' : '#B87333';
const lineStroke = variant === 'on-dark' ? '#2A2A2A' : '#B87333';
const premiumText = variant === 'on-dark' ? '#B87333' : '#B87333';
const importsText = variant === 'on-dark' ? '#2A2A2A' : '#F5F1EA';
---
<svg viewBox="0 0 200 250" xmlns="http://www.w3.org/2000/svg" width={width} aria-label="Rolvink Premium Imports">
  <rect x="35" y="15" width="130" height="38" fill={bannerFill} />
  <text x="100" y="40" fill={bannerText} font-family="Cinzel, 'Times New Roman', serif" font-size="13" letter-spacing="5" text-anchor="middle" font-weight="500">ROLVINK</text>
  <path d="M 35 70 L 35 148 Q 35 205 100 232 Q 165 205 165 148 L 165 70 Z" fill={shieldFill} stroke="#B87333" stroke-width="1.2" />
  <path d="M 43 78 L 43 145 Q 43 197 100 220 Q 157 197 157 145 L 157 78 Z" fill="none" stroke="#B87333" stroke-width="0.5" />
  <text x="100" y="138" fill={monogramFill} font-family="Cinzel, 'Times New Roman', serif" font-size="64" font-weight="500" text-anchor="middle">R</text>
  <line x1="60" y1="160" x2="140" y2="160" stroke={lineStroke} stroke-width="0.5" />
  <text x="100" y="180" fill={premiumText} font-family="Inter, Arial, sans-serif" font-size="8" letter-spacing="3" text-anchor="middle" font-weight="500">PREMIUM</text>
  <text x="100" y="196" fill={importsText} font-family="Inter, Arial, sans-serif" font-size="7" letter-spacing="0.8" text-anchor="middle" font-weight="500">IMPORTS</text>
</svg>
