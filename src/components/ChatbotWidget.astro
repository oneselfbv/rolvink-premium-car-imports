      var b=document.createElement('button'); b.className='rv-chip rv-cat'; b.style.marginTop='10px'; b.textContent='📚 Bekijk alle onderwerpen'; b.addEventListener('click',showCategories); bub0.appendChild(b);
      var br=document.createElement('div'); br.style.marginTop='4px';
      var cta=document.createElement('a'); cta.className='rv-cta'; cta.href='/contact'; cta.innerHTML='Plan een gratis intake &rarr;'; cta.addEventListener('click',function(){ track('chatbot_contact_click',{from:'no_match'}); }); br.appendChild(cta);
      if(WA){ var wa=document.createElement('a'); wa.className='rv-cta rv-wa'; wa.href=waLink(); wa.target='_blank'; wa.rel='noopener'; wa.textContent='WhatsApp'; wa.addEventListener('click',function(){ track('chatbot_whatsapp_click',{from:'no_match'}); }); br.appendChild(wa); }
      bub0.appendChild(br); scrollDown(); return;
    }
    var f=best.f;
    track('chatbot_query',{query:query, matched:f.q});
    var bub=renderOne(f, query, true);
    var hasModel = MODELS.some(function(m){ return (' '+norm(query)+' ').indexOf(' '+m+' ')>-1; });
    if(hasModel && f.category!=='Route-advies'){
      var rl=document.createElement('a'); rl.className='rv-deeplink'; rl.href='/route-advies';
      rl.innerHTML='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10"/></svg>Specifiek model? Doe het route-advies';
      rl.addEventListener('click',function(){ track('chatbot_deeplink_click',{to:'/route-advies-model'}); });
      bub.appendChild(document.createElement('br')); bub.appendChild(rl);
    }
    var rel=ranked.slice(1).filter(function(r){return r.s>=3;}).slice(0,3).map(function(r){return {label:r.f.q};});
    if(rel.length){ bub.appendChild(labelEl('Gerelateerd')); bub.appendChild(chipRow(rel,function(it){ ask(it.label); })); }
    var fb=document.createElement('div'); fb.className='rv-feedback';
    var span=document.createElement('span'); span.textContent='Was dit nuttig?'; fb.appendChild(span);
    function fbBtn(emoji,helpful){ var b=document.createElement('button'); b.className='rv-fb-btn'; b.textContent=emoji; b.setAttribute('aria-label',helpful?'Nuttig':'Niet nuttig'); b.addEventListener('click',function(){ track('chatbot_feedback',{matched:f.q,helpful:helpful}); fb.innerHTML=''; var t=document.createElement('span'); t.textContent=helpful?'Bedankt voor je feedback!':'Bedankt — voor een persoonlijk antwoord:'; fb.appendChild(t); if(!helpful){ var c=document.createElement('a'); c.className='rv-intake'; c.href='/contact'; c.style.marginLeft='6px'; c.textContent='plan een gratis intake →'; c.addEventListener('click',function(){ track('chatbot_contact_click',{from:'feedback'}); }); fb.appendChild(c); } scrollDown(); }); return b; }
    fb.appendChild(fbBtn('👍',true)); fb.appendChild(fbBtn('👎',false));
    bub.appendChild(fb);
    var intake=document.createElement('a'); intake.className='rv-intake'; intake.href='/contact'; intake.textContent='Liever direct overleg? Plan een gratis intake →'; intake.style.display='block'; intake.addEventListener('click',function(){ track('chatbot_contact_click',{from:'answer'}); });
    bub.appendChild(intake);
    var compound = /\b(en|of|and|plus)\b/.test(ql) || ql.indexOf('&')>-1 || ql.indexOf('+')>-1;
    var second = ranked[1];
    if(compound && second && second.s>=5 && second.f.category!==f.category){
      addBot('<em class="rv-ennote">Je noemde meerdere dingen — ook relevant:</em>');
      renderOne(second.f, query, false);
    }
    scrollDown();
    if(typeof requestAnimationFrame==='function') requestAnimationFrame(scrollDown);
  }

  function ask(text){ addUser(text); setTimeout(function(){ answer(text); }, 180); }
  function open(){ panel.classList.add('rv-open'); launch.classList.add('rv-hidden'); greet(); track('chatbot_open',{}); setTimeout(function(){ input.focus(); },200); }
  function close(){ panel.classList.remove('rv-open'); launch.classList.remove('rv-hidden'); }

  // footer quick links
  (function(){
    var topics=document.createElement('a'); topics.href='#'; topics.textContent='Alle onderwerpen'; topics.addEventListener('click',function(e){ e.preventDefault(); showCategories(); }); footLinks.appendChild(topics);
    if(WA){ var sep=document.createTextNode('  ·  '); footLinks.appendChild(sep); var wa=document.createElement('a'); wa.href=waLink(); wa.target='_blank'; wa.rel='noopener'; wa.textContent='WhatsApp Theo'; wa.addEventListener('click',function(){ track('chatbot_whatsapp_click',{from:'footer'}); }); footLinks.appendChild(wa); }
  })();

  launch.addEventListener('click',open);
  closeB.addEventListener('click',close);
  document.addEventListener('keydown',function(e){ if(e.key==='Escape' && panel.classList.contains('rv-open')) close(); });
  function submit(){ var v=input.value.trim(); if(!v) return; input.value=''; input.style.height='auto'; ask(v); }
  send.addEventListener('click',submit);
  input.addEventListener('keydown',function(e){ if(e.key==='Enter' && !e.shiftKey){ e.preventDefault(); submit(); } });
  input.addEventListener('input',function(){ input.style.height='auto'; input.style.height=Math.min(input.scrollHeight,90)+'px'; });
  var rvLastY=window.pageYOffset||0, rvTick=false;
  function rvScroll(){ var y=window.pageYOffset||0; if(!panel.classList.contains('rv-open')){ if(y>rvLastY+8 && y>240){ launch.classList.add('rv-tuck'); } else if(y<rvLastY-8){ launch.classList.remove('rv-tuck'); } } rvLastY=y; rvTick=false; }
  window.addEventListener('scroll',function(){ if(!rvTick){ (window.requestAnimationFrame||function(f){f();})(rvScroll); rvTick=true; } },{passive:true});
})();
</script>
