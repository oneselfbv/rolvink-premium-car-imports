  function concepts(toks){var seen={},list=[];toks.forEach(function(tok){var gk=null;for(var k in SYN){if(SYN[k].indexOf(tok)>-1){gk=k;break;}}var key=gk||tok;if(seen[key])return;seen[key]=1;list.push({key:key,forms:gk?SYN[gk].concat([gk]):[tok]});});return list;}
  function score(query){
   var qn=norm(query);
   var toks=qn.split(' ').filter(t=>t.length>2&&!STOP[t]);
   if(!toks.length)toks=qn.split(' ').filter(Boolean);
   var cons=concepts(toks);
   var wantJP=cons.some(c=>c.key==='japan'), wantDE=cons.some(c=>c.key==='duitsland');
   return FAQS.map(function(f){
    var s=0;
    cons.forEach(function(c){
     var inQ=c.forms.some(x=>f._qW.has(x));
     var inC=c.forms.some(x=>f._cW.has(x));
     var inB=c.forms.some(x=>f._bW.has(x));
     var st=STRONG[c.key]; if(inQ)s+=st?9:5; else if(inC)s+=st?4:3; else if(inB)s+=st?2:1;
    });
    f._strongTitle.forEach(function(k){ if(!cons.some(c=>c.key===k)) s-=3; });
    if(qn.length>4&&f._q.indexOf(qn)>-1)s+=12;
    if(wantJP&&!wantDE){ if(f.market==='Japan')s+=3; else if(f.market==='Duitsland')s-=4; }
    if(wantDE&&!wantJP){ if(f.market==='Duitsland')s+=3; else if(f.market==='Japan')s-=4; }
    return {f:f,s:s};
   }).sort((a,b)=>b.s-a.s);
  }
