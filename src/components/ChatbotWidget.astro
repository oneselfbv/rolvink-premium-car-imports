<style is:global>
  .rv-bot, .rv-bot * { box-sizing: border-box; }
  .rv-bot {
    --rv-charcoal:#2A2A2A; --rv-charcoal-dark:#1F1F1F; --rv-copper:#B87333;
    --rv-copper-dark:#6B5A3A; --rv-cream:#F5F1EA; --rv-cream-warm:#EFE9DD;
    font-family:'Inter','Inter Tight',system-ui,sans-serif;
  }
  .rv-launch {
    position:fixed; right:24px; bottom:24px; z-index:9998;
    display:flex; align-items:center; gap:10px;
    background:var(--rv-copper); color:var(--rv-cream);
    border:none; border-radius:999px; padding:14px 20px 14px 16px;
    box-shadow:0 8px 28px rgba(31,31,31,.28); cursor:pointer;
    font-family:'Inter Tight','Inter',sans-serif; font-weight:600; font-size:15px;
    transition:transform .18s ease, box-shadow .18s ease, background .18s ease;
  }
  .rv-launch:hover { transform:translateY(-2px); box-shadow:0 12px 34px rgba(31,31,31,.34); background:#a5662d; }
  .rv-launch svg { width:22px; height:22px; flex:0 0 auto; }
  .rv-launch.rv-hidden { display:none; }
  .rv-launch { transition:transform .25s ease, opacity .25s ease; }
  .rv-launch.rv-tuck { transform:translateY(160%); opacity:0; pointer-events:none; }
  @media (max-width:760px){ .rv-launch{ bottom:84px; right:16px; padding:12px 16px; font-size:14px; } }

  .rv-panel {
    position:fixed; right:24px; bottom:24px; z-index:9999;
    width:380px; max-width:calc(100vw - 32px); height:600px; max-height:calc(100vh - 48px);
    background:var(--rv-cream); border-radius:18px; overflow:hidden;
    box-shadow:0 24px 60px rgba(31,31,31,.40); display:none; flex-direction:column;
    border:1px solid rgba(184,115,51,.25);
  }
  .rv-panel.rv-open { display:flex; animation:rvIn .22s ease; }
  @keyframes rvIn { from{opacity:0; transform:translateY(12px);} to{opacity:1; transform:translateY(0);} }
  @media (max-width:760px){ .rv-panel{ right:8px; bottom:8px; width:calc(100vw - 16px); height:calc(100vh - 16px); max-height:none; } }

  .rv-head { background:var(--rv-charcoal-dark); color:var(--rv-cream); padding:16px 18px; display:flex; align-items:center; gap:12px; }
  .rv-head .rv-mark { font-family:'Cinzel',serif; font-weight:600; font-size:17px; letter-spacing:.5px; line-height:1; }
  .rv-head .rv-sub { font-size:12px; color:rgba(245,241,234,.65); margin-top:3px; }
  .rv-close { margin-left:auto; background:none; border:none; color:var(--rv-cream); cursor:pointer; padding:4px; opacity:.8; }
  .rv-close:hover{ opacity:1; }
  .rv-close svg{ width:20px; height:20px; }

  .rv-body { flex:1; overflow-y:auto; padding:18px; background:var(--rv-cream); scroll-behavior:smooth; }
  .rv-msg { display:flex; margin-bottom:14px; }
  .rv-msg.rv-user { justify-content:flex-end; }
  .rv-bubble { max-width:88%; padding:11px 14px; border-radius:14px; font-size:14px; line-height:1.5; }
  .rv-bot-b { background:#fff; color:var(--rv-charcoal); border:1px solid var(--rv-cream-warm); border-bottom-left-radius:4px; }
  .rv-user-b { background:var(--rv-charcoal); color:var(--rv-cream); border-bottom-right-radius:4px; }
  .rv-bubble strong{ color:var(--rv-copper-dark); }
  .rv-more { display:inline-block; margin-top:8px; color:var(--rv-copper); font-weight:600; cursor:pointer; font-size:13px; border-bottom:1px dashed var(--rv-copper); }
  .rv-extra { margin-top:8px; padding-top:8px; border-top:1px solid var(--rv-cream-warm); color:#555; font-size:13.5px; }

  .rv-chips { display:flex; flex-wrap:wrap; gap:7px; margin-top:4px; }
  .rv-chip {
    background:transparent; border:1px solid var(--rv-copper); color:var(--rv-copper-dark);
    border-radius:999px; padding:7px 12px; font-size:12.5px; cursor:pointer; line-height:1.3;
    transition:background .15s ease,color .15s ease; text-align:left;
  }
  .rv-chip:hover{ background:var(--rv-copper); color:var(--rv-cream); }
  .rv-chip.rv-cat{ border-color:var(--rv-copper-dark); }
  .rv-label { font-size:12px; text-transform:uppercase; letter-spacing:.6px; color:#8a7a5f; margin:14px 0 8px; font-weight:600; }
  .rv-back { color:var(--rv-copper); cursor:pointer; font-size:12.5px; font-weight:600; margin-bottom:8px; display:inline-block; }
  .rv-back:hover{ color:var(--rv-copper-dark); }

  .rv-deeplink {
    display:inline-flex; align-items:center; gap:6px; margin-top:10px;
    border:1px solid var(--rv-copper); color:var(--rv-copper-dark); text-decoration:none;
    padding:8px 13px; border-radius:8px; font-weight:600; font-size:13px; transition:background .15s ease,color .15s ease;
  }
  .rv-deeplink:hover{ background:var(--rv-copper); color:var(--rv-cream); }
  .rv-deeplink svg{ width:14px; height:14px; }

  .rv-intake { display:inline-block; margin-top:10px; color:var(--rv-copper); font-weight:600; font-size:13px; text-decoration:none; border-bottom:1px solid var(--rv-copper); }
  .rv-intake:hover{ color:var(--rv-copper-dark); }
  .rv-ennote{ color:#8a7a5f; font-size:12.5px; font-style:italic; }

  .rv-cta {
    display:inline-flex; align-items:center; gap:8px; margin-top:10px; margin-right:8px;
    background:var(--rv-copper); color:var(--rv-cream); text-decoration:none;
    padding:10px 16px; border-radius:8px; font-weight:600; font-size:13.5px;
    font-family:'Inter Tight','Inter',sans-serif; transition:background .15s ease;
  }
  .rv-cta:hover{ background:#a5662d; }
  .rv-cta.rv-wa{ background:var(--rv-copper); color:#1A1A1A; }
  .rv-cta.rv-wa:hover{ background:var(--rv-copper-dark); }

  .rv-feedback { margin-top:12px; display:flex; align-items:center; gap:8px; font-size:12.5px; color:#8a7a5f; }
  .rv-fb-btn { border:1px solid var(--rv-cream-warm); background:#fff; border-radius:8px; padding:3px 9px; cursor:pointer; font-size:15px; line-height:1.2; }
  .rv-fb-btn:hover{ border-color:var(--rv-copper); }

  .rv-foot { padding:12px 14px; background:#fff; border-top:1px solid var(--rv-cream-warm); }
  .rv-inputrow { display:flex; gap:8px; align-items:flex-end; }
  .rv-input {
    flex:1; resize:none; border:1px solid var(--rv-cream-warm); border-radius:10px;
    padding:10px 12px; font-size:14px; font-family:inherit; color:var(--rv-charcoal);
    max-height:90px; line-height:1.4; outline:none;
  }
  .rv-input:focus{ border-color:var(--rv-copper); }
  .rv-send { background:var(--rv-charcoal); color:var(--rv-cream); border:none; border-radius:10px; width:42px; height:42px; flex:0 0 auto; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:background .15s ease; }
  .rv-send:hover{ background:var(--rv-copper); }
  .rv-send svg{ width:18px; height:18px; }
  .rv-foot-links { text-align:center; margin-top:9px; }
  .rv-foot-links a { color:#8a7a5f; font-size:11px; text-decoration:none; }
  .rv-foot-links a:hover{ color:var(--rv-copper); }
  .rv-disc { font-size:10.5px; color:#9a8c74; text-align:center; margin-top:7px; line-height:1.4; }
</style>

<div class="rv-bot">
  <button class="rv-launch" id="rvLaunch" aria-label="Stel een vraag aan Rolvink">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
    <span>Vraag het Theo</span>
  </button>

  <section class="rv-panel" id="rvPanel" role="dialog" aria-label="Rolvink import-assistent" aria-modal="false">
    <div class="rv-head">
      <div>
        <div class="rv-mark">ROLVINK</div>
        <div class="rv-sub">Persoonlijk import-advies</div>
      </div>
      <button class="rv-close" id="rvClose" aria-label="Sluit de assistent">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="rv-body" id="rvBody"></div>
    <div class="rv-foot">
      <div class="rv-inputrow">
        <textarea class="rv-input" id="rvInput" rows="1" placeholder="Typ je vraag… bv. wat kost importeren uit Japan?"></textarea>
        <button class="rv-send" id="rvSend" aria-label="Verstuur vraag">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
        </button>
      </div>
      <div class="rv-foot-links" id="rvFootLinks"></div>
      <div class="rv-disc">Algemene informatie, geen financieel of juridisch advies. Voor jouw situatie: plan een gratis intakegesprek.</div>
    </div>
  </section>
</div>

<script is:inline>
(function(){
  var FAQS = [{"q":"Wat kost jullie dienstverlening?","snippet":"Het sourcing-traject Duitsland start vanaf €2.250 (€750 retainer + €1.500 bij aflevering). Het Japan-traject is €3.250 (€1.250 retainer + aanschaf + €2.000 restbetaling). Een DRZ-taxatierapport voor de tegenbewijsregeling kost €350. Het intakegesprek is gratis.","a":"De sheet-vertaling zit inbegrepen in het Japan-traject. De BPM-tool en alle kennisbank-content zijn gratis te gebruiken. Bekijk de tarieven-pagina voor de volledige opbouw.","category":"Tarieven en kosten","market":"Algemeen"},{"q":"Is het intakegesprek gratis?","snippet":"Ja, het intakegesprek is volledig gratis en vrijblijvend. Dat kan online via Google Meet, via WhatsApp of telefonisch.","a":"Tijdens de intake bespreken we je wensen, budget en tijdslijn, en adviseren we of Japan of Duitsland de logische bronmarkt is. Pas daarna beslis je of je een traject wilt starten.","category":"Tarieven en kosten","market":"Algemeen"},{"q":"Welke merken sourcen jullie?","snippet":"We richten ons op vier premium-merken: BMW, Mercedes-Benz, Audi en Porsche. Daarbuiten sourcen we niet.","a":"Per merk hebben we een eigen focus: BMW sterk in M-uitvoeringen, Mercedes het meest gevarieerd (SL-cabrio's, AMG, klassiekers), Audi vooral het RS-performance-segment, en Porsche heeft het sterkste Japan-LHD-aanbod (911, Cayman, Boxster, Cayenne).","category":"Merken en scope","market":"Algemeen"},{"q":"Hebben jullie eigen voorraad of een showroom?","snippet":"Nee. Rolvink is een pure sourcing-consultancy. We kopen niet op voorraad in en hebben geen showroom — we zoeken en kopen uitsluitend op jouw concrete opdracht.","a":"Dat betekent geen druk om iets uit voorraad te verkopen: we adviseren onafhankelijk welke auto en welke bronmarkt het beste bij jouw wensen passen.","category":"Merken en scope","market":"Algemeen"},{"q":"Hoe neem ik contact op?","snippet":"Via de contactpagina kun je een gratis intakegesprek aanvragen. We zijn bereikbaar via Google Meet, WhatsApp of telefonisch.","a":"Laat je gegevens en je wensen achter via het contactformulier, dan nemen we contact op om een vrijblijvende intake in te plannen.","category":"Contact en intake","market":"Algemeen"},{"q":"Kan ik de BPM zelf berekenen?","snippet":"Ja, er staat een gratis BPM-tool op de site (bpm-calculator). Daarmee krijg je een indicatie van de BPM voor een importauto in 2026.","a":"De BPM is de grootste variabele kostenpost bij import. We berekenen de definitieve BPM via drie methoden — forfait, koerslijst of DRZ-taxatie — en kiezen de gunstigste.","category":"Tools","market":"Algemeen"},{"q":"Japan of Duitsland — wat is beter voor mij?","snippet":"Dat hangt af van je model, budget en tijdslijn. Duitsland is sneller (1-3 weken) en geschikt voor courante modellen; Japan (10-14 weken) loont vooral voor performance-uitvoeringen en klassiekers met lage km.","a":"De route-advies-tool op de site laat per model zien welke bronmarkt past. Tijdens de gratis intake geven we hier een concreet advies over.","category":"Route-advies","market":"Algemeen"},{"q":"Geven jullie garantie of financieel advies?","snippet":"We geven geen financieel of juridisch advies. Onze informatie is algemeen van aard; voor jouw specifieke situatie plannen we een gratis intakegesprek.","a":"We zijn een sourcing-consultancy. Cijfers en kostenindicaties communiceren we als bandbreedte op basis van ervaring; ze zijn geen harde belofte of advies.","category":"Disclaimer","market":"Algemeen"},{"q":"Hoe lang duurt het om een auto uit Japan te importeren?","snippet":"Reken op 10 tot 14 weken vanaf hammerprijs op de Japanse veiling tot Nederlandse kentekenplaat. Het grootste deel daarvan — 5 tot 6 weken — is de RoRo-zeevracht naar Rotterdam.","a":"Onderverdeling: 1-2 weken voor binnenlands transport en exportformaliteiten in Japan, 5-6 weken RoRo-zeevracht naar Rotterdam (soms uitlopend tot 7-8 weken bij seizoens-effect), 2-5 weken voor douane, BPM, RDW-keuring en kentekenregistratie in Nederland.","category":"Proces en doorlooptijd","market":"Japan"},{"q":"Welke stappen volgen er in het import-traject?","snippet":"Het traject omvat acht stappen: intake-gesprek, profiel vastleggen, kandidaten voorstellen, bod en aankoop, transport en import, RDW + BPM + kentekening, aflevering aan huis, en optionele detailing.","a":"Het volledige proces staat beschreven op onze werkwijze-pagina en in de cornerstone \"Auto importeren uit Japan in 2026\". Elke stap wordt vooraf met u doorgesproken en u krijgt na elke fase een statusupdate.","category":"Proces en doorlooptijd","market":"Japan"},{"q":"Wat als ik een specifieke kleur of optiepakket wil dat zelden voorkomt?","snippet":"Bij zeldzame uitvoeringen kan het 2 tot 4 maanden duren voordat een passende kandidaat op een Japanse veiling verschijnt. Geduld is dan onderdeel van de strategie — wij signaleren zodra een match opduikt.","a":"Wij screenen wekelijks JCD, USS, JU en JAA. Zodra een kandidaat de profielcriteria raakt, ontvangt u sheet + foto's + duiding. Bieden gebeurt pas met uw expliciete goedkeuring; geen actie zonder uw groen licht.","category":"Proces en doorlooptijd","market":"Japan"},{"q":"Kan de doorlooptijd korter dan 10 weken?","snippet":"Nee — de RoRo-zeevracht uit Japan duurt structureel 5 tot 6 weken en is niet te versnellen. Voor wie binnen 4 weken in de auto wil rijden, is de Duitsland-route de logische keuze.","a":"Onze route-advies-tool laat per model zien welke bronmarkt past bij uw tijdslijn. Voor performance-uitvoeringen en klassiekers met lage km blijft Japan vaak de moeite waard ondanks de langere doorlooptijd.","category":"Proces en doorlooptijd","market":"Japan"},{"q":"Wat gebeurt er als de zeevracht vertraging oploopt?","snippet":"Zeevracht-vertragingen zijn niet uitzonderlijk — wisselende vaarroutes, weersomstandigheden of beschikbaarheid bij Rotterdam-terminals kunnen 1 tot 2 weken extra toevoegen. Tijdens transit krijgt u tracking-updates.","a":"Wij houden u op de hoogte van het werkelijke aankomstmoment en passen de planning voor RDW en kentekening daarop aan. De totale doorlooptijd communiceren wij vooraf als bandbreedte, niet als harde belofte.","category":"Proces en doorlooptijd","market":"Japan"},{"q":"Wat betekent een grade 4 of 4.5 op een Japans veiling-sheet?","snippet":"Grade 4 staat voor goede staat met normale gebruikssporen passend bij km-stand en bouwjaar, zonder accident-historie. Grade 4.5 is uitstekende staat met minimale gebruikssporen onder de 100.000 km.","a":"De Japanse auction-grading van 1 tot 6 is een onafhankelijke conditie-rating. Grade 6/S is showroom-/nieuwstaat, grade 5 vrijwel nieuwstaat (zeldzaam in oudere bouwjaren). Wij sourcen uitsluitend grade 4 of hoger.","category":"Veilingen, grades en conditie","market":"Japan"},{"q":"Wat zijn R, RA, A, X en XX letter-codes?","snippet":"Letter-codes op Japanse veiling-sheets duiden op reparatie- of inspectie-issues: R = grote reparatie (vaak chassis-schade), RA = lichte reparatie, A = aanvullende notitie, X = niet geïnspecteerd, XX = total loss.","a":"Wij bieden niet op auto's met deze codes, ongeacht het numerieke grade. Zelfs een grade 4 met R-code valt buiten ons profiel — die concessie maken wij niet voor klanten.","category":"Veilingen, grades en conditie","market":"Japan"},{"q":"Welke Japanse veilinghuizen werken jullie mee?","snippet":"Wij hebben rechtstreeks toegang tot de grootste Japanse veilingnetwerken — USS, JU en JAA — plus regionale veilinghuizen zoals CAA, ARAI, ZIP en BAYAUC. Bieden gebeurt via onze gevestigde Japanse export-partners.","a":"Deze netwerken samen vertegenwoordigen het overgrote deel van het Japanse veilingvolume. Dankzij onze partners hebben we toegang tot zowel de grote landelijke veilingen als de regionale veilinghuizen waar zeldzame uitvoeringen opduiken.","category":"Veilingen, grades en conditie","market":"Japan"},{"q":"Wat is het verschil tussen JCD en USS?","snippet":"JCD (Japan Car Direct) is een internationale broker/agent die toegang geeft tot meerdere veilinghuizen. USS (Used-car System Solutions) is zelf een specifiek veilingnetwerk met meerdere fysieke locaties in Japan.","a":"Wij gebruiken JCD als export-partner en hebben via die route toegang tot zowel USS, JU als JAA en andere veilingsnetwerken voor het concrete bieden. JCD is dus niet de veiling zelf, maar het kanaal waarlangs wij bieden en exporteren.","category":"Veilingen, grades en conditie","market":"Japan"},{"q":"Wat als de auto bij aankomst niet matcht met het veiling-sheet?","snippet":"JCD en de grote Japanse veilinghuizen werken met formele klachtenprocedures als er afwijkingen worden gevonden ten opzichte van het officiële sheet. Wij coördineren een eventueel claim-traject voor u.","a":"In de praktijk zijn echte afwijkingen zeldzaam bij grade 4 en hoger; juist die conditie-grens minimaliseert dit risico. De inspecteurs van de grote netwerken zijn streng en hun reputatie staat op het spel bij elke sheet.","category":"Veilingen, grades en conditie","market":"Japan"},{"q":"Kan ik de auto vóór aankoop bezichtigen?","snippet":"Persoonlijke bezichtiging in Japan is niet praktisch. In plaats daarvan ontvangt u het officiële veiling-sheet, 30+ foto's inclusief onderzijde en interieur, en onze Nederlandstalige duiding.","a":"Een sheet bevat 20-30 datapunten over conditie. Optioneel kunnen wij een aanvullend pre-bid inspectierapport laten maken (€80-150 extra). U beslist op basis van die documentatie voordat wij bieden — geen verrassingen achteraf.","category":"Veilingen, grades en conditie","market":"Japan"},{"q":"Wat is het verschil tussen LHD en RHD bij Japanse auto's?","snippet":"LHD (Left Hand Drive, stuur links) is de Nederlandse en EU-standaard. RHD (Right Hand Drive, stuur rechts) is de Japanse standaard. Wij sourcen uitsluitend originele LHD — geen RHD-conversies.","a":"Op JCD worden LHD-rijen vaak met een groene achtergrond gemarkeerd. Dat zijn auto's die ooit als nieuw naar Japan zijn geëxporteerd door de Europese fabrikant en daardoor met origineel stuur-links beschikbaar zijn.","category":"LHD versus RHD","market":"Japan"},{"q":"Doen jullie ook RHD-conversies?","snippet":"Nee. RHD-conversies zijn technisch ingrijpend (stuurinrichting, dashboard, pedalen, ruitwissers, airbags) en gaan altijd ten koste van originaliteit en marktwaarde. Voor liefhebbersauto's is dat een onaanvaardbare concessie.","a":"Wij wachten op originele LHD-uitvoeringen. Dat duurt soms langer, maar het verschil in eindkwaliteit en restwaarde rechtvaardigt het wachten. Een geconverteerde auto is in NL bovendien moeilijker te verkopen.","category":"LHD versus RHD","market":"Japan"},{"q":"Welke modellen zijn sterk vertegenwoordigd in LHD-aanbod?","snippet":"Performance-uitvoeringen (BMW M, Mercedes AMG, Porsche 911, Audi RS) en klassiekers (Mercedes R107/R129, Porsche 993) zijn structureel het sterkst vertegenwoordigd. Stations zijn praktisch niet beschikbaar in LHD-Japan.","a":"Voor estates en wagons blijft Duitsland de logische route. Onze route-advies-tool toont per model de verwachte beschikbaarheid en adviseert per geval welke bron de juiste keuze is.","category":"LHD versus RHD","market":"Japan"},{"q":"Is er invoerrechten verschuldigd op een auto uit Japan?","snippet":"Ja. 10% invoerrechten over de CIF-waarde (hammerprijs + transport + verzekering, alles tot aan de NL-haven). Dit is een EU-tarief onder HS-code 8703 voor personenauto's.","a":"Voor klassiekers ouder dan 30 jaar gelden vaak verlaagde tarieven onder HS-code 9705 (mogelijk 0% invoerrechten). Per kandidaatauto controleren wij de toepasselijke HS-code vooraf bij de douane-agent.","category":"Belastingen — BTW, BPM en invoerrechten","market":"Japan"},{"q":"Hoeveel BTW betaal ik?","snippet":"21% BTW over de CIF-waarde plus invoerrechten — verschuldigd voor elke import uit een niet-EU-land zoals Japan. Voor klassiekers ouder dan 30 jaar onder HS-code 9705 geldt soms het verlaagde 9% tarief.","a":"Voor EV's en hybrides gelden geen aparte BTW-regelingen — het standaardtarief van 21% is dan ook van toepassing. Hou er rekening mee dat BTW-tarieven jaarlijks kunnen wijzigen; raadpleeg de Belastingdienst voor de actuele situatie.","category":"Belastingen — BTW, BPM en invoerrechten","market":"Japan"},{"q":"Hoe wordt BPM berekend?","snippet":"BPM kent drie methoden: forfaitaire afschrijving (vaste tabel), koerslijst (X-Ray of Eurotax) en DRZ-taxatie (fysieke taxateur). Wij rekenen alle drie door en kiezen de gunstigste voor uw auto.","a":"Voor moderne premium-auto's is de koerslijst-methode vaak het voordeligst dankzij de snelle waardedaling. Zie onze BPM-cornerstone voor de volledige uitleg per methode en wanneer welke methode het meest oplevert.","category":"Belastingen — BTW, BPM en invoerrechten","market":"Japan"},{"q":"Wat zijn typische BPM-bedragen voor premium import?","snippet":"Indicatief: een 2014 W212 E300 V6 komt op €1.150-€1.600 via koerslijst, een M5 F10 op €2.000-€2.500, een 996 Carrera S 2003 op €700-€1.100. Auto's ouder dan 40 jaar zijn vrijgesteld.","a":"BPM is altijd maatwerk en afhankelijk van CO₂-uitstoot, leeftijd en gekozen methode. Wij maken vóór elk bod een onderbouwde prognose met +10% buffer zodat u geen verrassingen krijgt na invoer.","category":"Belastingen — BTW, BPM en invoerrechten","market":"Japan"},{"q":"Geldt er een vrijstelling voor oldtimers?","snippet":"Ja. Auto's ouder dan 25 jaar zijn volledig BPM-vrijgesteld (100% afschrijving). Boven 40 jaar gelden ook MRB-vrijstelling, verlaagde invoerrechten via HS-9705 en milieuzone-vrijstelling.","a":"Voor klassiekers vlak onder de 25-jaarsgrens loont het soms om enkele maanden te wachten — een paar maanden uitstel kan honderden tot duizenden euro's BPM-besparing opleveren. Per case maken wij die afweging samen met u.","category":"Belastingen — BTW, BPM en invoerrechten","market":"Japan"},{"q":"Krijgt de auto een Nederlandse APK na aankomst?","snippet":"Ja. Na douane-vrijgave organiseren wij de RDW-keuring inclusief APK en identificatie. Zonder geldig APK kan geen Nederlands kenteken worden afgegeven.","a":"Voor Japanse imports zijn soms EU-compliance-aanpassingen nodig (mistlicht achter, kentekenverlichting, knipperlicht-kleur). Deze worden vooraf doorgesproken en bij onze partner-werkplaats uitgevoerd voordat de auto naar de RDW gaat.","category":"RDW, keuring en kentekening","market":"Japan"},{"q":"Wat is EU-typegoedkeuring en waarom is het belangrijk?","snippet":"Een EU-typegoedkeuring is een Europese certificering die geldt voor een hele serie identieke voertuigen. Voor Mercedes/BMW/Audi/Porsche uit Japan die ooit als nieuw naar Japan zijn geëxporteerd, geldt deze meestal nog.","a":"In dat geval verloopt de RDW-keuring soepel. Bij specifiek Japan-geproduceerde varianten kan individuele goedkeuring nodig zijn (2-4 weken extra doorlooptijd, €300-800 extra kosten). Wij toetsen dit vóór bod per kandidaatauto.","category":"RDW, keuring en kentekening","market":"Japan"},{"q":"Is een CoC-document (Certificate of Conformity) verplicht?","snippet":"Niet altijd. Voor de meeste Europese premium-auto's vanaf 1996 is het Japanse exportcertificaat plus chassis-verificatie voldoende voor de RDW.","a":"Voor specifieke uitvoeringen of bouwjaren waar de RDW twijfelt, kan een CoC bij de fabrikant worden aangevraagd (€120-€300, 2-6 weken doorlooptijd). Wij toetsen dit vooraf per kandidaatauto zodat er geen verrassingen ontstaan.","category":"RDW, keuring en kentekening","market":"Japan"},{"q":"Hoe lang duurt de RDW-keuring zelf?","snippet":"De keuring zelf duurt 30 tot 45 minuten op het keuringsstation. De doorlooptijd tot aan de afspraak kan 1 tot 3 weken zijn door drukte bij RDW-locaties.","a":"Wij plannen indien mogelijk al vóór de aankomst van de auto, zodat het traject niet onnodig wordt vertraagd. Voor Japanse imports houden we structureel rekening met 2-5 weken voor de NL-fase (douane + BPM + RDW + kentekening).","category":"RDW, keuring en kentekening","market":"Japan"},{"q":"Heeft een Japanse import nog dealergarantie?","snippet":"Voor de meeste premium-merken eindigt de fabrieksgarantie op 4-6 jaar of een bepaald kilometrage. Geïmporteerde auto's die buiten die periode vallen hebben geen dealergarantie meer — net als een vergelijkbare tweedehands Duitse auto.","a":"Voor specifieke modellen biedt Mercedes-Benz of BMW soms een verlengde garantieoptie via NL-dealers. Dit bespreken wij per geval. Voor klassiekers (>25 jaar) is dealergarantie sowieso geen factor meer.","category":"Conditie, garantie en risico's","market":"Japan"},{"q":"Hoe verifiëren jullie de kilometerstand?","snippet":"Drie controles parallel: de officiële Shaken-historie (verplichte 2-jaarlijkse keuring die km registreert), service-stempels in onderhoudsboekjes, en consistentie met het auction-sheet-rapport van een onafhankelijke inspecteur.","a":"In Japan is kilometerfraude historisch zeldzamer dan in Europa, mede door de strikte Shaken-discipline. Bij twijfel of inconsistenties tussen bronnen: walk-away. Geen verifieerbare historie betekent geen bod.","category":"Conditie, garantie en risico's","market":"Japan"},{"q":"Wat zijn de grootste risico's bij Japan-import?","snippet":"Drie risico's komen het meeste voor: wisselkoersbeweging tussen bod en betaling, onverwachte BPM-uitkomst, en tegenvallende EU-compliance-aanpassingen. Wij bouwen +10% buffer in elke prognose.","a":"Voor de wisselkoers hanteren wij conservatieve bid-grenzen die ±3% afdekken. Voor BPM gebruiken we altijd officiële CO₂-bron in plaats van verkooppakket-data. Voor compliance toetsen we per kandidaatauto vóór bod welke aanpassingen nodig zijn.","category":"Conditie, garantie en risico's","market":"Japan"},{"q":"Past een Japanse W212 in een Nederlandse milieuzone?","snippet":"Voor moderne premium-auto's vanaf bouwjaar 2013 (Euro 6) zijn alle Nederlandse milieuzones toegankelijk. Voor oudere uitvoeringen (Euro 5 of lager) kunnen beperkingen gelden in steden zoals Amsterdam en Rotterdam.","a":"Voor klassiekers (oldtimers, 40+ jaar) gelden vaak vrijstellingen op basis van de oldtimer-regeling. Per kandidaatauto toetsen wij dit vooraf zodat u weet waar u de auto wel en niet kunt rijden.","category":"Conditie, garantie en risico's","market":"Japan"},{"q":"Wat kost een auto importeren uit Japan all-in?","snippet":"Bovenop de hammerprijs komt typisch €8.000-€10.000 aan import- en bijkomende kosten voor een W212. Daaronder vallen JCD-fees, RoRo-vracht, douane, 10% invoer, 21% BTW, BPM en RDW.","a":"Specifiek: JCD auction fees + binnenlands transport (~€1.200), RoRo-zeevracht (~€1.000), douane-afhandeling (~€400), 10% invoerrechten over CIF, 21% BTW, BPM (variabel, vaak €1.150-€2.500), RDW + kentekenregistratie (~€450), EU-compliance + reconditionering (€300-€700), plus onze sourcing- en operationele fee. Zie onze voorbeeld-traject-pagina voor een complete uitwerking.","category":"Kosten en specifieke vragen","market":"Japan"},{"q":"Wat is de IMS-kwestie bij oudere Porsche 911-modellen?","snippet":"De Intermediate Shaft (IMS) van de M96-motor in 996 Carrera (1998-2005) en 997.1 Carrera (2004-2008) heeft een afgesloten kogellager dat tijdens de levensduur kan falen. Wij bieden niet zonder gedocumenteerde IMS-update.","a":"Acceptabele updates: LN Engineering IMS Retrofit of IMS Solution. Voor 997.2 (2008+) en jonger is het IMS-issue afwezig. Voor 911 Turbo en GT3 speelt het niet — die hebben de Mezger-motor zonder IMS-probleem.","category":"Kosten en specifieke vragen","market":"Japan"},{"q":"Kunnen jullie ook bieden op klassiekers uit de jaren 70/80?","snippet":"Ja. Voor klassiekers boven 25 jaar (BPM-vrij) of 40 jaar (volledig vrijgesteld inclusief MRB en milieuzone) is de Japan-route vaak interessant. Het Japanse droger klimaat plus Shaken-discipline leveren vaak betere condities dan EU-equivalenten.","a":"Modellen zoals Mercedes R107 SL, R129 SL, W124 Cosworth, Porsche 993, Audi UR-quattro zijn regelmatig beschikbaar. Per case maken wij een onderbouwde sourcing-strategie met aandacht voor authenticiteit, papieren en restauratie-historie.","category":"Kosten en specifieke vragen","market":"Japan"},{"q":"Geen antwoord op uw vraag?","snippet":"Plan een vrijblijvend intake-gesprek — online, via WhatsApp of in Welsum. Wij beantwoorden uw specifieke vraag binnen 24 uur.","a":"Onze contactgegevens staan op de contactpagina. Voor specifieke vragen over een concreet model, BPM-prognose of doorlooptijd helpen we u graag persoonlijk verder.","category":"Kosten en specifieke vragen","market":"Japan"},{"q":"Hoe lang duurt het om een auto uit Duitsland te importeren?","snippet":"Reken op 2 tot 4 weken vanaf koopovereenkomst tot Nederlandse kentekenplaat. Transport binnen Europa duurt 2 tot 5 dagen; RDW-keuring en BPM-aangifte vragen daarna nog 2 tot 5 weken.","a":"De Duitsland-route is aanzienlijk sneller dan Japan. Mogelijke uitbreiding van de doorlooptijd treedt op wanneer een CoC moet worden aangevraagd of wanneer EU-compliance-aanpassingen nodig zijn voor de specifieke uitvoering. Dit toetsen wij per kandidaatauto vooraf.","category":"Proces en doorlooptijd","market":"Duitsland"},{"q":"Wat zijn de stappen in het importproces?","snippet":"Het traject loopt in zes fasen: profiel-intake, actieve zoektocht op mobile.de en autoscout24.de plus erkende premium-dealers, bezichtiging ter plaatse, transport, RDW en BPM, en aflevering aan huis.","a":"Wij coördineren elke fase voor u. Wat u zelf doet beperkt zich tot het tekenen voor de opdracht, akkoord geven op de gevonden kandidaat, en uw aanwezigheid bij de aflevering. De rest organiseren wij.","category":"Proces en doorlooptijd","market":"Duitsland"},{"q":"Kan ik de auto zelf uit Duitsland naar Nederland rijden?","snippet":"Technisch kan dat, mits de auto een geldig Duits kentekenbewijs heeft (rode, gele of groene exportplaten). In de praktijk regelen wij het transport zodat u niets hoeft te organiseren.","a":"Voor wagens vanaf circa €40.000 is afhankelijke vrachtwagen-transport veiliger en standaard verzekerd tegen schade en diefstal tijdens transit. Voor goedkopere auto's kan zelf-overrijden een redelijke optie zijn als u in de buurt van Duitsland woont.","category":"Proces en doorlooptijd","market":"Duitsland"},{"q":"Hoe vaak rijden jullie naar Duitsland voor bezichtigingen?","snippet":"Voor elke serieuze kandidaatauto rijden wij persoonlijk naar de Duitse dealer of verkoper voor bezichtiging vóór bod. Wij geloven dat dit een non-negotiable is voor premium-aankopen.","a":"Geen \"kopen op foto's\" — dat is exact het signaal van een minder zorgvuldige importeur. Een fysieke bezichtiging onthult panelmismatches, geur, slijtage van de stoelinhoud, accelaratiegedrag en transmissiekwaliteit die op foto's niet zichtbaar zijn.","category":"Proces en doorlooptijd","market":"Duitsland"},{"q":"Wat als er meerdere kandidaten zijn?","snippet":"Wekelijks sturen we voorgeselecteerde kandidaten met volledige documentatie. U beslist op basis van foto's, Fahrzeugschein, TÜV-rapport en onze duiding of we doorgaan met bezichtiging.","a":"Geen actie zonder uw groen licht. Wij filteren actief op uw criteria en sturen alleen kandidaten waar wij zelf op zouden bieden — geen volume-shortlists van vergelijkbare zoek-resultaten.","category":"Proces en doorlooptijd","market":"Duitsland"},{"q":"Moet ik BTW betalen op een Duitse auto?","snippet":"Een auto wordt door de Belastingdienst als \"nieuw\" beschouwd bij minder dan 6.000 km óf jonger dan 6 maanden. In dat geval moet 21% Nederlandse BTW worden betaald bij invoer.","a":"Voor \"gebruikte\" auto's (>6.000 km én >6 maanden) hoeft géén extra Nederlandse BTW te worden afgedragen — de Duitse BTW (19%) is dan al voldaan. Wij toetsen dit per kandidaatauto voorafgaand aan het bod.","category":"Belastingen — BTW, BPM en intracommunautair","market":"Duitsland"},{"q":"Is BPM in Nederland hoger voor Duitse imports?","snippet":"Nee, het BPM-tarief is identiek voor alle imports — uit Duitsland, Japan of een Nederlandse dealer. De grondslag is CO₂-uitstoot, leeftijd en eindwaarde.","a":"Voor jongere auto's onder 5 jaar is BPM een fors deel van de import-economics. Voor youngtimers en oldtimers daalt het BPM-bedrag aanzienlijk via de forfaitaire afschrijvingstabel.","category":"Belastingen — BTW, BPM en intracommunautair","market":"Duitsland"},{"q":"Welke BPM-methoden bestaan er?","snippet":"Drie methoden: forfaitaire afschrijving (snelste, vaste leeftijdstabel), koerslijst (X-Ray of Eurotax) en DRZ-taxatie (fysieke taxateur, €200-€400). Wij rekenen alle drie door en kiezen de gunstigste.","a":"Voor premium-auto's met snelle waardedaling is koerslijst-methode vaak het voordeligst. Voor lage-km exemplaren in uitzonderlijke staat kan DRZ-taxatie weer beter uitpakken. Per voertuig maken wij die afweging.","category":"Belastingen — BTW, BPM en intracommunautair","market":"Duitsland"},{"q":"Wat zijn typische BPM-bedragen voor Duitse premium-imports?","snippet":"Indicatief: BMW 530i F10 2014 circa €2.150 via koerslijst, Mercedes E300 W212 2014 €1.150-€1.600, Audi RS6 C7 2015 €3.000-€4.000. BPM hangt af van CO₂ en methode.","a":"Wij maken vóór elk bod een onderbouwde prognose met +10% buffer voor onverwachte uitkomsten. Voor een snelle indicatie kunt u onze BPM-tool gebruiken.","category":"Belastingen — BTW, BPM en intracommunautair","market":"Duitsland"},{"q":"Geldt er een BPM-vrijstelling voor oldtimers?","snippet":"Ja. Auto's ouder dan 25 jaar zijn volledig BPM-vrijgesteld (100% afschrijving). Boven 40 jaar gelden ook MRB-vrijstelling, verlaagde invoerrechten via HS-9705 en milieuzone-vrijstelling.","a":"Voor klassiekers vlak onder de 25-jaarsgrens loont het soms om enkele maanden te wachten. Een paar maanden uitstel kan honderden tot duizenden euro's BPM-besparing opleveren. Per case maken wij die afweging samen met u.","category":"Belastingen — BTW, BPM en intracommunautair","market":"Duitsland"},{"q":"Wat is intracommunautaire verwerving?","snippet":"Een handelsmechanisme waarbij u een nieuwe auto in Duitsland tegen 0% BTW kunt aanschaffen, mits u in Nederland BTW betaalt. Vereist een Nederlands BTW-nummer en een \"verklaring van hoedanigheid\".","a":"Voor particulieren zelden van toepassing — dit speelt vrijwel uitsluitend bij zakelijke leverancier-tot-zakelijke koper transacties met geldige BTW-status. Wij begeleiden de afhandeling als het wel relevant is.","category":"Belastingen — BTW, BPM en intracommunautair","market":"Duitsland"},{"q":"Wat is TÜV en waarom is het belangrijk?","snippet":"TÜV (Technischer Überwachungsverein) is de Duitse periodieke keuringsinstantie — equivalent van de Nederlandse APK maar strenger. Een geldig TÜV-rapport van 1-2 jaar oud is voor ons verplicht bij elke aankoop.","a":"Het toont dat de auto recent door een onafhankelijke Duitse keurmeester is goedgekeurd. Voor jongere auto's vragen wij aanvullend om de Hauptuntersuchungs-protocol — daarop staan ook lichte aanmerkingen die niet tot afkeuring leidden.","category":"TÜV, DEKRA, KÜS en bezichtiging","market":"Duitsland"},{"q":"Wat is het verschil tussen TÜV, DEKRA en KÜS?","snippet":"Alle drie zijn Duitse keuringsinstanties die wettelijke Hauptuntersuchungen mogen uitvoeren. TÜV is het grootste netwerk, DEKRA staat bekend om pre-purchase inspections, KÜS is de derde grote speler.","a":"Voor onze sourcing werken we met alle drie afhankelijk van locatie en specialisatie van de werkplaats. De keuze van het keuringsinstituut zegt niets over de kwaliteit van de auto zelf — alle drie hanteren dezelfde wettelijke normen.","category":"TÜV, DEKRA, KÜS en bezichtiging","market":"Duitsland"},{"q":"Wat is een DEKRA pre-purchase inspection?","snippet":"Een DEKRA pre-purchase rapport is een gedetailleerd technisch onderzoek vóór koop voor €200-€350. Een onafhankelijke keurmeester levert een 10-15 pagina's rapport met bevindingen.","a":"De keurmeester onderzoekt de auto van bovenaf en onderop, controleert onderhoudshistorie en doet een proefrit. Voor jongere en duurdere auto's vragen we dit standaard aan — €350 betalen op een €40.000 auto is verstandige risicoreductie.","category":"TÜV, DEKRA, KÜS en bezichtiging","market":"Duitsland"},{"q":"Wat is het verschil tussen TÜV en RDW?","snippet":"TÜV is de Duitse keuringsinstantie, RDW de Nederlandse. Een geldige Duitse TÜV wordt niet automatisch erkend door de RDW — na import moet de auto altijd door de Nederlandse RDW-keuring voor een NL-kenteken.","a":"Wel: een recente TÜV-pas is een sterk signaal van technische conditie en kan de RDW-keuring soms versnellen. Voor specifieke onderdelen (verlichting, banden, remmen) gelden in beide landen vergelijkbare normen.","category":"TÜV, DEKRA, KÜS en bezichtiging","market":"Duitsland"},{"q":"Welke documenten heb ik nodig voor de RDW-keuring?","snippet":"Het Duitse kentekenbewijs deel I (Fahrzeugschein) en deel II (Fahrzeugbrief), identiteitsbewijs, aankoopfactuur, en bij voorkeur het CoC-document en recent TÜV-rapport.","a":"Wij regelen alle documenten als onderdeel van onze service. De Fahrzeugbrief (deel II) is daarbij de belangrijkste — die bewijst eigendom en bevat het volledige technische dossier. Zonder deel II kan geen RDW-keuring plaatsvinden.","category":"RDW, documenten en kentekening","market":"Duitsland"},{"q":"Wat als de auto geen CoC-document heeft?","snippet":"Voor Duitse premium-auto's vanaf 1996 met EU-typegoedkeuring is een CoC niet altijd vereist — het Duitse kentekenbewijs is meestal voldoende.","a":"Voor specifieke uitvoeringen of bouwjaren waar de RDW twijfelt, kunnen wij een CoC bij de fabrikant aanvragen (€120-€300, 2-6 weken doorlooptijd). Dit toetsen wij per kandidaatauto vóór bod zodat er geen verrassingen ontstaan.","category":"RDW, documenten en kentekening","market":"Duitsland"},{"q":"Hoe lang duurt de RDW-keuring zelf?","snippet":"De keuring zelf duurt 30 tot 45 minuten op het keuringsstation. De doorlooptijd tot de afspraak kan 1 tot 3 weken zijn door drukte bij RDW-locaties.","a":"Wij plannen indien mogelijk al vóór aankomst in Welsum, zodat het traject niet onnodig wordt vertraagd. Voor Duitse imports houden we structureel rekening met 2-5 weken voor de NL-fase (transport + RDW + BPM + kentekening).","category":"RDW, documenten en kentekening","market":"Duitsland"},{"q":"Hoe gaat de afmelding in Duitsland?","snippet":"Het Duitse kenteken wordt formeel afgemeld bij de Kfz-Zulassungsstelle (de Stilllegung). Wij regelen dit met de Duitse verkoper of dealer.","a":"Daarna mag de auto met rode of gele exportplaten naar Nederland rijden, of via auto-transporter zonder kenteken. Na RDW-keuring krijgt de auto een Nederlands kenteken en worden de Duitse platen verwijderd.","category":"RDW, documenten en kentekening","market":"Duitsland"},{"q":"Komt het Duitse kenteken automatisch op de auto na import?","snippet":"Nee. Het Duitse kenteken wordt afgemeld bij export, en in Nederland krijgt de auto een nieuw NL-kenteken na de RDW-keuring.","a":"De kentekenplaten worden fysiek vervangen op het RDW-station. U kunt eventueel een persoonlijke combinatie reserveren via de RDW — dat moet u dan zelf doen voorafgaand aan de keuring.","category":"RDW, documenten en kentekening","market":"Duitsland"},{"q":"Wat zijn de grootste risico's bij een Duitse auto-import?","snippet":"Drie risico's komen het vaakst voor: kilometerfraude, verborgen schade-historie (\"Unfallfahrzeug\" of \"Vorschaden\"), en ontbrekende onderhoudsdocumentatie. Wij verifiëren elk van deze.","a":"Onze werkwijze: drie-bronnen-check voor km-stand (service-historie, dealer-stempels, HU-database), eis voor volledig Scheckheft, en HU-database-check voor schade-historie. Bij twijfel op één van deze drie: walk-away.","category":"Conditie, garantie en risico's","market":"Duitsland"},{"q":"Hoe groot is het kilometerfraude-risico?","snippet":"Duitse occasions zijn historisch gevoelig voor kilometer-fraude — brancheorganisaties schatten dit op circa 1 op de 3 occasions, hoewel cijfers per bron en jaar verschillen.","a":"Onze werkwijze omvat verificatie via service-historie, BMW/Mercedes/Audi/Porsche-dealerstempels en onafhankelijke databases zoals Tacho-Betrug-services. Bij twijfel op de km-historie weigeren wij de aankoop, ongeacht hoe aantrekkelijk de overige specs lijken.","category":"Conditie, garantie en risico's","market":"Duitsland"},{"q":"Hoe verifiëren jullie de onderhoudshistorie?","snippet":"Wij eisen volledig Scheckheft (gestempeld onderhoudsboekje) of digitale dealer-records (Mercedes DSB/iSB, BMW Online, Audi DSB, Porsche PVI). Geen historie = geen bod.","a":"Voor specifieke modellen vragen we een aanvullend dealer-rapport via WIS (Mercedes), ISTA (BMW) of het Porsche Vehicle Identification (PVI) systeem. Deze fabrikanten houden volledige onderhoudsrecords centraal bij — voor elke werkplaatsbeurt staat datum, km-stand en verricht werk geregistreerd.","category":"Conditie, garantie en risico's","market":"Duitsland"},{"q":"Geldt Nederlandse garantie ook op een Duitse import?","snippet":"Nee — op auto's gekocht in Duitsland geldt in beginsel Duitse wetgeving. Bij erkende Duitse dealers (B2C) geldt doorgaans 12 maanden Sachmängelhaftung; particuliere verkopen zijn meestal \"gekauft wie gesehen\".","a":"Wij werken consequent met erkende Duitse dealers waar B2C-bescherming geldt — niet met privé-verkopers via Kleinanzeigen of vergelijkbare platformen. Dat is een bewuste keuze die uw juridische positie aanzienlijk versterkt.","category":"Conditie, garantie en risico's","market":"Duitsland"},{"q":"Wat als de auto na aankoop een verborgen gebrek heeft?","snippet":"Bij een erkende Duitse dealer geldt de wettelijke 12-maanden Sachmängelhaftung. Wij helpen bij correspondentie en eventueel een Nederlandse expert die kan beoordelen of een claim haalbaar is.","a":"Wij staan niet zelf garant voor verborgen gebreken — dat zou wettelijk en commercieel niet realistisch zijn voor een sourcing-bemiddelaar. Wel staan wij aan uw kant bij correspondentie met de Duitse dealer en kunnen wij doorverwijzen naar gespecialiseerde Nederlandse advocaten als nodig.","category":"Conditie, garantie en risico's","market":"Duitsland"},{"q":"Hoeveel extra kost een auto importeren uit Duitsland all-in?","snippet":"Bovenop de Duitse vraagprijs komen typisch DEKRA-rapport (€200-€350), transport DE→NL (€300-€500), BPM (€1.150-€4.000 afhankelijk van CO₂ en leeftijd), RDW-keuring + kentekenregistratie (€450), eventueel reconditionering (€200-€500).","a":"Plus onze sourcing- en operationele fee. Geen invoerrechten of extra BTW voor gebruikte auto's (>6 maanden + >6.000 km). Zie onze voorbeeld-traject-pagina voor een complete uitwerking met concrete cijfers per onderdeel.","category":"Kosten en specifieke vragen","market":"Duitsland"},{"q":"Hoeveel kan ik besparen door zelf te importeren in plaats van NL-dealer?","snippet":"Tussen 5% en 25% afhankelijk van model, leeftijd en uitvoering. Voor in Nederland populaire modellen (BMW M5, Mercedes E63 AMG, Porsche Macan GTS) is het verschil meestal het grootst.","a":"Het verschil zit in lagere dealerwinst, meer aanbodkeuze in Duitsland, vaak betere uitvoeringen voor dezelfde prijs, en de mogelijkheid om gericht te zoeken naar specifieke kleur- en optie-combinaties die in Nederland zeldzaam zijn.","category":"Kosten en specifieke vragen","market":"Duitsland"},{"q":"Welke modellen importeren jullie het meest uit Duitsland?","snippet":"Sweet spot: BMW 5-Serie F10/G30 (vooral 530d/540i M-Sport), Mercedes E-Klasse W212/W213, Audi A6/A7 C8 en RS-uitvoeringen, Porsche Cayenne/Macan en 911 die in Europa nieuw zijn aangeschaft.","a":"Voor zeldzamere uitvoeringen kijken wij ook naar Japan — zie onze route-advies-tool om te bepalen welke route bij uw specifieke model past. Voor youngtimers (16+ jaar) is Duitsland vrijwel altijd de voorkeursroute vanwege snelheid en directe bezichtiging.","category":"Kosten en specifieke vragen","market":"Duitsland"},{"q":"Hoe gaat de betaling aan de Duitse verkoper?","snippet":"Via Nederlandse bankoverschrijving (SEPA). Voor grote bedragen (>€10.000) gebruiken wij escrow-mogelijkheden van de Duitse dealer of een notariële afhandeling.","a":"Wij betalen pas na bezichtiging en uw goedkeuring — nooit vooraf op basis van foto's. De aankoopfactuur komt op uw naam te staan, niet op de onze; u bent juridisch direct eigenaar van de auto.","category":"Kosten en specifieke vragen","market":"Duitsland"},{"q":"Wat als de wisselkoers verandert tussen bod en betaling?","snippet":"Bij Duitse imports betreft het euro's, dus geen wisselkoersrisico tussen bod en betaling. Bij Japanse imports speelt dit wel (yen-euro), maar wij werken met conservatieve bid-grenzen die ±3% afdekken.","a":"De Duitsland-route is daarmee structureel voorspelbaarder qua eindbedrag dan de Japan-route. Voor wie zekerheid over de totale kosten belangrijk vindt, is dit een argument om voor Duitsland te kiezen wanneer de auto in beide markten beschikbaar is.","category":"Kosten en specifieke vragen","market":"Duitsland"},{"q":"Past een Duitse auto in een Nederlandse milieuzone?","snippet":"Voor moderne premium-auto's (Euro 5/6 vanaf circa 2010-2013) zijn alle Nederlandse milieuzones toegankelijk. Diesels van vóór 2013 zijn beperkt voor specifieke steden zoals Amsterdam en Rotterdam.","a":"Voor klassiekers (oldtimers >40 jaar) gelden vrijstellingen op basis van de oldtimer-regeling. Per kandidaatauto toetsen wij de milieuzone-toegankelijkheid vooraf zodat u weet waar u de auto wel en niet kunt rijden.","category":"Kosten en specifieke vragen","market":"Duitsland"},{"q":"Leveren jullie door heel Nederland?","snippet":"Ja. We leveren de geïmporteerde auto rijklaar bij je af — met Nederlands kenteken, gekeurd en wel — door heel Nederland. Aflevering aan huis is een vaste stap in het traject.","a":"In overleg kan de auto ook op een afgesproken locatie geleverd worden. De aflevering stemmen we af op het werkelijke aankomst- en kentekenmoment.","category":"Service, levering en betaling","market":"Algemeen"},{"q":"Kan ik de auto financieren of leasen?","snippet":"Wij zijn een sourcing-consultancy, geen financier. Financiering of lease regel je via je eigen bank of leasemaatschappij; wij leveren de factuur en importdocumenten die zij nodig hebben.","a":"We geven geen financieel advies. Wel leveren we de aankoopfactuur, het BPM-bewijs en de kentekendocumenten tijdig aan zodat jouw financier of leasemaatschappij het dossier kan verwerken.","category":"Service, levering en betaling","market":"Algemeen"},{"q":"Kan ik mijn huidige auto inruilen?","snippet":"We werken zonder eigen voorraad en handelen niet in occasions, dus standaard inruil bieden we niet. We kunnen wel met je meedenken over het verkopen van je huidige auto naast het import-traject.","a":"Omdat we pure consultancy zijn, kopen we niet zelf in. Voor de verkoop van je huidige auto kunnen we je desgewenst richting geven, maar het import-traject staat daar los van.","category":"Service, levering en betaling","market":"Algemeen"}];
