---
// Homepage-template voor NL/EN/ES/FR. Sinds het focusbesluit van 22 aug 2026 is dit
// een MOTORPAGINA: hero -> propositie -> traject -> vertrouwen -> gidsen (NL) ->
// compact auto-blok -> zoekprofiel -> CTA. De auto-secties (bronmarkten, veiling-
// grades, veilingsignalen) staan bewust NIET meer op de homepage; ze leefden daar
// naast een motorkop en dat las nergens naar. Duitsland heeft een eigen template
// (HomePageDE.astro) met een verkopers-propositie.
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import MotorenSectie from '../components/MotorenSectie.astro';
import ServiceStrip from '../components/ServiceStrip.astro';
import Vertrouwen from '../components/Vertrouwen.astro';
import OrientatieSection from '../components/OrientatieSection.astro';
import AutoBlok from '../components/AutoBlok.astro';
import Zoekprofiel from '../components/Zoekprofiel.astro';
import CTASection from '../components/CTASection.astro';
import { homeDict, pick, asLocale } from '../i18n';
const locale = asLocale(Astro.currentLocale);
const t = pick(homeDict, Astro.currentLocale);
---

<BaseLayout title={t.meta.title} description={t.meta.description} i18nKey="home">
  <HeroSection />
  <MotorenSectie />
  <ServiceStrip />
  <Vertrouwen />
  {locale === 'nl' && <OrientatieSection />}
  <AutoBlok />
  <Zoekprofiel />
  <CTASection />
</BaseLayout>
