---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

import { motorenDict, pick, asLocale, routeFor } from '../i18n';
const locale = asLocale(Astro.currentLocale);
const t = pick(motorenDict, Astro.currentLocale);
const breadcrumbs = [{ name: t.breadcrumbHome, url: routeFor('home', locale) }, { name: t.breadcrumbCurrent }];
const modellen = t.modellen;
const gidsen = t.gidsen;
const stappen = t.stappen;
const inclusief = t.inclusief;
const howToSchema = {
  '@context': 'https://schema.org', '@type': 'HowTo',
  name: t.howTo.name,
  description: t.howTo.description,
  inLanguage: locale,
  step: stappen.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.title, text: s.body })),
};
---
<BaseLayout title={t.meta.title} description={t.meta.description} i18nKey="motoren">
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} slot="head" />

  <section class="moto-hero">
    <div class="moto-hero-overlay"></div>
    <div class="container moto-hero-inner">
      <Breadcrumbs items={breadcrumbs} />
      <div class="section-eyebrow light">{t.eyebrow}</div>
      <h1 set:html={t.h1Html} />
      <p class="hero-lead">{t.heroLead}</p>
      <div class="hero-actions">
        <a href={t.ctaHref} class="hero-btn">{t.heroBtn}<span class="arrow" aria-hidden="true">→</span></a>
        <a href={t.heroLinkHref} class="hero-link">{t.heroLink}</a>
      </div>
    </div>
  </section>

  <section class="moto-page">
    <div class="container">

      <div class="intro">
        <h2>{t.introHeading}</h2>
        {t.introParagraphsHtml.map((p) => <p set:html={p} />)}
      </div>

      <div class="usps">
        {t.usps.map((u) => (
          <div class="usp"><strong>{u.title}</strong><span>{u.body}</span></div>
        ))}
      </div>

      <h2>{t.stepsHeading}</h2>
      <p class="section-intro">{t.stepsIntro}</p>
      <ol class="steps">
        {stappen.map((s) => (
          <li class="step">
            <div class="step-num" aria-hidden="true">{s.num}</div>
            <div class="step-content"><h3>{s.title}</h3><p>{s.body}</p></div>
          </li>
        ))}
      </ol>

      <div class="incl-block">
        <h2>{t.inclHeading}</h2>
        <ul class="incl-list">
          {inclusief.map((i) => (<li>{i}</li>))}
        </ul>
        <p class="incl-note" set:html={t.inclNoteHtml} />
      </div>

      <h2>{t.modellenHeading}</h2>
      <div class="card-grid">
        {modellen.map((m) => (
          m.href && t.cardLinkLabel ? (
            <a href={m.href} class={m.img ? "moto-card has-photo" : "moto-card"}>
              {m.img && (<figure class="card-photo"><img class="img-graded" src={m.img} alt={m.alt || ("BMW " + m.title)} loading="lazy" decoding="async" /></figure>)}
              <span class="card-tag">{m.tag}</span>
              <h3>{m.title}</h3>
              <p>{m.desc}</p>
              <span class="card-link">{t.cardLinkLabel}</span>
            </a>
          ) : (
            <div class={m.img ? "moto-card has-photo" : "moto-card"}>
              {m.img && (<figure class="card-photo"><img class="img-graded" src={m.img} alt={m.alt || ("BMW " + m.title)} loading="lazy" decoding="async" /></figure>)}
              <span class="card-tag">{m.tag}</span>
              <h3>{m.title}</h3>
              <p>{m.desc}</p>
            </div>
          )
        ))}
      </div>

      {t.gidsenHeading && gidsen && (
        <>
          <h2>{t.gidsenHeading}</h2>
          <div class="card-grid">
            {gidsen.map((g) => (
              <a href={g.href} class="moto-card subtle">
                <h3>{g.title}</h3>
                <p>{g.desc}</p>
                <span class="card-link">{t.gidsenLinkLabel}</span>
              </a>
            ))}
          </div>
        </>
      )}

      <div class="page-cta">
        <h2>{t.pageCta.heading}</h2>
        <p>{t.pageCta.body}</p>
        <a href={t.ctaHref} class="page-cta-btn">{t.pageCta.btn}<span class="arrow" aria-hidden="true">→</span></a>
        <p class="page-cta-note">{t.pageCta.note}</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .moto-hero { position: relative; background: #1a1a1a url('/images/moto-hero.jpg') center 55% / cover no-repeat; padding: 0; }
  .moto-hero-overlay { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(18,18,18,0.92) 0%, rgba(18,18,18,0.72) 45%, rgba(18,18,18,0.35) 100%); }
  .moto-hero-inner { position: relative; padding: 56px 0 64px; }
  .moto-hero .section-eyebrow.light { color: var(--color-copper-text); }
  .moto-hero h1 { color: var(--color-cream); font-size: 52px; font-weight: 600; line-height: 1.06; margin: 12px 0 20px; max-width: 820px; }
  .moto-hero h1 .accent { color: var(--color-copper-text); }
  .hero-lead { color: rgba(245,241,234,0.9); font-size: 19px; line-height: 1.6; max-width: 740px; margin-bottom: 28px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 16px 28px; align-items: center; }
  .hero-btn { display: inline-flex; align-items: center; gap: 12px; padding: 16px 32px; background: var(--color-copper-text); color: var(--color-charcoal-dark); font-size: 14px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; text-decoration: none; transition: transform 0.2s, background 0.2s; }
  .hero-btn:hover { transform: translateY(-2px); background: #d18a3f; }
  .hero-link { color: var(--color-cream); text-decoration: underline; text-underline-offset: 3px; font-size: 15px; }
  .hero-link:hover { color: var(--color-copper-text); }

  .moto-page { padding: 56px 0 96px; }
  .moto-page h2 { font-size: 30px; font-weight: 600; margin: 80px 0 20px; }
  .intro h2 { margin-top: 0; }

  .intro { max-width: 820px; margin-bottom: 56px; }
  .intro p { font-size: 17px; color: var(--color-text-secondary); line-height: 1.75; margin-bottom: 16px; }
  .intro strong { color: var(--color-text-primary); }
  .section-intro { max-width: 760px; font-size: 16px; color: var(--color-text-secondary); line-height: 1.65; margin-bottom: 36px; }

  .usps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-bottom: 0; }
  .usp { background: var(--color-cream-warm); border-left: 3px solid var(--color-copper-text); padding: 26px 28px; }
  .usp strong { display: block; color: var(--color-text-primary); font-size: 16px; margin-bottom: 6px; }
  .usp span { font-size: 14px; color: var(--color-text-secondary); line-height: 1.55; }

  .steps { list-style: none; padding: 0; max-width: 860px; }
  .step { display: grid; grid-template-columns: 64px 1fr; gap: 24px; padding: 28px 0; border-top: 1px solid var(--color-border-soft); }
  .step:first-child { border-top: none; padding-top: 0; }
  .step-num { font-size: 30px; font-weight: 600; color: var(--color-copper-text); line-height: 1; font-variant-numeric: tabular-nums; }
  .step-content h3 { font-size: 19px; font-weight: 600; margin-bottom: 8px; }
  .step-content p { font-size: 16px; color: var(--color-text-secondary); line-height: 1.7; }

  .incl-block { background: var(--color-cream-warm); border-left: 3px solid var(--color-copper-text); padding: 36px 38px; max-width: 860px; margin-top: 56px; }
  .incl-block h2 { margin-top: 0; font-size: 24px; }
  .incl-list { list-style: none; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 10px 28px; margin-bottom: 18px; }
  .incl-list li { display: flex; gap: 10px; align-items: baseline; font-size: 15px; color: var(--color-text-secondary); line-height: 1.5; }
  .incl-list li::before { content: "✓"; color: var(--color-copper-text); font-weight: 700; flex-shrink: 0; }
  .incl-note { font-size: 15px; color: var(--color-text-secondary); line-height: 1.6; }
  .incl-note a { color: var(--color-copper-text); text-decoration: underline; }
  .incl-note strong { color: var(--color-text-primary); }

  .card-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .moto-card { display: flex; flex-direction: column; background: var(--color-white); border: 1px solid var(--color-border-soft); border-left: 3px solid var(--color-copper-text); padding: 24px 24px 22px; text-decoration: none; color: inherit; transition: transform 0.2s, box-shadow 0.2s; }
  .moto-card:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(0,0,0,0.08); }
  .moto-card.subtle { border-left-color: var(--color-border-medium); }
  .card-tag { font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-copper-text); font-weight: 600; margin-bottom: 8px; }
  .moto-card h3 { font-size: 21px; font-weight: 600; margin-bottom: 8px; }
  .moto-card p { font-size: 14px; color: var(--color-text-secondary); line-height: 1.55; margin-bottom: 16px; flex-grow: 1; }
  .card-link { font-size: 13px; font-weight: 600; color: var(--color-copper-text); }

  .page-cta { margin-top: 96px; padding: 64px 40px; background: var(--color-charcoal-dark); color: var(--color-cream); text-align: center; }
  .page-cta h2 { color: var(--color-cream); margin: 0 0 12px; }
  .page-cta p { color: rgba(245,241,234,0.85); margin-bottom: 24px; font-size: 16px; max-width: 640px; margin-left: auto; margin-right: auto; }
  .page-cta-btn { display: inline-flex; align-items: center; gap: 12px; padding: 18px 36px; background: var(--color-copper-text); color: var(--color-charcoal-dark); font-size: 14px; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; text-decoration: none; transition: transform 0.2s, background 0.2s; }
  .page-cta-btn:hover { transform: translateY(-2px); background: #d18a3f; }
  .page-cta-note { margin-top: 16px; font-size: 12px; color: rgba(245,241,234,0.6); }

  @media (max-width: 880px) {
    .usps, .card-grid, .incl-list { grid-template-columns: 1fr; }
    .moto-page h2 { margin-top: 56px; }
    .incl-block { margin-top: 40px; padding: 28px 24px; }
    .moto-hero h1 { font-size: 32px; }
    .moto-hero { background-position: center 70%; }
    .step { grid-template-columns: 1fr; gap: 8px; }
  }

  .moto-card.has-photo { padding-top: 0; }
  .card-photo { margin: 0 -24px 16px; overflow: hidden; }
  .card-photo img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; display: block; }
</style>
