---
import BaseLayout from '../layouts/BaseLayout.astro';
import { overDict, pick, asLocale, routeFor } from '../i18n';
const locale = asLocale(Astro.currentLocale);
const t = pick(overDict, Astro.currentLocale);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://www.rolvinkpremiumcarimports.nl/over/#theo',
  name: 'Theo Rolvink',
  jobTitle: 'Oprichter & Sourcing-consultant',
  worksFor: {
    '@type': 'Organization',
    '@id': 'https://www.rolvinkpremiumcarimports.nl/#organization',
    name: 'Rolvink Premium Imports',
  },
  knowsAbout: [
    'BMW',
    'Mercedes-Benz',
    'Audi',
    'Porsche',
    'Vehicle import',
    'BPM',
    'RDW-keuring',
    'Japanese auto auctions',
    'USS auction inspection',
    'JU auction',
    'JAA auction',
    'Sourcing',
    'Motoren',
    'Youngtimer'
  ],
  url: new URL(routeFor('over', locale), Astro.site).toString(),
  image: 'https://www.rolvinkpremiumcarimports.nl/images/theo-rolvink.jpg',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Welsum',
    addressRegion: 'Overijssel',
    addressCountry: 'NL',
  },
  nationality: { '@type': 'Country', name: 'Netherlands' },
  description: t.personDescription,
};
---
<BaseLayout title={t.meta.title} description={t.meta.description} i18nKey="over">
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} slot="head" />

  <section class="over-page">
    <div class="container">
      <div class="section-eyebrow">{t.eyebrow}</div>
      <h1>{t.h1}</h1>
      <p class="lead">{t.lead}</p>

      <article class="prose">
        <figure class="over-portrait">
          <picture>
            <source srcset="/images/theo-rolvink.webp" type="image/webp" />
            <img src="/images/theo-rolvink.jpg" alt={t.portraitAlt} width="180" height="180" loading="eager" decoding="async" />
          </picture>
        </figure>
        {t.paragraphsHtml.map((p) => <p set:html={p} />)}

        {t.sections.map((sec) => (
          <>
            <h2>{sec.heading}</h2>
            {sec.paragraphsHtml.map((p) => <p set:html={p} />)}
          </>
        ))}

        <p class="signature">{t.signature}</p>
      </article>

      <div style="margin-top: 64px;">
        <a href={t.ctaHref} class="cta">{t.ctaLabel}<span class="arrow">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .over-page { padding: 80px 0 80px; }
  .over-page h1 { font-family: var(--font-serif); font-size: 88px; font-weight: 500; letter-spacing: 0.04em; margin-bottom: 16px; }
  .over-portrait { float: right; width: 180px; height: 180px; margin: 4px 0 22px 32px; border-radius: 50%; overflow: hidden; box-shadow: 0 6px 24px rgba(0,0,0,0.12); }
  .over-portrait img { width: 100%; height: 100%; object-fit: cover; display: block; }
  @media (max-width: 600px) { .over-portrait { float: none; margin: 0 auto 24px; width: 150px; height: 150px; } }
  .lead { font-size: 19px; color: var(--color-text-secondary); max-width: 640px; margin-bottom: 56px; line-height: 1.5; font-style: italic; font-family: 'EB Garamond', serif; font-size: 22px; }
  .prose { max-width: 680px; }
  .prose p { font-size: 17px; line-height: 1.7; color: var(--color-text-primary); margin-bottom: 24px; }
  .prose h2 { font-size: 28px; margin: 48px 0 16px; font-weight: 600; }
  .prose strong { font-weight: 600; color: var(--color-charcoal-dark); }
  .prose em { font-style: italic; }
  .signature { font-family: var(--font-serif); font-size: 16px; color: var(--color-copper-text); margin-top: 40px; letter-spacing: 0.04em; }

  @media (max-width: 768px) {
    .over-page h1 { font-size: 56px; }
  }
</style>
