---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Selectie' },
];

const wel = [
  {
    title: 'BMW',
    slug: 'bmw',
    alt: 'Zwarte BMW 4-Serie M-Sport op een bergweg — sourcing van premium BMW-uitvoeringen',
    body: 'Het brede premium-aanbod van BMW — onder andere 3-, 4-, 5-, 6-, 7- en 8-Serie, alle M-uitvoeringen (M2/M3/M4/M5/M6/M8), Z-roadsters en de X-Series (X3/X5/X6/X7). Voorkeur voor benzine 6-cilinder en V8, optioneel xDrive.',
    routes: 'Via Japan vooral M-Performance en zeldzamere uitvoeringen met lage km; via Duitsland het volledige 3/4/5/6/7/8/X-spectrum inclusief daily drivers.',
  },
  {
    title: 'Mercedes-Benz',
    slug: 'mercedes',
    alt: 'Mercedes-AMG GT in mat zwart, vooraanzicht met Panamericana-grille',
    body: 'Het brede premium-aanbod van Mercedes-Benz — onder andere C-, E- en S-Klasse over alle moderne generaties, CLS, SL/SLK, GLE/GLS, G-Klasse en AMG-uitvoeringen. Klassieke modellen (R107, R129, W124 Cosworth) op aanvraag.',
    routes: 'Via Japan vooral AMG-uitvoeringen, SL-cabrio\'s en klassiekers met lage km; via Duitsland het volledige aanbod inclusief estates en G-Klasse.',
  },
  {
    title: 'Audi',
    slug: 'audi',
    alt: 'Audi RS7 Sportback en RS6 Avant bij zonsondergang',
    body: 'Het brede premium-aanbod van Audi — onder andere A6/A7/A8 over alle moderne generaties, RS-uitvoeringen (RS4, RS5, RS6, RS7), S-modellen, Q5/Q7/Q8 en TT/TT RS. Voorkeur voor quattro-uitvoeringen met volledige onderhoudshistorie. Achtergrond: <a href="/kennisbank/audi-quattro-rs-koopgids">complete Audi quattro &amp; RS-koopgids</a>.',
    routes: 'Via Japan vooral RS- en S-uitvoeringen die in Europa zeldzaam zijn; via Duitsland het volledige A6/A7/A8/Q-spectrum.',
  },
  {
    title: 'Porsche',
    slug: 'porsche',
    alt: 'Witte Porsche 911 GT3 RS bij een haven — import van zeldzame uitvoeringen',
    body: 'Het brede premium-aanbod van Porsche — 911 in alle generaties (993/996/997/991/992) en uitvoeringen (Carrera/Targa/Turbo/GT3), Cayman/Boxster (986/987/981/718), Cayenne, Macan en Panamera in sportieve uitvoeringen. Klassieke air-cooled op aanvraag. Voor 996/997.1 koop: lees onze <a href="/kennisbank/porsche-ims-lager-996-997">IMS-koopgids</a>. Voor 997.2: zie ook de <a href="/kennisbank/porsche-997-2-japan-vs-duitsland">Japan vs Duitsland cost-vergelijking</a>.',
    routes: 'Via Japan vooral 911 in LHD over alle generaties, Cayman/Boxster S/GTS en zeldzame uitvoeringen; via Duitsland tevens Cayenne, Macan en Panamera.',
  },
];

const niet = [
  { title: 'Geen bekende schade- of herstelhistorie', body: 'Voertuigen met R-, RA- of XX-classificatie op het Japanse veiling-sheet, of bekende accident- of herstelhistorie volgens TÜV/DEKRA-documentatie, vallen buiten onze sourcing.' },
  { title: 'Geen grade onder 4', body: 'Op de Japanse 1-5 conditieschaal accepteren wij uitsluitend 4, 4.5 of 5. Onder die grens komt geen auto in ons aanbod.' },
  { title: 'Geen onbekende historie', body: 'Geen onderhoudsboekje, geen complete service-records, geen herleidbare eigenarengeschiedenis — wij gaan niet bieden.' },
  { title: 'Geen volume-segmenten', body: 'A-Klasse, 1-Serie, A3, kei-cars, MPV\'s en standaard-diesels vallen buiten onze focus. Daar zijn andere specialisten beter in.' },
];
---

<BaseLayout
  title="Selectie — Wat wij sourcen | Rolvink Premium Imports"
  description="Welke Duitse premium-auto's wij wel en niet sourcen. BMW, Mercedes-Benz, Audi, Porsche. Strikte criteria op conditie, historie en uitvoering."
>
  <section class="selectie-page">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />

      <div class="section-eyebrow">Selectie</div>
      <h1>Onze <span class="accent">selectiecriteria</span>.</h1>
      <p class="lead">Wij beperken ons bewust tot vier merken en strikte kwaliteitseisen. Hieronder transparant wat we wél en niet sourcen — zodat u snel weet of we een match zijn. <strong>De voorbeelden per merk zijn illustratief, niet uitputtend</strong>: binnen elk merk bekijken we per opdracht welke specifieke uitvoering bij uw profiel past. Per merk geven we ook aan welk segment via Japan loopt en welk via Duitsland.</p>

      <section class="why-section">
        <h2>Waarom beperken wij ons tot vier merken?</h2>
        <p>De keuze voor BMW, Mercedes-Benz, Audi en Porsche is geen modegril of arbitraire selectie. Het is een bewuste discipline die voor onze klanten drie concrete voordelen oplevert.</p>

        <div class="why-grid">
          <div class="why-card">
            <div class="why-num">01</div>
            <h3>Diepe modelkennis per merk</h3>
            <p>Vier merken serieus volgen betekent dat wij elke generatie, elke motoruitvoering en elke bekende valkuil per model uit het hoofd kennen. Dat is het verschil tussen "we hebben een 2014 E350 voor u gevonden" en "we hebben een 2014 E350 met de port-injection M272 boven de balansas-cutoff voor u gevonden". Voor klanten die het verschil weten te waarderen is dat een gesprek waard.</p>
          </div>
          <div class="why-card">
            <div class="why-num">02</div>
            <h3>Sterke en bewezen restwaarde</h3>
            <p>Deze vier Duitse merken hebben in het premium segment een aantoonbaar sterkere restwaarde-curve dan generieke alternatieven. Bij doorverkoop of inruil is dat direct in euro's voelbaar. Volume-merken zoals VW Tiguan, Land Rover Discovery of Volvo XC60 zijn prima auto's, maar de prijsdaling per jaar is structureel steiler.</p>
          </div>
          <div class="why-card">
            <div class="why-num">03</div>
            <h3>Breed onderhoud- en specialistennetwerk</h3>
            <p>Voor BMW, Mercedes, Audi en Porsche zijn in Nederland en omringende landen tientallen onafhankelijke specialisten beschikbaar tegen redelijke tarieven. Onderdelen zijn breed verkrijgbaar, ook voor oudere modellen. Voor zeldzamere merken kunt u afhankelijk zijn van één specialist of dure dealer-tarieven.</p>
          </div>
        </div>

        <p>Daarbij geldt: <strong>al deze merken zijn structureel sterker vertegenwoordigd in de Japanse LHD-veilingmarkt</strong> dan andere premium-merken (Range Rover, Volvo, Jaguar). Voor de Japan-route is dit niet alleen een commerciële keuze, maar ook een feitelijke beperking van wat er met regelmaat beschikbaar komt. Een <a href="/kennisbank/porsche-911-modelgids">Porsche 911</a> in LHD vinden we elke maand; een Range Rover Sport in LHD aanzienlijk minder vaak.</p>

        <p>Zou u graag een Lexus, Volvo, Range Rover of klassieke Italiaan via ons sourcen? Wij verwijzen u dan eerlijk naar collega's die zich daarin specialiseren. Doen waar je goed in bent, niet alles voor iedereen.</p>
      </section>

      <h2>Wat wij wél sourcen</h2>
      <div class="grid">
        {wel.map((item) => (
          <div class="card card-wel">
            <figure class="card-img">
              <picture>
                <source
                  type="image/webp"
                  srcset={`/images/brand-${item.slug}-600.webp 600w, /images/brand-${item.slug}-1200.webp 1200w`}
                  sizes="(max-width: 768px) 100vw, 50vw"
                />
                <img
                  class="img-graded"
                  src={`/images/brand-${item.slug}-1200.jpg`}
                  srcset={`/images/brand-${item.slug}-600.jpg 600w, /images/brand-${item.slug}-1200.jpg 1200w`}
                  sizes="(max-width: 768px) 100vw, 50vw"
                  width="1200"
                  height="800"
                  loading="lazy"
                  decoding="async"
                  alt={item.alt}
                />
              </picture>
            </figure>
            <div class="card-body">
              <h3>{item.title}</h3>
              <p set:html={item.body} />
              <p class="routes"><strong>Routes:</strong> {item.routes}</p>
            </div>
          </div>
        ))}
      </div>

      <h2 style="margin-top: 72px;">Waar wij categorisch nee tegen zeggen</h2>
      <div class="grid">
        {niet.map((item) => (
          <div class="card card-niet">
            <div class="card-body">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="page-cta">
        <a href="/contact" class="page-cta-btn">
          Bespreek uw zoekopdracht
          <span class="arrow" aria-hidden="true">→</span>
        </a>
        <p class="page-cta-note">Vrijblijvend intake-gesprek — binnen 24 uur reactie.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .selectie-page { padding: 64px 0 96px; }
  .selectie-page h1 { font-size: 64px; font-weight: 600; margin-bottom: 24px; line-height: 1.05; }
  .selectie-page h2 { font-size: 28px; font-weight: 600; margin-bottom: 28px; }

  .why-section { margin-bottom: 72px; max-width: 920px; }
  .why-section h2 { font-size: 32px; margin-bottom: 20px; }
  .why-section > p { font-size: 17px; color: var(--color-text-secondary); line-height: 1.7; margin-bottom: 32px; max-width: 720px; }
  .why-section > p strong { color: var(--color-text-primary); font-weight: 600; }
  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 36px;
  }
  .why-card {
    background: var(--color-cream-warm);
    padding: 28px 24px;
    border-top: 3px solid var(--color-copper-text);
  }
  .why-num {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    color: var(--color-copper-text);
    margin-bottom: 12px;
    letter-spacing: -0.02em;
  }
  .why-card h3 {
    font-size: 17px;
    font-weight: 600;
    margin-bottom: 12px;
    line-height: 1.3;
  }
  .why-card p {
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }
  .lead { font-size: 18px; color: var(--color-text-secondary); max-width: 640px; margin-bottom: 64px; line-height: 1.6; }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }

  /* Card = sharp-cornered editorial block; image full-bleed on top, padded body below.
     Left accent encodes intent: copper = wél sourcen, charcoal = categorisch nee. */
  .card { background: var(--color-white); padding: 0; border-left: 3px solid var(--color-copper-text); overflow: hidden; }
  .card-niet { border-left-color: var(--color-charcoal); }
  .card-body { padding: 28px 28px; }

  .card-img {
    margin: 0;
    aspect-ratio: 3 / 2;          /* reserve space → geen CLS bij lazy-load */
    overflow: hidden;
    border-radius: 0;              /* sharp corners, consistent met ServiceStrip */
    background: var(--color-cream-warm);
  }
  .card-img img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .card h3 { font-size: 19px; font-weight: 600; margin-bottom: 10px; }
  .card p { font-size: 14px; color: var(--color-text-secondary); line-height: 1.6; }
  .card p.routes {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--color-border-soft);
    font-size: 13px;
    color: var(--color-text-tertiary);
  }
  .card p.routes strong {
    color: var(--color-copper-text);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-size: 11px;
    display: block;
    margin-bottom: 4px;
  }

  .page-cta { margin-top: 64px; padding: 48px 40px; background: var(--color-charcoal-dark); color: var(--color-cream); text-align: center; }
  .page-cta-btn { display: inline-flex; align-items: center; gap: 12px; padding: 18px 36px; background: var(--color-copper-text); color: var(--color-charcoal-dark); font-size: 14px; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; text-decoration: none; transition: transform 0.2s, background 0.2s; }
  .page-cta-btn:hover { transform: translateY(-2px); background: #d18a3f; }
  .page-cta-btn .arrow { font-size: 18px; }
  .page-cta-note { margin-top: 16px; font-size: 13px; color: rgba(245, 241, 234, 0.7); }

  @media (max-width: 768px) {
    .selectie-page h1 { font-size: 40px; }
    .grid { grid-template-columns: 1fr; }
    .why-grid { grid-template-columns: 1fr; }
    .why-section h2 { font-size: 24px; }
    .page-cta { padding: 36px 24px; }
  }
</style>
