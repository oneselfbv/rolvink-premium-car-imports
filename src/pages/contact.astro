---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

// Toon success-message na succesvolle form-submission (Formspree redirect ?sent=true)
const sent = Astro.url.searchParams.get('sent') === 'true';

// FORMSPREE: vervang YOUR_FORM_ID door je echte ID uit het Formspree-dashboard
// 1. Maak account op https://formspree.io
// 2. New Form → kopieer endpoint zoals https://formspree.io/f/xyzabcd
// 3. Vervang FORMSPREE_FORM_ID hieronder en push opnieuw
const FORMSPREE_FORM_ID = 'YOUR_FORM_ID';
const FORMSPREE_ACTION = `https://formspree.io/f/${FORMSPREE_FORM_ID}`;
---

<BaseLayout
  title="Contact — Rolvink Premium Imports"
  description="Vul het intake-formulier in of stuur direct een WhatsApp / e-mail. Vrijblijvend kennismakingsgesprek over uw zoekopdracht."
>
  <section class="contact-page">
    <div class="container">
      <div class="section-eyebrow">Contact</div>
      <h1>Een gesprek begint hier.</h1>
      <p class="lead">Vrijblijvend intake-gesprek over wat u zoekt, hoe wij werken, en wat realistisch is qua tijd en kosten. Geen verkoopdruk — gewoon een rustig gesprek.</p>

      {sent && (
        <div class="success-banner" role="status" aria-live="polite">
          <strong>Bedankt voor uw bericht.</strong>
          <p>Wij nemen binnen 24 uur contact met u op — meestal sneller. Zie ook uw inbox voor een ontvangstbevestiging.</p>
        </div>
      )}

      <div class="form-block">
        <h2>Intake-formulier</h2>
        <p class="form-intro">Vertel ons wat u zoekt. Hoe concreter, hoe scherper we kunnen reageren. Velden met <span aria-hidden="true">*</span> zijn verplicht.</p>

        <form action={FORMSPREE_ACTION} method="POST" class="intake-form" novalidate>
          <input type="hidden" name="_subject" value="Nieuwe intake — Rolvink Premium Imports" />
          <input type="hidden" name="_next" value="https://www.rolvinkpremiumcarimports.nl/contact/?sent=true" />
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="honeypot" />

          <div class="row">
            <div class="field">
              <label for="naam">Uw naam <span class="req" aria-hidden="true">*</span></label>
              <input id="naam" name="naam" type="text" required autocomplete="name" />
            </div>
            <div class="field">
              <label for="email">E-mailadres <span class="req" aria-hidden="true">*</span></label>
              <input id="email" name="email" type="email" required autocomplete="email" />
            </div>
          </div>

          <div class="row">
            <div class="field">
              <label for="telefoon">Telefoon (optioneel)</label>
              <input id="telefoon" name="telefoon" type="tel" autocomplete="tel" />
            </div>
            <div class="field">
              <label for="merk">Merk <span class="req" aria-hidden="true">*</span></label>
              <select id="merk" name="merk" required>
                <option value="">Kies een merk</option>
                <option value="BMW">BMW</option>
                <option value="Mercedes-Benz">Mercedes-Benz</option>
                <option value="Audi">Audi</option>
                <option value="Porsche">Porsche</option>
                <option value="Nog niet zeker">Nog niet zeker</option>
              </select>
            </div>
          </div>

          <div class="field">
            <label for="model">Model of uitvoering (optioneel)</label>
            <input id="model" name="model" type="text" placeholder="Bijvoorbeeld: E-Klasse W212 350 CDI Avantgarde 4Matic" />
          </div>

          <div class="row">
            <div class="field">
              <label for="budget">Budget (richtindicatie) <span class="req" aria-hidden="true">*</span></label>
              <select id="budget" name="budget" required>
                <option value="">Kies een bandbreedte</option>
                <option value="onder-20k">Onder €20.000</option>
                <option value="20-40k">€20.000 — €40.000</option>
                <option value="40-70k">€40.000 — €70.000</option>
                <option value="70-100k">€70.000 — €100.000</option>
                <option value="boven-100k">Boven €100.000</option>
                <option value="nog-niet-zeker">Nog niet zeker</option>
              </select>
            </div>
            <div class="field">
              <label for="tijdslijn">Wanneer wilt u rijden? <span class="req" aria-hidden="true">*</span></label>
              <select id="tijdslijn" name="tijdslijn" required>
                <option value="">Kies een tijdshorizon</option>
                <option value="zsm">Zo snel mogelijk</option>
                <option value="1-3-mnd">Binnen 1-3 maanden</option>
                <option value="3-6-mnd">Binnen 3-6 maanden</option>
                <option value="geen-haast">Geen haast — juiste exemplaar gaat voor</option>
              </select>
            </div>
          </div>

          <div class="field">
            <label for="route">Voorkeur route</label>
            <select id="route" name="route">
              <option value="geen-voorkeur">Geen voorkeur — adviseert u</option>
              <option value="europa">Europa (Duitsland) — snellere doorlooptijd</option>
              <option value="japan">Japan — lagere km, zeldzame uitvoeringen</option>
              <option value="beide">Beide routes open</option>
            </select>
          </div>

          <div class="field">
            <label for="toelichting">Aanvullende toelichting (optioneel)</label>
            <textarea id="toelichting" name="toelichting" rows="5" placeholder="Specifieke wensen, deal-breakers, eerdere ervaringen, of vragen over de werkwijze."></textarea>
          </div>

          <div class="field privacy">
            <label class="checkbox-label">
              <input type="checkbox" name="privacy_consent" value="ja" required />
              <span>Ik ga akkoord met de verwerking van mijn gegevens conform de <a href="/privacy">privacyverklaring</a>. <span class="req" aria-hidden="true">*</span></span>
            </label>
          </div>

          <button type="submit" class="submit-btn">
            Verstuur intake
            <span class="arrow" aria-hidden="true">→</span>
          </button>

          <p class="form-footer-note">Wij reageren binnen 24 uur. Geen automatische vervolgmails of marketinglijsten.</p>
        </form>
      </div>

      <div class="contact-alt">
        <h2>Liever direct contact?</h2>
        <div class="contact-grid">
          <div class="contact-block">
            <h3>WhatsApp</h3>
            <p>Snelste manier om in contact te komen. Stuur uw vraag, ik reageer binnen 24 uur.</p>
            <WhatsAppButton label="Begin gesprek" />
          </div>

          <div class="contact-block">
            <h3>E-mail</h3>
            <p>Voor uitgebreide vragen of bijgevoegde documenten.</p>
            <a href="mailto:contact@rolvinkpremiumcarimports.nl" class="cta">E-mail Theo<span class="arrow">→</span></a>
          </div>

          <div class="contact-block">
            <h3>Bezoek</h3>
            <p>Op afspraak in Welsum (gemeente Olst-Wijhe). Reserveer minimaal 48 uur vooruit.</p>
            <address style="font-style: normal; font-size: 14px; color: var(--color-text-secondary); line-height: 1.6;">
              Veldweg 15<br/>
              8196 KS Welsum<br/>
              Nederland
            </address>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-page { padding: 80px 0 80px; }
  .contact-page h1 { font-size: 64px; font-weight: 600; margin-bottom: 24px; }
  .lead { font-size: 18px; color: var(--color-text-secondary); max-width: 640px; margin-bottom: 56px; line-height: 1.6; }

  .success-banner {
    background: #1F4F30;
    color: var(--color-cream);
    padding: 24px 28px;
    margin-bottom: 56px;
    border-left: 4px solid var(--color-copper-text);
  }
  .success-banner strong { font-size: 18px; display: block; margin-bottom: 6px; }
  .success-banner p { font-size: 15px; opacity: 0.9; }

  .form-block { max-width: 760px; margin-bottom: 80px; }
  .form-block h2 { font-size: 32px; font-weight: 600; margin-bottom: 14px; }
  .form-intro { font-size: 15px; color: var(--color-text-secondary); margin-bottom: 36px; line-height: 1.6; }
  .form-intro .req, .field .req { color: var(--color-copper-text); font-weight: 600; }

  .intake-form { display: flex; flex-direction: column; gap: 22px; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  .field { display: flex; flex-direction: column; gap: 8px; }
  .field label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-charcoal-dark);
  }
  .field input, .field select, .field textarea {
    font-family: inherit;
    font-size: 15px;
    padding: 12px 14px;
    background: var(--color-white);
    border: 1px solid var(--color-border-medium);
    border-radius: 0;
    color: var(--color-text-primary);
    transition: border-color 0.2s;
  }
  .field input:focus, .field select:focus, .field textarea:focus {
    outline: none;
    border-color: var(--color-copper-text);
  }
  .field textarea { resize: vertical; min-height: 120px; font-family: inherit; }

  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .privacy { margin-top: 8px; }
  .checkbox-label {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 14px;
    line-height: 1.5;
    text-transform: none;
    letter-spacing: normal;
    font-weight: 400;
    color: var(--color-text-secondary);
    cursor: pointer;
  }
  .checkbox-label input[type="checkbox"] {
    margin-top: 3px;
    flex-shrink: 0;
  }
  .checkbox-label a { color: var(--color-copper-text); text-decoration: underline; }

  .submit-btn {
    align-self: flex-start;
    margin-top: 14px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 18px 36px;
    background: var(--color-charcoal-dark);
    color: var(--color-cream);
    border: none;
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
  }
  .submit-btn:hover { background: var(--color-copper-text); color: var(--color-charcoal-dark); transform: translateY(-2px); }
  .submit-btn .arrow { font-size: 18px; }
  .form-footer-note {
    font-size: 13px;
    color: var(--color-text-secondary);
    margin-top: 12px;
    font-style: italic;
  }

  .contact-alt { padding-top: 48px; border-top: 1px solid var(--color-border-medium); }
  .contact-alt h2 { font-size: 28px; font-weight: 600; margin-bottom: 32px; }
  .contact-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .contact-block { background: var(--color-white); padding: 32px 28px; border-left: 3px solid var(--color-copper-text); }
  .contact-block h3 { font-size: 20px; margin-bottom: 12px; font-weight: 600; }
  .contact-block p { font-size: 14px; color: var(--color-text-secondary); line-height: 1.55; margin-bottom: 20px; }

  @media (max-width: 768px) {
    .contact-page h1 { font-size: 40px; }
    .row { grid-template-columns: 1fr; }
    .contact-grid { grid-template-columns: 1fr; }
  }
</style>

<script is:inline>
  /* Conversie-tracking: vuur form_submit alleen bij bevestigde Formspree-inzending (?sent=true) */
  if (new URLSearchParams(location.search).get('sent') === 'true' && typeof gtag === 'function') {
    gtag('event', 'form_submit', { form: 'intake' });
  }
</script>
