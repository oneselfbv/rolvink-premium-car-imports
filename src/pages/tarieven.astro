---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Tarieven' },
];

const lossDiensten = [
  {
    title: 'DRZ-taxatierapport voor tegenbewijsregeling',
    price: '€ 350',
    body: 'Fysieke taxatie door een erkende DRZ-taxateur, te gebruiken als onderbouwing voor de BPM-aangifte volgens de tegenbewijsregeling.',
  },
  {
    title: 'Intake-gesprek',
    price: 'Gratis',
    body: 'Online via Google Meet, WhatsApp of telefonisch — maximaal 60 minuten (Duitsland-route) of 90 minuten (Japan-route). Geen verkoopdruk, eerlijk advies of er een match is.',
  },
];
---

<BaseLayout
  title="Tarieven — sourcing auto's & motoren | Rolvink"
  description="Transparante tarieven: sourcing Duitsland vanaf €2.250, Japan €3.250, en het nieuwe motor-traject vanaf €1.250 — met gefaseerde betalingen."
>
  <section class="tariff-page">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />

      <div class="section-eyebrow">Tarieven</div>
      <h1>Transparante prijzen <span class="accent">vóór</span> u tekent.</h1>
      <p class="lead">Wij rekenen geen kickback over BPM-besparing, geen marge op de aanschafprijs en geen verborgen handling-fee. U betaalt onze sourcing-fee in fasen — zodat uw werkkapitaal niet maandenlang stilstaat op de oceaan.</p>

      <!-- TWO-TIER PRICING -->
      <div class="tier-grid">

        <!-- TIER 1: DUITSLAND -->

        <div class="tier tier-de">
          <figure class="tier-photo">
            <picture>
              <source type="image/webp" srcset="/images/tier-duitsland-600.webp 600w, /images/tier-duitsland-1200.webp 1200w" sizes="(max-width: 900px) 100vw, 50vw" />
              <img class="img-graded" src="/images/tier-duitsland-1200.jpg" srcset="/images/tier-duitsland-600.jpg 600w, /images/tier-duitsland-1200.jpg 1200w" sizes="(max-width: 900px) 100vw, 50vw" width="1200" height="800" loading="lazy" decoding="async" alt="Zwarte BMW M4 onderweg — sourcing-traject Duitsland" />
            </picture>
          </figure>
          <div class="tier-tag">Snelste route</div>
          <h2>Sourcing-traject Duitsland</h2>
          <div class="tier-price">vanaf € 2.250 <span class="tier-vat">incl. btw</span></div>
          <p class="tier-lead">Voor wie binnen 2 tot 4 weken in de auto wil rijden. Wij sourcen bij erkende Duitse premium-dealers, bezichtigen ter plaatse en regelen het volledige traject tot aflevering aan huis.</p>

          <h3>Gefaseerde betaling</h3>
          <div class="phase-block">
            <div class="phase">
              <div class="phase-step">Fase 1</div>
              <div class="phase-amount">€ 750</div>
              <div class="phase-when">Bij start — retainer</div>
              <p>Vóór wij gaan zoeken. Verrekenbaar met de eindfee bij succesvolle aankoop. Niet-restitueerbaar bij annulering door opdrachtgever na bod-akkoord.</p>
            </div>
            <div class="phase">
              <div class="phase-step">Fase 2</div>
              <div class="phase-amount">€ 1.500</div>
              <div class="phase-when">Bij aflevering — restbetaling</div>
              <p>Bij sleuteloverdracht op uw adres in Nederland, met kenteken, APK en alle documentatie compleet.</p>
            </div>
          </div>

          <h3>Wat ons traject inhoudt</h3>
          <ul class="tier-list">
            <li>Intake-gesprek + profiel-document met must-haves en deal-breakers</li>
            <li>Kandidaatvoorstellen (3-5 auto's binnen 1-2 weken)</li>
            <li>Bezichtiging ter plaatse in Duitsland vóór bod</li>
            <li>Dealer-onderhandeling op uw belang, transport DE→NL, RDW-keuring, BPM-aangifte via voordeligste methode, kentekening</li>
            <li>Aflevering aan huis in NL</li>
          </ul>

          <p class="tier-scope">Aanschafprijs van de auto, BPM, transport en RDW-kosten betaalt u zelf rechtstreeks (transparant gerapporteerd, geen marge bij ons).</p>
          <a href="/contact" class="tier-cta">Plan intake-gesprek<span class="arrow" aria-hidden="true">→</span></a>
        </div>

        <!-- TIER 3: JAPAN -->
        <div class="tier tier-jp tier-feature">
          <figure class="tier-photo">
            <picture>
              <source type="image/webp" srcset="/images/tier-japan-600.webp 600w, /images/tier-japan-1200.webp 1200w" sizes="(max-width: 900px) 100vw, 50vw" />
              <img class="img-graded" src="/images/tier-japan-1200.jpg" srcset="/images/tier-japan-600.jpg 600w, /images/tier-japan-1200.jpg 1200w" sizes="(max-width: 900px) 100vw, 50vw" width="1200" height="800" loading="lazy" decoding="async" alt="Porsche 911 in nachtelijk Ginza, Tokio — sourcing-traject Japan" />
            </picture>
          </figure>
          <div class="tier-tag">Onze specialisatie</div>
          <h2>Sourcing-traject Japan</h2>
          <div class="tier-price">€ 3.250 <span class="tier-vat">incl. btw</span></div>
          <p class="tier-lead">Voor wie een zeldzame LHD-uitvoering uit Japan zoekt — lagere kilometers, droger klimaat, Shaken-discipline. Reken op 10 tot 14 weken vanaf veiling tot Nederlandse kentekenplaat.</p>

          <h3>Gefaseerde betaling — drie fases</h3>
          <div class="phase-block">
            <div class="phase">
              <div class="phase-step">Fase 1</div>
              <div class="phase-amount">€ 1.250</div>
              <div class="phase-when">Bij start — retainer</div>
              <p>Vóór wij beginnen met de wekelijkse veiling-screening op USS, JU en JAA. Verrekenbaar met eindfee bij succes.</p>
            </div>
            <div class="phase">
              <div class="phase-step">Fase 2</div>
              <div class="phase-amount">Aanschaf + transport</div>
              <div class="phase-when">Direct na hammer-down</div>
              <p>U betaalt de gewonnen auctie-prijs (in yen, gecommuniceerd vooraf) plus binnen-Japan-transport en RoRo-zeevracht. U koopt de auto direct via volmacht; wij staan ertussen als coördinator, niet als wederverkoper.</p>
            </div>
            <div class="phase">
              <div class="phase-step">Fase 3</div>
              <div class="phase-amount">€ 2.000 + invoer</div>
              <div class="phase-when">Bij aflevering — restbetaling</div>
              <p>Restant sourcing-fee € 2.000 plus 10% invoerrechten, 21% BTW, BPM en RDW-kosten. Pas bij sleuteloverdracht in Nederland.</p>
            </div>
          </div>

          <h3>Wat ons Japan-traject inhoudt</h3>
          <ul class="tier-list">
            <li>Uitgebreid intake-gesprek (90 min) — profiel, conditie-grens, kleurvoorkeur, must-haves</li>
            <li>Wekelijkse JCD/USS/JU/JAA-screening met Nederlandstalige sheet-vertaling per kandidaat</li>
            <li>Bod-strategie en bieden via onze gevestigde Japanse export-partner</li>
            <li>Coördinatie binnenlands transport Japan, exportformaliteiten, RoRo-zeevracht</li>
            <li>Douane-afhandeling Rotterdam, RDW-keuring, BPM-aangifte, kentekening</li>
            <li>Aflevering aan huis in NL</li>
          </ul>

          <p class="tier-scope">Aanschafprijs (yen), binnenlands transport Japan, RoRo, douane-heffingen, BPM en RDW betaalt u zelf. Wij coördineren elke betaling transparant — u ziet elke factuur.</p>
          <a href="/contact" class="tier-cta tier-cta-feature">Plan intake-gesprek<span class="arrow" aria-hidden="true">→</span></a>
        </div>

      </div>


      <!-- MOTOR-TRAJECT -->
      <div class="moto-tariff">
        <figure class="moto-tariff-img">
          <img class="img-graded" src="/images/moto-hero.jpg" width="1600" height="700" loading="lazy" decoding="async" alt="Open bergweg bij gouden uur — sourcing-traject motoren" />
        </figure>
        <div class="moto-tariff-body">
          <div class="tier-tag">Nieuw — Motoren</div>
          <h2>Sourcing-traject Motor</h2>
          <div class="tier-price">€ 1.250 <span class="tier-vat">incl. btw</span></div>
          <p class="tier-lead">Voor de import van een (BMW-)motor uit Duitsland. Binnen de EU, dus geen invoerrechten of zeevracht — doorgaans 1 tot 3 weken. Wij sourcen op mobile.de en Kleinanzeigen.de, beoordelen de modelspecifieke zwakke punten, en regelen alles tot Nederlands kenteken.</p>
          <h3>Gefaseerde betaling</h3>
          <div class="phase-block">
            <div class="phase">
              <div class="phase-step">Fase 1</div>
              <div class="phase-amount">€ 500</div>
              <div class="phase-when">Bij start — retainer</div>
              <p>Vóór wij gaan zoeken. Verrekenbaar met de eindfee bij succesvolle aankoop.</p>
            </div>
            <div class="phase">
              <div class="phase-step">Fase 2</div>
              <div class="phase-amount">€ 750</div>
              <div class="phase-when">Bij aflevering — restbetaling</div>
              <p>Bij overdracht met Nederlands kenteken en alle documentatie compleet.</p>
            </div>
          </div>
          <h3>Wat ons motor-traject inhoudt</h3>
          <ul class="tier-list">
            <li>Intake + profiel: model, bouwjaar, uitvoering en budget</li>
            <li>Gerichte screening op mobile.de en Kleinanzeigen.de</li>
            <li>Beoordeling van de modelspecifieke aandachtspunten (recalls, servorem, oliepomp, etc.)</li>
            <li>Onderhandeling, transport DE→NL, RDW-keuring, motor-BPM-aangifte en kentekening</li>
            <li>Aflevering met Nederlands kenteken</li>
          </ul>
          <p class="tier-scope">Aanschafprijs, transport, motor-BPM en RDW betaalt u zelf, transparant gerapporteerd zonder marge bij ons. Zie de <a href="/kennisbank/motor-bpm-importeren">motor-BPM-pagina</a> en het <a href="/motoren">motoren-overzicht</a>.</p>
          <a href="/contact" class="tier-cta">Plan intake-gesprek<span class="arrow" aria-hidden="true">&#8594;</span></a>
        </div>
      </div>

      <!-- LOSSE DIENSTEN -->
      <div class="extra-section">
        <h2 class="extra-heading">Losse diensten</h2>
        <p class="extra-lead">Niet elke vraag vereist een volledig sourcing-traject. Voor specifieke onderdelen van het importproces kunt u losse diensten afnemen.</p>

        <div class="extra-grid">
          {lossDiensten.map((d) => (
            <div class="extra-item">
              <div class="extra-row">
                <h3>{d.title}</h3>
                <div class="extra-price">{d.price}</div>
              </div>
              <p>{d.body}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- TRANSPARANTIE-DISCLAIMER -->
      <div class="transparency-block">
        <h2>Onze financiële spelregels</h2>
        <ul class="transparency-list">
          <li><strong>Geen kickback op BPM-besparing.</strong> Wat wij voor u besparen via de gunstigste methode komt 100% bij u terecht. Wij rekenen onze sourcing-fee, niets meer.</li>
          <li><strong>Geen marge op de aanschafprijs.</strong> U betaalt rechtstreeks aan de Duitse dealer of via de Japanse veiling-partner. Wij koppelen elk bedrag terug met factuur.</li>
          <li><strong>Geen verborgen handling-kosten.</strong> Transport, douane, BPM, RDW worden tegen kostprijs doorberekend, met onderliggende facturen.</li>
          <li><strong>Heldere voorwaarden vooraf.</strong> Vóór de retainer ondertekent u een opdrachtovereenkomst waarin de scope, betalingsfasen en annuleringsregeling expliciet staan vermeld.</li>
        </ul>
        <p style="margin-top: 24px; font-size: 15px; color: rgba(245, 241, 234, 0.8); line-height: 1.6;">Wilt u zien hoe deze tarievenstructuur uitpakt in de praktijk? Een volledig doorgerekende W212-case staat op <a href="/voorbeeld-traject">/voorbeeld-traject</a>. Twijfelt u tussen Japan en Duitsland? Gebruik de <a href="/route-advies">route-advies-tool</a>. Een indicatieve BPM-berekening krijgt u via de <a href="/bpm-calculator">BPM-tool</a>.</p>
      </div>

      <div class="page-cta">
        <h2>Bespreek uw zoekopdracht — vrijblijvend.</h2>
        <p>Een gratis intake-gesprek (Google Meet, WhatsApp of telefoon) waarin we uw profiel, route en realistische landed-cost doornemen. Geen verkoopdruk, geen verplichtingen.</p>
        <a href="/contact" class="page-cta-btn">
          Plan vrijblijvend intake-gesprek
          <span class="arrow" aria-hidden="true">→</span>
        </a>
        <p class="page-cta-note">Binnen 24 uur reactie</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .tariff-page { padding: 64px 0 96px; }
  .tariff-page h1 { font-size: 56px; font-weight: 600; margin-bottom: 24px; line-height: 1.05; }
  .lead { font-size: 18px; color: var(--color-text-secondary); max-width: 760px; margin-bottom: 64px; line-height: 1.6; }

  /* Three-tier grid */
  .tier-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    margin-bottom: 96px;
    max-width: 1100px;
    margin-left: auto;
    margin-right: auto;
  }
  .tier {
    background: var(--color-white);
    padding: 36px 32px;
    border: 1px solid var(--color-border-medium);
    display: flex;
    flex-direction: column;
  }
  .tier-photo {
    margin: -36px -32px 28px;        /* full-bleed boven de kaartpadding */
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--color-cream-warm);
  }
  .tier-feature .tier-photo { margin: -36px -32px 28px; }
  .tier-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; }
  .tier-feature {
    border: 2px solid var(--color-copper-text);
    background: var(--color-cream-warm);
  }
  .tier-tag {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-copper-text);
    margin-bottom: 16px;
  }
  .tier h2 {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 16px;
    line-height: 1.2;
    color: var(--color-text-primary);
  }
  .tier-price {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 600;
    color: var(--color-charcoal-dark);
    margin-bottom: 4px;
    letter-spacing: -0.02em;
  }
  .tier-vat {
    font-size: 13px;
    font-weight: 400;
    color: var(--color-text-tertiary);
    letter-spacing: 0;
  }
  .tier-price-note {
    font-size: 13px;
    color: var(--color-text-tertiary);
    margin-bottom: 16px;
    line-height: 1.5;
  }
  .tier-lead {
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 28px;
  }
  .tier h3 {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-copper-text);
    margin: 0 0 16px;
  }
  .tier-list {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
  }
  .tier-list li {
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-text-secondary);
    padding: 8px 0 8px 22px;
    position: relative;
    border-bottom: 1px solid var(--color-border-soft);
  }
  .tier-list li:last-child { border-bottom: none; }
  .tier-list li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--color-copper-text);
    font-weight: 600;
  }

  .phase-block {
    margin-bottom: 28px;
  }
  .phase {
    padding: 16px 0;
    border-top: 1px solid var(--color-border-medium);
  }
  .phase:last-child {
    border-bottom: 1px solid var(--color-border-medium);
  }
  .phase-step {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-copper-text);
    margin-bottom: 4px;
  }
  .phase-amount {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 4px;
  }
  .phase-when {
    font-size: 12px;
    color: var(--color-text-tertiary);
    margin-bottom: 8px;
    font-style: italic;
  }
  .phase p {
    font-size: 13px;
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin: 0;
  }

  .tier-foot {
    margin-top: auto;
    padding-top: 20px;
    border-top: 1px solid var(--color-border-medium);
    margin-bottom: 16px;
  }
  .tier-foot-key {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-copper-text);
    margin-bottom: 6px;
  }
  .tier-foot-text {
    font-size: 13px;
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin: 0;
  }
  .tier-scope {
    font-size: 12px;
    color: var(--color-text-tertiary);
    font-style: italic;
    margin: 16px 0 0;
    line-height: 1.5;
  }

  /* Losse diensten */
  .extra-section { margin-bottom: 80px; }
  .extra-heading {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 600;
    margin-bottom: 16px;
  }
  .extra-lead {
    font-size: 16px;
    color: var(--color-text-secondary);
    max-width: 680px;
    line-height: 1.6;
    margin-bottom: 36px;
  }
  .extra-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--color-border-medium);
    border: 1px solid var(--color-border-medium);
  }
  .extra-item {
    background: var(--color-white);
    padding: 28px 28px;
  }
  .extra-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 12px;
  }
  .extra-item h3 {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-text-primary);
    margin: 0;
  }
  .extra-price {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    color: var(--color-copper-text);
    white-space: nowrap;
  }
  .extra-item p {
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin: 0;
  }

  /* Transparantie-block */
  .transparency-block {
    background: var(--color-charcoal-dark);
    color: var(--color-cream);
    padding: 56px 48px;
    margin-bottom: 64px;
  }
  .transparency-block a { color: var(--color-copper); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .transparency-block a:hover { color: var(--color-cream); }
  .transparency-block h2 {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 600;
    margin-bottom: 28px;
    color: var(--color-cream);
  }
  .transparency-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .transparency-list li {
    padding: 14px 0;
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-cream);
    border-bottom: 1px solid rgba(245, 241, 234, 0.15);
  }
  .transparency-list li:last-child { border-bottom: none; }
  .transparency-list strong {
    color: var(--color-copper-text);
    font-weight: 600;
  }

  /* CTA */
  .page-cta {
    padding: 48px 28px;
    background: var(--color-cream-warm);
    text-align: center;
  }
  .page-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 18px 36px;
    background: var(--color-copper-text);
    color: var(--color-charcoal-dark);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform 0.2s, background 0.2s;
  }
  .page-cta-btn:hover {
    background: var(--color-copper-dark);
    color: var(--color-cream);
  }
  .page-cta-btn .arrow {
    font-size: 18px;
    line-height: 1;
  }
  .page-cta h2 { font-family: var(--font-display); font-size: 28px; font-weight: 600; margin-bottom: 12px; }
  .page-cta p { font-size: 15px; color: var(--color-text-secondary); max-width: 560px; margin: 0 auto 24px; line-height: 1.6; }
  .page-cta-note { margin-top: 16px; font-size: 13px; color: var(--color-text-tertiary); }

  /* Per-tier conversie-CTA — onderaan elke prijskaart uitgelijnd */
  .tier-cta {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 24px;
    border: 1.5px solid var(--color-copper-text);
    color: var(--color-copper-text);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    transition: background 0.2s, color 0.2s, transform 0.2s;
  }
  .tier-cta:hover { background: var(--color-copper-text); color: var(--color-cream); transform: translateY(-2px); }
  .tier-cta-feature { background: var(--color-copper-text); color: var(--color-charcoal-dark); border-color: var(--color-copper-text); }
  .tier-cta-feature:hover { background: var(--color-copper-dark); color: var(--color-cream); }
  .tier-cta .arrow { font-size: 16px; line-height: 1; }

  /* Mobile */
  @media (max-width: 900px) {
    .tariff-page h1 { font-size: 36px; }
    .tier-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .extra-grid {
      grid-template-columns: 1fr;
    }
    .transparency-block {
      padding: 36px 24px;
    }
    .transparency-block h2 { font-size: 22px; }
    .extra-heading { font-size: 24px; }
  }

  /* Motor-traject (horizontale feature) */
  .moto-tariff { display: grid; grid-template-columns: 0.92fr 1.08fr; max-width: 1100px; margin: 0 auto 96px; border: 1px solid var(--color-border-medium); background: var(--color-white); overflow: hidden; }
