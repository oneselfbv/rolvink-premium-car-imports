---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Kennisbank', url: '/kennisbank' },
  { name: 'FAQ — Auto importeren uit Japan' },
];

const faqCategories = [
  {
    title: 'Proces en doorlooptijd',
    items: [
      {
        q: 'Hoe lang duurt het om een auto uit Japan te importeren?',
        snippet: 'Reken op 10 tot 14 weken vanaf hammerprijs op de Japanse veiling tot Nederlandse kentekenplaat. Het grootste deel daarvan — 5 tot 6 weken — is de RoRo-zeevracht naar Rotterdam.',
        a: 'Onderverdeling: 1-2 weken voor binnenlands transport en exportformaliteiten in Japan, 5-6 weken RoRo-zeevracht naar Rotterdam (soms uitlopend tot 7-8 weken bij seizoens-effect), 2-5 weken voor douane, BPM, RDW-keuring en kentekenregistratie in Nederland.',
      },
      {
        q: 'Welke stappen volgen er in het import-traject?',
        snippet: 'Het traject omvat acht stappen: intake-gesprek, profiel vastleggen, kandidaten voorstellen, bod en aankoop, transport en import, RDW + BPM + kentekening, aflevering aan huis, en optionele detailing.',
        a: 'Het volledige proces staat beschreven op onze werkwijze-pagina en in onze gids "Auto importeren uit Japan in 2026". Elke stap wordt vooraf met u doorgesproken en u krijgt na elke fase een statusupdate.',
      },
      {
        q: 'Wat als ik een specifieke kleur of optiepakket wil dat zelden voorkomt?',
        snippet: 'Bij zeldzame uitvoeringen kan het 2 tot 4 maanden duren voordat een passende kandidaat op een Japanse veiling verschijnt. Geduld is dan onderdeel van de strategie — wij signaleren zodra een match opduikt.',
        a: 'Wij screenen op uw opdracht JCD, USS, JU en JAA. Zodra een kandidaat de profielcriteria raakt, ontvangt u sheet + foto\'s + duiding. Bieden gebeurt pas met uw expliciete goedkeuring; geen actie zonder uw groen licht.',
      },
      {
        q: 'Kan de doorlooptijd korter dan 10 weken?',
        snippet: 'Nee — de RoRo-zeevracht uit Japan duurt structureel 5 tot 6 weken en is niet te versnellen. Voor wie binnen 4 weken in de auto wil rijden, is de Duitsland-route de logische keuze.',
        a: 'Onze route-advies-tool laat per model zien welke bronmarkt past bij uw tijdslijn. Voor performance-uitvoeringen en klassiekers met lage km blijft Japan vaak de moeite waard ondanks de langere doorlooptijd.',
      },
      {
        q: 'Wat gebeurt er als de zeevracht vertraging oploopt?',
        snippet: 'Zeevracht-vertragingen zijn niet uitzonderlijk — wisselende vaarroutes, weersomstandigheden of beschikbaarheid bij Rotterdam-terminals kunnen 1 tot 2 weken extra toevoegen. Tijdens transit krijgt u tracking-updates.',
        a: 'Wij houden u op de hoogte van het werkelijke aankomstmoment en passen de planning voor RDW en kentekening daarop aan. De totale doorlooptijd communiceren wij vooraf als bandbreedte, niet als harde belofte.',
      },
    ],
  },
  {
    title: 'Veilingen, grades en conditie',
    items: [
      {
        q: 'Wat betekent een grade 4 of 4.5 op een Japans veiling-sheet?',
        snippet: 'Grade 4 staat voor goede staat met normale gebruikssporen passend bij km-stand en bouwjaar, zonder bekende schade- of herstelhistorie. Grade 4.5 is uitstekende staat met minimale gebruikssporen onder de 100.000 km.',
        a: 'De Japanse auction-grading van 1 tot 6 is een onafhankelijke conditie-rating. Grade 6/S is showroom-/nieuwstaat, grade 5 vrijwel nieuwstaat (zeldzaam in oudere bouwjaren). Wij sourcen uitsluitend grade 4 of hoger.',
      },
      {
        q: 'Wat zijn R, RA, A, X en XX letter-codes?',
        snippet: 'Letter-codes op Japanse veiling-sheets duiden op reparatie- of inspectie-issues: R = grote reparatie (vaak chassis-schade), RA = lichte reparatie, A = aanvullende notitie, X = niet geïnspecteerd, XX = total loss.',
        a: 'Wij bieden niet op auto\'s met deze codes, ongeacht het numerieke grade. Zelfs een grade 4 met R-code valt buiten ons profiel — die concessie maken wij niet voor klanten.',
      },
      {
        q: 'Welke Japanse veilinghuizen werken jullie mee?',
        snippet: 'Wij hebben rechtstreeks toegang tot de grootste Japanse veilingnetwerken — USS, JU en JAA — plus regionale veilinghuizen zoals CAA, ARAI, ZIP en BAYAUC. Bieden gebeurt via onze gevestigde Japanse export-partners.',
        a: 'Deze netwerken samen vertegenwoordigen het overgrote deel van het Japanse veilingvolume. Dankzij onze partners hebben we toegang tot zowel de grote landelijke veilingen als de regionale veilinghuizen waar zeldzame uitvoeringen opduiken.',
      },
      {
        q: 'Wat is het verschil tussen JCD en USS?',
        snippet: 'JCD (Japan Car Direct) is een internationale broker/agent die toegang geeft tot meerdere veilinghuizen. USS (Used-car System Solutions) is zelf een specifiek veilingnetwerk met meerdere fysieke locaties in Japan.',
        a: 'Wij gebruiken JCD als export-partner en hebben via die route toegang tot zowel USS, JU als JAA en andere veilingsnetwerken voor het concrete bieden. JCD is dus niet de veiling zelf, maar het kanaal waarlangs wij bieden en exporteren.',
      },
      {
        q: 'Wat als de auto bij aankomst niet matcht met het veiling-sheet?',
        snippet: 'JCD en de grote Japanse veilinghuizen werken met formele klachtenprocedures als er afwijkingen worden gevonden ten opzichte van het officiële sheet. Wij coördineren een eventueel claim-traject voor u.',
        a: 'In de praktijk zijn echte afwijkingen zeldzaam bij grade 4 en hoger; juist die conditie-grens minimaliseert dit risico. De inspecteurs van de grote netwerken zijn streng en hun reputatie staat op het spel bij elke sheet.',
      },
      {
        q: 'Kan ik de auto vóór aankoop bezichtigen?',
        snippet: 'Persoonlijke bezichtiging in Japan is niet praktisch. In plaats daarvan ontvangt u het officiële veiling-sheet, 30+ foto\'s inclusief onderzijde en interieur, en onze Nederlandstalige duiding.',
        a: 'Een sheet bevat 20-30 datapunten over conditie. Optioneel kunnen wij een aanvullend pre-bid inspectierapport laten maken (€80-150 extra). U beslist op basis van die documentatie voordat wij bieden — geen verrassingen achteraf.',
      },
    ],
  },
  {
    title: 'LHD versus RHD',
    items: [
      {
        q: 'Wat is het verschil tussen LHD en RHD bij Japanse auto\'s?',
        snippet: 'LHD (Left Hand Drive, stuur links) is de Nederlandse en EU-standaard. RHD (Right Hand Drive, stuur rechts) is de Japanse standaard. Wij sourcen uitsluitend originele LHD — geen RHD-conversies.',
        a: 'Op JCD worden LHD-rijen vaak met een groene achtergrond gemarkeerd. Dat zijn auto\'s die ooit als nieuw naar Japan zijn geëxporteerd door de Europese fabrikant en daardoor met origineel stuur-links beschikbaar zijn.',
      },
      {
        q: 'Doen jullie ook RHD-conversies?',
        snippet: 'Nee. RHD-conversies zijn technisch ingrijpend (stuurinrichting, dashboard, pedalen, ruitwissers, airbags) en gaan altijd ten koste van originaliteit en marktwaarde. Voor liefhebbersauto\'s is dat een onaanvaardbare concessie.',
        a: 'Wij wachten op originele LHD-uitvoeringen. Dat duurt soms langer, maar het verschil in eindkwaliteit en restwaarde rechtvaardigt het wachten. Een geconverteerde auto is in NL bovendien moeilijker te verkopen.',
      },
      {
        q: 'Welke modellen zijn sterk vertegenwoordigd in LHD-aanbod?',
        snippet: 'Performance-uitvoeringen (BMW M, Mercedes AMG, Porsche 911, Audi RS) en klassiekers (Mercedes R107/R129, Porsche 993) zijn structureel het sterkst vertegenwoordigd. Stations zijn praktisch niet beschikbaar in LHD-Japan.',
        a: 'Voor estates en wagons blijft Duitsland de logische route. Onze route-advies-tool toont per model de verwachte beschikbaarheid en adviseert per geval welke bron de juiste keuze is.',
      },
    ],
  },
  {
    title: 'Belastingen — BTW, BPM en invoerrechten',
    items: [
      {
        q: 'Is er invoerrechten verschuldigd op een auto uit Japan?',
        snippet: 'Ja. 10% invoerrechten over de CIF-waarde (hammerprijs + transport + verzekering, alles tot aan de NL-haven). Dit is een EU-tarief onder HS-code 8703 voor personenauto\'s.',
        a: 'Voor klassiekers ouder dan 30 jaar gelden vaak verlaagde tarieven onder HS-code 9705 (mogelijk 0% invoerrechten). Per kandidaatauto controleren wij de toepasselijke HS-code vooraf bij de douane-agent.',
      },
      {
        q: 'Hoeveel BTW betaal ik?',
        snippet: '21% BTW over de CIF-waarde plus invoerrechten — verschuldigd voor elke import uit een niet-EU-land zoals Japan. Voor klassiekers ouder dan 30 jaar onder HS-code 9705 geldt soms het verlaagde 9% tarief.',
        a: 'Voor EV\'s en hybrides gelden geen aparte BTW-regelingen — het standaardtarief van 21% is dan ook van toepassing. Hou er rekening mee dat BTW-tarieven jaarlijks kunnen wijzigen; raadpleeg de Belastingdienst voor de actuele situatie.',
      },
      {
        q: 'Hoe wordt BPM berekend?',
        snippet: 'BPM kent drie methoden: forfaitaire afschrijving (vaste tabel), koerslijst (X-Ray of Eurotax) en DRZ-taxatie (fysieke taxateur). Wij rekenen alle drie door en kiezen de gunstigste voor uw auto.',
        a: 'Voor moderne premium-auto\'s is de koerslijst-methode vaak het voordeligst dankzij de snelle waardedaling. Zie onze BPM-gids voor de volledige uitleg per methode en wanneer welke methode het meest oplevert.',
      },
      {
        q: 'Wat zijn typische BPM-bedragen voor premium import?',
        snippet: 'Indicatief: een 2014 W212 E300 V6 komt op €1.150-€1.600 via koerslijst, een M5 F10 op €2.000-€2.500, een 996 Carrera S 2003 op €700-€1.100. Auto\'s ouder dan 40 jaar zijn vrijgesteld.',
        a: 'BPM is altijd maatwerk en afhankelijk van CO₂-uitstoot, leeftijd en gekozen methode. Wij maken vóór elk bod een onderbouwde prognose met +10% buffer zodat u geen verrassingen krijgt na invoer.',
      },
      {
        q: 'Geldt er een vrijstelling voor oldtimers?',
        snippet: 'Ja. Auto\'s ouder dan 25 jaar zijn volledig BPM-vrijgesteld (100% afschrijving). Boven 40 jaar gelden ook MRB-vrijstelling, verlaagde invoerrechten via HS-9705 en milieuzone-vrijstelling.',
        a: 'Voor klassiekers vlak onder de 25-jaarsgrens loont het soms om enkele maanden te wachten — een paar maanden uitstel kan honderden tot duizenden euro\'s BPM-besparing opleveren. Per case maken wij die afweging samen met u.',
      },
    ],
  },
  {
    title: 'RDW, keuring en kentekening',
    items: [
      {
        q: 'Krijgt de auto een Nederlandse APK na aankomst?',
        snippet: 'Ja. Na douane-vrijgave organiseren wij de RDW-keuring inclusief APK en identificatie. Zonder geldig APK kan geen Nederlands kenteken worden afgegeven.',
        a: 'Voor Japanse imports zijn soms EU-compliance-aanpassingen nodig (mistlicht achter, kentekenverlichting, knipperlicht-kleur). Deze worden vooraf doorgesproken en bij onze partner-werkplaats uitgevoerd voordat de auto naar de RDW gaat.',
      },
      {
        q: 'Wat is EU-typegoedkeuring en waarom is het belangrijk?',
        snippet: 'Een EU-typegoedkeuring is een Europese certificering die geldt voor een hele serie identieke voertuigen. Voor Mercedes/BMW/Audi/Porsche uit Japan die ooit als nieuw naar Japan zijn geëxporteerd, geldt deze meestal nog.',
        a: 'In dat geval verloopt de RDW-keuring soepel. Bij specifiek Japan-geproduceerde varianten kan individuele goedkeuring nodig zijn (2-4 weken extra doorlooptijd, €300-800 extra kosten). Wij toetsen dit vóór bod per kandidaatauto.',
      },
      {
        q: 'Is een CoC-document (Certificate of Conformity) verplicht?',
        snippet: 'Niet altijd. Voor de meeste Europese premium-auto\'s vanaf 1996 is het Japanse exportcertificaat plus chassis-verificatie voldoende voor de RDW.',
        a: 'Voor specifieke uitvoeringen of bouwjaren waar de RDW twijfelt, kan een CoC bij de fabrikant worden aangevraagd (€120-€300, 2-6 weken doorlooptijd). Wij toetsen dit vooraf per kandidaatauto zodat er geen verrassingen ontstaan.',
      },
      {
        q: 'Hoe lang duurt de RDW-keuring zelf?',
        snippet: 'De keuring zelf duurt 30 tot 45 minuten op het keuringsstation. De doorlooptijd tot aan de afspraak kan 1 tot 3 weken zijn door drukte bij RDW-locaties.',
        a: 'Wij plannen indien mogelijk al vóór de aankomst van de auto, zodat het traject niet onnodig wordt vertraagd. Voor Japanse imports houden we structureel rekening met 2-5 weken voor de NL-fase (douane + BPM + RDW + kentekening).',
      },
    ],
  },
  {
    title: 'Conditie, garantie en risico\'s',
    items: [
      {
        q: 'Heeft een Japanse import nog dealergarantie?',
        snippet: 'Voor de meeste premium-merken eindigt de fabrieksgarantie op 4-6 jaar of een bepaald kilometrage. Geïmporteerde auto\'s die buiten die periode vallen hebben geen dealergarantie meer — net als een vergelijkbare tweedehands Duitse auto.',
        a: 'Voor specifieke modellen biedt Mercedes-Benz of BMW soms een verlengde garantieoptie via NL-dealers. Dit bespreken wij per geval. Voor klassiekers (>25 jaar) is dealergarantie sowieso geen factor meer.',
      },
      {
        q: 'Hoe verifiëren jullie de kilometerstand?',
        snippet: 'Drie controles parallel: de officiële Shaken-historie (verplichte 2-jaarlijkse keuring die km registreert), service-stempels in onderhoudsboekjes, en consistentie met het auction-sheet-rapport van een onafhankelijke inspecteur.',
        a: 'In Japan is kilometerfraude historisch zeldzamer dan in Europa, mede door de strikte Shaken-discipline. Bij twijfel of inconsistenties tussen bronnen: walk-away. Geen verifieerbare historie betekent geen bod.',
      },
      {
        q: 'Wat zijn de grootste risico\'s bij Japan-import?',
        snippet: 'Drie risico\'s komen het meeste voor: wisselkoersbeweging tussen bod en betaling, onverwachte BPM-uitkomst, en tegenvallende EU-compliance-aanpassingen. Wij bouwen +10% buffer in elke prognose.',
        a: 'Voor de wisselkoers hanteren wij conservatieve bid-grenzen die ±3% afdekken. Voor BPM gebruiken we altijd officiële CO₂-bron in plaats van verkooppakket-data. Voor compliance toetsen we per kandidaatauto vóór bod welke aanpassingen nodig zijn.',
      },
      {
        q: 'Past een Japanse W212 in een Nederlandse milieuzone?',
        snippet: 'Voor moderne premium-auto\'s vanaf bouwjaar 2013 (Euro 6) zijn alle Nederlandse milieuzones toegankelijk. Voor oudere uitvoeringen (Euro 5 of lager) kunnen beperkingen gelden in steden zoals Amsterdam en Rotterdam.',
        a: 'Voor klassiekers (oldtimers, 40+ jaar) gelden vaak vrijstellingen op basis van de oldtimer-regeling. Per kandidaatauto toetsen wij dit vooraf zodat u weet waar u de auto wel en niet kunt rijden.',
      },
    ],
  },
  {
    title: 'Kosten en specifieke vragen',
    items: [
      {
        q: 'Wat kost een auto importeren uit Japan all-in?',
        snippet: 'Bovenop de hammerprijs komt typisch €8.000-€10.000 aan import- en bijkomende kosten voor een W212. Daaronder vallen JCD-fees, RoRo-vracht, douane, 10% invoer, 21% BTW, BPM en RDW.',
        a: 'Specifiek: JCD auction fees + binnenlands transport (~€1.200), RoRo-zeevracht (~€1.000), douane-afhandeling (~€400), 10% invoerrechten over CIF, 21% BTW, BPM (variabel, vaak €1.150-€2.500), RDW + kentekenregistratie (~€450), EU-compliance + reconditionering (€300-€700), plus onze sourcing- en operationele fee. Zie onze voorbeeld-traject-pagina voor een complete uitwerking.',
      },
      {
        q: 'Wat is de IMS-kwestie bij oudere Porsche 911-modellen?',
        snippet: 'De Intermediate Shaft (IMS) van de M96-motor in 996 Carrera (1998-2005) en 997.1 Carrera (2004-2008) heeft een afgesloten kogellager dat tijdens de levensduur kan falen. Wij bieden niet zonder gedocumenteerde IMS-update.',
        a: 'Acceptabele updates: LN Engineering IMS Retrofit of IMS Solution. Voor 997.2 (2008+) en jonger is het IMS-issue afwezig. Voor 911 Turbo en GT3 speelt het niet — die hebben de Mezger-motor zonder IMS-probleem.',
      },
      {
        q: 'Kunnen jullie ook bieden op klassiekers uit de jaren 70/80?',
        snippet: 'Ja. Voor klassiekers boven 25 jaar (BPM-vrij) of 40 jaar (volledig vrijgesteld inclusief MRB en milieuzone) is de Japan-route vaak interessant. Het Japanse droger klimaat plus Shaken-discipline leveren vaak betere condities dan EU-equivalenten.',
        a: 'Modellen zoals Mercedes R107 SL, R129 SL, W124 Cosworth, Porsche 993, Audi UR-quattro zijn regelmatig beschikbaar. Per case maken wij een onderbouwde sourcing-strategie met aandacht voor authenticiteit, papieren en restauratie-historie.',
      },
      {
        q: 'Geen antwoord op uw vraag?',
        snippet: 'Plan een vrijblijvend intake-gesprek — online, via WhatsApp of in Welsum. Wij beantwoorden uw specifieke vraag binnen 24 uur.',
        a: 'Onze contactgegevens staan op de contactpagina. Voor specifieke vragen over een concreet model, BPM-prognose of doorlooptijd helpen we u graag persoonlijk verder.',
      },
    ],
  },
];

// Flatten voor FAQ schema — gebruik snippet + a als gecombineerde answer text
const allFaqs = faqCategories.flatMap((c) => c.items);
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: allFaqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.snippet + ' ' + f.a },
  })),
};
---

<BaseLayout
  title="FAQ — auto importeren uit Japan | Rolvink"
  description="30 veelgestelde vragen over auto importeren uit Japan: doorlooptijd, kosten, BPM, RDW, conditie-grades, LHD vs RHD, IMS-kwestie, garantie en oldtimers."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <section class="faq-page">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />

      <div class="section-eyebrow">FAQ</div>
      <h1>Auto importeren <span class="accent">uit Japan</span>.</h1>
      <p class="lead">De meest gestelde vragen over het Japan-traject — gegroepeerd in zeven thema's. Helder en eerlijk beantwoord op basis van onze ervaring met Japanse veilingen, RDW-procedures en BPM-berekening.</p>

      {faqCategories.map((cat) => (
        <div class="faq-category">
          <h2>{cat.title}</h2>
          <div class="faq-list">
            {cat.items.map((f) => (
              <details class="faq-item">
                <summary><span>{f.q}</span><span class="toggle" aria-hidden="true">+</span></summary>
                <div class="faq-answer">
                  <p class="faq-snippet">{f.snippet}</p>
                  <p>{f.a}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      ))}

      <div class="page-cta">
        <a href="/contact" class="page-cta-btn">
          Plan vrijblijvend intake-gesprek
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .faq-page { padding: 64px 0 96px; }
  .faq-page h1 { font-size: 56px; font-weight: 600; margin-bottom: 24px; line-height: 1.05; }
  .lead { font-size: 18px; color: var(--color-text-secondary); max-width: 680px; margin-bottom: 56px; line-height: 1.6; }

  .faq-category { margin-bottom: 48px; }
  .faq-category h2 { font-size: 22px; font-weight: 600; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 1px solid var(--color-border-medium); }

  .faq-list { display: flex; flex-direction: column; gap: 1px; background: var(--color-border-medium); }
  .faq-item { background: var(--color-white); }
  .faq-item summary { padding: 22px 24px; display: flex; justify-content: space-between; align-items: center; cursor: pointer; font-size: 16px; font-weight: 500; color: var(--color-text-primary); list-style: none; gap: 24px; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item .toggle { color: var(--color-copper-text); font-size: 22px; font-weight: 400; line-height: 1; transition: transform 0.2s; }
  .faq-item[open] .toggle { transform: rotate(45deg); }
  .faq-answer { padding: 0 24px 22px; }
  .faq-answer p { font-size: 15px; color: var(--color-text-secondary); line-height: 1.7; max-width: 720px; }
  .faq-answer .faq-snippet { font-size: 15.5px; color: var(--color-text-primary); font-weight: 500; padding-bottom: 14px; margin-bottom: 14px; border-bottom: 1px solid var(--color-border-light, #e8e4dd); }

  .page-cta { padding: 36px 28px; background: var(--color-charcoal-dark); color: var(--color-cream); text-align: center; }
  .page-cta-btn { display: inline-flex; align-items: center; gap: 12px; padding: 16px 28px; background: var(--color-copper-text); color: var(--color-charcoal-dark); font-size: 13px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; text-decoration: none; }

  @media (max-width: 768px) {
    .faq-page h1 { font-size: 36px; }
    .faq-category h2 { font-size: 19px; }
    .faq-item summary { font-size: 15px; padding: 18px 20px; }
  }
</style>
