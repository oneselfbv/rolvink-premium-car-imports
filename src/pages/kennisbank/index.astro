---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pillars = [
  { href: '/kennisbank/auto-importeren-japan', title: 'Auto importeren uit Japan in 2026', desc: 'Complete gids: stap-voor-stap proces, kosten, BPM, RDW, doorlooptijd en valkuilen bij het importeren uit Japan.', category: 'Proces', status: 'Nieuw' },
  { href: '/kennisbank/auto-importeren-duitsland', title: 'Auto importeren uit Duitsland in 2026', desc: 'Complete gids: stap-voor-stap proces, TÜV, BPM, RDW, kostenvoorbeeld en valkuilen bij het importeren uit Duitsland.', category: 'Proces', status: 'Nieuw' },
  { href: '/kennisbank/bpm-importauto-2026', title: 'BPM voor importauto\'s — gids 2026', desc: 'Drie methoden (forfait, koerslijst, DRZ-taxatie), CO₂-tarieven, oldtimer-regeling en voorbeelden voor één W212 doorgerekend.', category: 'Belasting', status: 'Nieuw' },
  { href: '/kennisbank/rdw-keuring-import', title: 'RDW-keuring voor import — stappenplan', desc: 'EU-typegoedkeuring, CoC, individuele goedkeuring, identificatie en doorlooptijd. Wat de RDW controleert en hoe wij het regelen.', category: 'Proces', status: 'Nieuw' },
  { href: '/kennisbank/lhd-rhd-groene-markering', title: 'LHD versus RHD bij Japanse veilingen', desc: 'Waarom links- of rechtsgestuurd cruciaal is bij Japanse imports, hoe je LHD betrouwbaar herkent op de auction sheet, en welke modellen sterk in LHD vertegenwoordigd zijn.', category: 'Markt', status: 'Nieuw' },
  { href: '/kennisbank/japanse-veiling-grades', title: 'Japanse auction grades uitgelegd', desc: 'Volledige uitleg van de 1-6/S schaal plus letter-codes. Wat wij accepteren, wat wij categorisch weigeren.', category: 'Proces', status: 'Nieuw' },
  { href: '/kennisbank/japanse-auction-sheet-lezen', title: 'Japanse auction sheet lezen — complete gids', desc: 'Anatomie van de sheet, grade-systeem, letter-codes voor schade, de RHD/LHD-mismatch valkuil, service-historie indicators en wat NIET op een sheet staat. Plus beknopte Japanse termen cheat-sheet.', category: 'Veiling-gids', status: 'Nieuw' },
  { href: '/kennisbank/porsche-911-modelgids', title: 'Porsche 911 — modelgids vijf generaties', desc: 'Van 993 tot 992: motorvarianten, IMS-vraagstuk bij 996/997.1, sweet-spots per generatie en waarom Japan dé route is voor 911-LHD.', category: 'Modelgids', status: 'Nieuw' },
  { href: '/kennisbank/porsche-ims-lager-996-997', title: 'Porsche IMS-lager 996/997 — koopgids', desc: 'Complete koopgids over het IMS-lager: welke bouwjaren risico lopen, welke 911-generaties IMS-vrij zijn (997.2 en jonger, Mezger Turbo/GT3), dual-row versus single-row versus sealed, retrofit-kits, bore-scoring en pre-purchase checks. Met onderbouwde bandbreedte voor de uitvalsstatistiek.', category: 'Modelgids', status: 'Nieuw' },
  { href: '/kennisbank/porsche-997-2-japan-vs-duitsland', title: 'Porsche 997.2 — Japan vs Duitsland cost-vergelijking', desc: 'Eén 2010 Porsche 997.2 Carrera S handbak volledig doorgerekend over beide import-routes. Hammerprijs, transport, BPM, RDW, onze fee — naast elkaar met beslislogica en doorlooptijd-vs-marge analyse.', category: 'Cost-vergelijking', status: 'Nieuw' },
  { href: '/kennisbank/audi-quattro-rs-koopgids', title: 'Audi quattro & RS — koopgids', desc: 'Eerste Audi-flagship: quattro-systemen uitgelegd (Torsen, crown-gear, Haldex, ultra), RS-modellen historie, de vier kern-motorfamilies (V8 4.2, V10 5.2, V8 4.0 TFSI biturbo, 2.5 TFSI R5), valkuilen per generatie en welke RS-uitvoeringen wij sourcen.', category: 'Modelgids', status: 'Nieuw' },
  { href: '/kennisbank/bmw-r1150gs-koopgids', title: 'BMW R 1150 GS — koopgids', desc: 'De klassieke oilhead-adventure (1999-2005): de kwetsbare Integral ABS servorem, eindaandrijving-splines, checklist en prijzen Duitsland vs Nederland.', category: 'Motor-modelgids', status: 'Nieuw' },
  { href: '/kennisbank/bmw-boxermotoren-gids', title: 'BMW boxermotoren — airhead tot ShiftCam', desc: 'De evolutie van de BMW-boxer: airhead, oilhead, hexhead, camhead, wasserboxer en ShiftCam, met zwakke punten en koopadvies per generatie.', category: 'Motorgids', status: 'Nieuw' },
  { href: '/kennisbank/bmw-r1250gs-koopgids', title: 'BMW R 1250 GS — koopgids', desc: 'ShiftCam-boxer, uitvoeringen (standaard vs Adventure), de gearbox-recall, checklist voor bod en prijzen Duitsland vs Nederland (2019-2024).', category: 'Motor-modelgids', status: 'Nieuw' },
  { href: '/kennisbank/bmw-motor-importeren-duitsland', title: 'BMW-motor importeren uit Duitsland', desc: 'Alle populaire BMW-motormodellen met Nederlandse occasionprijzen, waar het Duitse prijsvoordeel zit, de lage motor-BPM en het importproces. Live prijsscan juni 2026.', category: 'Motoren', status: 'Nieuw' },
  { href: '/kennisbank/lhd-mercedes-japan-prijspeiling-2026', title: 'LHD Mercedes uit Japan — prijspeiling 2026', desc: 'Echte veilingprijzen van linksgestuurde grade 4+ Mercedessen (E-Klasse tot G 63 AMG), afgezet tegen de Nederlandse markt, met indicatieve rijklaar-voorbeelden. Peildatum juni 2026.', category: 'Marktdata', status: 'Nieuw' },
  { href: '/kennisbank/recente-japan-realisaties', title: 'Japans LHD-aanbod per merk', desc: 'Welke linksgestuurde grade 4+ uitvoeringen structureel op de Japanse veilingen verschijnen binnen onze scope: Mercedes-Benz, Porsche, BMW en Audi. Op observatie gebaseerd, geen marketing-schatting.', category: 'Marktdata', status: 'Nieuw' },
  { href: '/kennisbank/bmw-5-serie-f10-g30', title: 'BMW 5-Serie F10/G30 — koopgids', desc: 'Motorvarianten, sweet-spots, valkuilen per generatie, typische landed cost en wat te checken op het auction sheet.', category: 'Modelgids', status: 'Nieuw' },
  { href: '/kennisbank/mercedes-e-klasse-w212', title: 'Mercedes E-Klasse W212 — koopgids', desc: 'Motorvarianten W212 (E200/E250 CGI/E300/E350/E63), valkuilen, sweet-spot uitvoeringen en landed cost Japan vs Duitsland.', category: 'Modelgids', status: 'Nieuw' },
  { href: '/kennisbank/mercedes-m112-v6-motor', title: 'Mercedes M112 V6 — motorgids', desc: 'Techniek, varianten en bekende valkuilen van de 18-klepper V6 (1997-2010) — de motor in W210/W211 E320, W203 C320, R230 SL350, W220 S320 en meer. Inclusief LPG-geschiktheid.', category: 'Motorgids', status: 'Nieuw' },
  { href: '/kennisbank/mercedes-m272-v6-motor', title: 'Mercedes M272 V6 — motorgids', desc: '24-klepper V6 (2004-2011) in W211/W212 E350, W164 ML350, W221 S350, R230 SL350 en meer. Met de cruciale balansas-cutoff (motornummer 2729 30 468993) en het verschil tussen port-injection en CGI voor LPG-conversie.', category: 'Motorgids', status: 'Nieuw' },
  { href: '/kennisbank/bmw-m54-motor', title: 'BMW M54 — motorgids', desc: 'De laatste pure atmosferische zes-in-lijn van BMW (2000-2006) in E46 330i, E39 530i, E53 X5 3.0i en Z4 3.0i. Varianten M54B22/B25/B30, bekende zwakke punten (koelsysteem, DISA, VANOS, CCV) en koopadvies.', category: 'Motorgids', status: 'Nieuw' },
  { href: '/kennisbank/bmw-n52-motor', title: 'BMW N52 — motorgids', desc: 'Opvolger van de M54 met magnesium-aluminium blok en Valvetronic (2004-2015) in E90 330i, E60 530i, E63 630i en X5 3.0si. Aandachtspunten: elektrische waterpomp, kleppendeksel en excentriekas-sensor.', category: 'Motorgids', status: 'Nieuw' },
  { href: '/kennisbank/mercedes-m113-v8-motor', title: 'Mercedes M113 V8 — motorgids', desc: 'De bulletproof V8 die in W210/W211 E500, W220 S500, W163/W164 ML500, R230 SL500, W463 G500 en alle AMG Kompressor-uitvoeringen (E55/S55/SL55/G55) zat. Taxi-bewezen op LPG.', category: 'Motorgids', status: 'Nieuw' },
];

const faqs = [
  { href: '/kennisbank/faq-japan', title: 'FAQ — Auto importeren uit Japan' },
  { href: '/kennisbank/faq-duitsland', title: 'FAQ — Auto importeren uit Duitsland' },
];
---

<BaseLayout
  title="Kennisbank — Rolvink Premium Imports"
  description="Onze research over BPM, auction grades, importprocessen en modelspecifieke koopgidsen voor Duitse premium-auto's."
>
  <section class="kennisbank-page">
    <div class="container">
      <div class="section-eyebrow">Kennisbank</div>
      <h1>Onze research,<br/>uw <span class="accent">voorbereiding</span>.</h1>
      <p class="lead">Wat wij weten over importprocessen, belastingen, modeluitvoeringen en marktontwikkelingen — gepubliceerd zodat u zelf goed onderbouwd kunt beslissen.</p>

      <h2>Uitgebreide gidsen</h2>
      <div class="pillar-grid">
        {pillars.map((p) => (
          <a href={p.href} class="pillar-card">
            <div class="pillar-meta">
              <span class="pillar-cat">{p.category}</span>
              <span class="pillar-status">{p.status}</span>
            </div>
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
            <span class="pillar-cta">Lees meer →</span>
          </a>
        ))}
      </div>

      <h2 style="margin-top: 80px;">Veelgestelde vragen</h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <a href={f.href} class="faq-link">
            <span>{f.title}</span>
            <span class="arrow">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .kennisbank-page { padding: 80px 0 80px; }
  .kennisbank-page h1 { font-size: 64px; font-weight: 600; margin-bottom: 24px; line-height: 1.05; }
  .kennisbank-page h2 { font-size: 32px; font-weight: 600; margin-bottom: 32px; }
  .lead { font-size: 18px; color: var(--color-text-secondary); max-width: 640px; margin-bottom: 64px; line-height: 1.6; }
  .pillar-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .pillar-card { background: var(--color-white); padding: 32px 28px; border-left: 3px solid var(--color-copper-text); text-decoration: none; color: inherit; transition: transform 0.2s; }
  .pillar-card:hover { transform: translateY(-2px); }
  .pillar-meta { display: flex; justify-content: space-between; margin-bottom: 16px; }
  .pillar-cat { font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-copper-text); font-weight: 600; }
  .pillar-status { font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-tertiary); }
  .pillar-card h3 { font-size: 20px; font-weight: 600; margin-bottom: 12px; }
  .pillar-card p { font-size: 14px; color: var(--color-text-secondary); line-height: 1.55; margin-bottom: 16px; }
  .pillar-cta { font-size: 13px; color: var(--color-copper-text); font-weight: 500; }
  .faq-list { display: flex; flex-direction: column; gap: 1px; background: var(--color-border-medium); }
  .faq-link { background: var(--color-white); padding: 20px 24px; display: flex; justify-content: space-between; align-items: center; text-decoration: none; color: var(--color-text-primary); font-size: 17px; font-weight: 500; transition: background 0.2s; }
  .faq-link:hover { background: var(--color-cream-warm); }
  .faq-link .arrow { color: var(--color-copper-text); }

  @media (max-width: 768px) {
    .kennisbank-page h1 { font-size: 40px; }
    .pillar-grid { grid-template-columns: 1fr; }
  }
</style>
