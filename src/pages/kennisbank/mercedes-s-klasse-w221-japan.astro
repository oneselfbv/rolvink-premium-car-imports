const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: [
  { '@type': 'Question', name: 'Waarom een W221 S-Klasse uit Japan importeren?', acceptedAnswer: { '@type': 'Answer', text: 'Japanse S-Klassen worden doorgaans zorgvuldig onderhouden, hebben lage kilometerstanden en kennen door het klimaat en het ontbreken van wegenzout vrijwel geen corrosie aan de onderkant. Voor een flagship-limousine, waar juist onderhoud en staat de waarde bepalen, is dat een sterk argument. Wel is het linksgestuurde (LHD) aanbod in Japan een minderheid, dus geduld en gerichte screening zijn nodig.' } },
  { '@type': 'Question', name: 'Betaal ik BPM bij import van een W221?', acceptedAnswer: { '@type': 'Answer', text: 'Ja. De W221 (2005-2013) is nog geen 25 jaar oud, dus de BPM geldt. De hoogte hangt af van CO2-uitstoot en leeftijd: door de leeftijdsafschrijving valt het op oudere exemplaren mee, maar voor de V8 (S500) en zeker de V12 (S600) kan de BPM flink oplopen. Wij rekenen de BPM per exemplaar vooraf onderbouwd door.' } },
  { '@type': 'Question', name: 'Wat is het grootste aandachtspunt bij een W221?', acceptedAnswer: { '@type': 'Answer', text: 'Het Airmatic-luchtveersysteem: veerpoten kunnen gaan lekken en de compressor slijt. Controleer of de wagen op alle hoeken netjes op hoogte komt en blijft. Bij de vroege M272 V6 (S350) geldt daarnaast de bekende balansas-kwestie binnen een specifiek motornummerbereik; onze M272-motorgids legt dat uit.' } },
