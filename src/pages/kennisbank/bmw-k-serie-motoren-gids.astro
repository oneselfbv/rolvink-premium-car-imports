const articleSchema = { '@context': 'https://schema.org', '@type': 'Article', headline: 'BMW K-serie motoren — van flying brick tot zescilinder', description: 'De BMW K-serie: de liggende flying brick (K100/K1100), de transversale viercilinder (K1200/K1300) en de zescilinder K1600 — met de zwakke punten per type.', datePublished: publishedDate, dateModified: updatedDate, author: { '@type': 'Person', name: 'Theo Rolvink', url: 'https://www.rolvinkpremiumcarimports.nl/over/' }, publisher: { '@type': 'Organization', name: 'Rolvink Premium Imports', logo: { '@type': 'ImageObject', url: 'https://www.rolvinkpremiumcarimports.nl/favicon.svg' } }, mainEntityOfPage: { '@type': 'WebPage', '@id': 'https://www.rolvinkpremiumcarimports.nl/kennisbank/bmw-k-serie-motoren-gids/' }, image: 'https://www.rolvinkpremiumcarimports.nl/og-image.jpg' };
