const publishedDate = '2026-07-15'; const updatedDate = '2026-07-15';
const articleSchema = { '@context': 'https://schema.org', '@type': 'Article', headline: 'BMW R 100 GS kopen & importeren uit Duitsland (2026)', description: 'Alles over de R 100 GS en R 100 GS Paris-Dakar: Paralever-techniek, Monolever versus Paralever, zwakke punten, checklist, Nederlandse prijzen en waarom Duitsland het ruimste aanbod heeft.', datePublished: publishedDate, dateModified: updatedDate, author: { '@type': 'Person', name: 'Theo Rolvink', url: 'https://www.rolvinkpremiumcarimports.nl/over/' }, publisher: { '@type': 'Organization', name: 'Rolvink Premium Imports', logo: { '@type': 'ImageObject', url: 'https://www.rolvinkpremiumcarimports.nl/favicon.svg' } }, mainEntityOfPage: { '@type': 'WebPage', '@id': 'https://www.rolvinkpremiumcarimports.nl/kennisbank/bmw-r100gs-importeren/' }, image: 'https://www.rolvinkpremiumcarimports.nl/og-image.jpg' };
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: [
  { '@type': 'Question', name: 'Wat kost een goede BMW R 100 GS in Nederland?', acceptedAnswer: { '@type': 'Answer', text: 'Een net, rijklaar exemplaar met historie ligt in Nederland indicatief rond de €6.000 tot €7.500; de gezochte R 100 GS Paris-Dakar zit aan de bovenkant daarvan of hoger. Projecten en incomplete motoren zijn goedkoper, maar restauratiekosten lopen bij een airhead snel op. Prijzen indicatief, juli 2026.' } },
  { '@type': 'Question', name: 'Betaal ik BPM als ik een R 100 GS importeer?', acceptedAnswer: { '@type': 'Answer', text: 'Nee. De R 100 GS werd gebouwd van 1987 tot 1996 en is dus ruim ouder dan 25 jaar; op die leeftijd is de motor-BPM nihil. Je betaalt bij invoer uit Duitsland (EU) geen invoerrechten of BTW voor een gebruikte motor — alleen de RDW-keuring en kentekenregistratie.' } },
  { '@type': 'Question', name: 'Wat is het verschil tussen de Monolever en de Paralever R 100 GS?', acceptedAnswer: { '@type': 'Answer', text: 'De R 100 GS was in 1987 de eerste BMW met Paralever: een dubbelzijdige achterbrug met extra momentsteun die het opveren onder gas (de cardanreactie) sterk vermindert. De naam Monolever hoort bij de voorganger R 80 G/S. Alle R 100 GS-en hebben Paralever; let bij aankoop wel op de staat van de kruiskoppeling en de rubber balg van de cardan.' } },
  { '@type': 'Question', name: 'Waar moet ik specifiek op letten bij een R 100 GS?', acceptedAnswer: { '@type': 'Answer', text: 'De cross-spaak tubeless velgen (scheurtjes rond de spaaknippels), de Paralever-cardan en kruiskoppeling, het oliefilterhuis-gebied, de laadspanning (diodeplaat) en originaliteit van de Paris-Dakar-onderdelen (grote tank, zadels, beugels worden vaak nagemaakt). Verder is het een onverwoestbare, volledig restaureerbare motor.' } } ] };
---
<BaseLayout title="BMW R 100 GS kopen & importeren uit Duitsland 2026 | Rolvink" description="De R 100 GS en Paris-Dakar: Paralever-techniek, zwakke punten, checklist voor bod, Nederlandse prijzen en waarom Duitsland het ruimste aanbod heeft. BPM nihil op deze leeftijd.">
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <article class="cornerstone-page"><div class="container">
    <Breadcrumbs items={breadcrumbs} />
    <header class="article-header">
      <div class="section-eyebrow">Motor-modelgids</div>
      <h1>BMW R 100 GS — <span class="accent">kopen &amp; importeren</span>.</h1>
      <p class="lead">De laatste grote luchtgekoelde GS-boxer en de motor die de klassieke reisenduro definieerde. Iconisch, onverwoestbaar en in Nederland structureel gewild — maar het ruimste en vaak gunstigst geprijsde aanbod staat in Duitsland. Dit is waar je op let, wat het kost en hoe de import werkt.</p>
      <div class="article-meta"><span>Gepubliceerd: 15 juli 2026</span><span>·</span><span>Leestijd: ongeveer 8 minuten</span></div>
    </header>
    <AuthorByline variant="top" />
    <div class="disclaimer"><strong>Modelinformatie is observatie, geen technisch advies.</strong> Samengesteld uit openbare bronnen (airhead-specialisten, eigenaarsverenigingen) en eigen ervaring. Bij een klassieker van 30+ jaar verschilt de staat enorm per exemplaar; laat een twijfelgeval altijd door een airhead-specialist beoordelen. Prijzen indicatief (juli 2026).</div>
    <nav class="toc"><h2>In deze gids</h2><ol>
      <li><a href="#overzicht">De R 100 GS in het kort</a></li>
      <li><a href="#varianten">Varianten &amp; de Paris-Dakar</a></li>
      <li><a href="#techniek">Paralever &amp; techniek</a></li>
      <li><a href="#aandacht">Zwakke punten &amp; aandachtspunten</a></li>
      <li><a href="#checken">Checklist voor het bod</a></li>
      <li><a href="#prijzen">Prijzen Nederland &amp; waarom Duitsland</a></li>
      <li><a href="#import">Import, BPM &amp; kenteken</a></li>
      <li><a href="#faq">Veelgestelde vragen</a></li>
    </ol></nav>
    <section id="overzicht" class="content-section"><h2>De R 100 GS in het kort</h2>
      <p>De R 100 GS (1987-1996) is de grote broer van de originele R 80 G/S en voor veel liefhebbers dé klassieke BMW-reisenduro. Onder het plaatwerk zit de bekende luchtgekoelde 980 cc boxer (type 247, de "airhead") met zo'n 60 pk: eenvoudig, robuust en vrijwel volledig zelf te onderhouden. Wat de R 100 GS bijzonder maakt is de combinatie van dat onverwoestbare blok met de toen splinternieuwe Paralever-achterbrug en de karakteristieke cross-spaak tubeless velgen. Het resultaat is een motor die dertig jaar later nog steeds dagelijks gereden, gerestaureerd en over de hele wereld gezocht wordt.</p></section>
    <section id="varianten" class="content-section"><h2>Varianten &amp; de Paris-Dakar</h2>
      <ul class="bullet-list">
        <li><strong>R 100 GS (1987-1996).</strong> De standaarduitvoering met 24-liter tank. De basis waarop alles hieronder voortbouwt.</li>
        <li><strong>R 100 GS Paris-Dakar.</strong> De gezochte uitvoering met grote 35-liter tank, groter zadel, motorbeugels en vaak een bagagerek — een eerbetoon aan de Dakar-successen van de G/S. Duidelijk meer waard dan de standaard, maar let op nagemaakte PD-onderdelen (zie checklist).</li>
        <li><strong>Facelift 1991.</strong> Vanaf model 1991 kreeg de lijn onder meer een aangepaste voorkant en detailwijzigingen; de latere exemplaren gelden als de meest verfijnde R 100 GS.</li>
        <li><strong>R 80 GS (1987-1996).</strong> De 800 cc-zuster: zachter, iets lichter en goedkoper, met exact dezelfde Paralever-basis. Een prima instap als de R 100 GS-prijzen te hoog oplopen.</li>
      </ul></section>
    <section id="techniek" class="content-section"><h2>Paralever &amp; techniek</h2>
      <p>De R 100 GS was in 1987 de <strong>eerste productie-BMW met Paralever</strong>: een dubbelzijdige achterbrug met een extra momentsteun die de cardanreactie — het opveren van de achterkant als je gas geeft of dichtknijpt — grotendeels wegneemt. Dat maakt de motor op de weg merkbaar rustiger dan de oudere Monolever- en swingarm-boxers. Gecombineerd met de tubeless cross-spaakwielen en lange veerweg was de R 100 GS voor zijn tijd een verrassend capabele reis- en terreinmotor.</p>
      <p>Het blok zelf is klassieke airhead-techniek: twee kleppen per cilinder, eenvoudige Bing-carburateurs, schachtaandrijving en een luchtgekoelde boxer die met normaal gereedschap onderhouden kan worden. Juist die eenvoud maakt de motor zo geliefd — er is vrijwel niets aan dat een handige eigenaar of airhead-specialist niet kan herstellen.</p></section>
    <section id="aandacht" class="content-section"><h2>Zwakke punten &amp; aandachtspunten</h2>
      <ul class="bullet-list">
        <li><strong>Cross-spaak velgen.</strong> De tubeless velgen kunnen op leeftijd haarscheurtjes vertonen rond de spaaknippels — controleer beide velgen zorgvuldig, vervanging is prijzig.</li>
        <li><strong>Paralever-cardan &amp; kruiskoppeling.</strong> Controleer op speling en op de staat van de rubber balg; een verwaarloosde kruiskoppeling of eindaandrijving is een kostenpost.</li>
        <li><strong>Oliefilterhuis-gebied.</strong> Het bekendste airhead-probleemgebied — check op lekkage en eerdere reparaties.</li>
        <li><strong>Laadsysteem.</strong> Diodeplaat en laadcircuit zijn op leeftijd een aandachtspunt; meet de laadspanning.</li>
        <li><strong>ZDDP-olie.</strong> Airheads hebben olie met voldoende ZDDP nodig tegen nokkenas- en klepstoterslijtage; vraag welke olie gereden is.</li>
        <li><strong>Nagemaakte Paris-Dakar-onderdelen.</strong> Grote tank, zadels en beugels worden veel gerepliceerd. Voor de PD-meerprijs wil je originele, matchende onderdelen en liefst documentatie.</li>
      </ul></section>
    <section id="checken" class="content-section"><h2>Checklist voor het bod</h2>
      <ul class="bullet-list">
        <li>Beide cross-spaak velgen vrij van scheurtjes rond de nippels.</li>
        <li>Paralever-cardan zonder speling, balg heel, eindaandrijving droog.</li>
        <li>Oliefilterhuis-gebied droog; laadspanning, compressie en koude start in orde (geen ratelen/tikken).</li>
        <li>Bij een Paris-Dakar: originaliteit van tank, zadel en beugels — geen replica tegen PD-prijs.</li>
        <li>Documentatie, historie, matching numbers en de kwaliteit van eerdere restauraties (wie, wanneer).</li>
      </ul></section>
    <section id="prijzen" class="content-section"><h2>Prijzen Nederland &amp; waarom Duitsland</h2>
      <table class="cost-table"><thead><tr><th>Uitvoering</th><th>Nederlands prijsniveau (indicatief)</th></tr></thead><tbody>
        <tr><td>R 100 GS (net, rijklaar, met historie)</td><td>€6.000 – €7.500</td></tr>
        <tr><td>R 100 GS Paris-Dakar (origineel)</td><td>bovenkant van die band en hoger</td></tr>
        <tr><td>Project / incompleet</td><td>lager, maar reken restauratiekosten mee</td></tr>
        <tr><td>Duitsland</td><td>ruimer aanbod, vaak gunstiger geprijsd</td></tr>
      </tbody></table>
      <p>De R 100 GS is in Nederland structureel gewild: nette, eerlijk geprijsde exemplaren zijn snel weg, terwijl te duur geprijsde motoren juist lang blijven staan. Het aanbod hier is echter dun. In Duitsland is de vijver veel groter — meer keuze in uitvoering, kleur en staat, en gemiddeld scherper geprijsd. Dat prijs- en aanbodverschil is precies waarom import voor dit model interessant is: je vindt sneller het juiste exemplaar, tegen een betere basis. Prijzen schommelen en kopers zijn prijsbewuster dan tijdens de klassiekerpiek van 2021-2022, maar voor een echt goede R 100 GS met historie blijft de vraag hoog.</p></section>
    <section id="import" class="content-section"><h2>Import, BPM &amp; kenteken</h2>
      <p>Een motor uit Duitsland halen is intra-EU en daarmee eenvoudig: <strong>geen invoerrechten en geen BTW</strong> op een gebruikte motor, en omdat elke R 100 GS ruim ouder is dan 25 jaar is de <strong>motor-BPM nihil</strong>. Wat overblijft is de RDW-keuring, de identificatie en de kentekenregistratie. Wij regelen dat hele traject: beoordeling ter plaatse in Duitsland op precies de punten uit deze gids, verzekerd transport op onze eigen motortrailer, en een eerlijke rijklaar-prijs vooraf — geen verrassingen achteraf. Hoe motor-BPM precies werkt lees je in onze <a href="/kennisbank/motor-bpm-importeren">gids over BPM bij motorimport</a>; het bredere proces staat in <a href="/kennisbank/bmw-motor-importeren-duitsland">BMW-motor importeren uit Duitsland</a>.</p></section>
    <section id="faq" class="content-section"><h2>Veelgestelde vragen</h2>
      <h3>Wat kost een goede BMW R 100 GS in Nederland?</h3><p>Een net, rijklaar exemplaar met historie ligt indicatief rond de €6.000 tot €7.500; de gezochte Paris-Dakar zit aan de bovenkant daarvan of hoger. Projecten zijn goedkoper, maar restauratiekosten lopen bij een airhead snel op. Indicatief, juli 2026.</p>
      <h3>Betaal ik BPM als ik een R 100 GS importeer?</h3><p>Nee. De R 100 GS is ruim ouder dan 25 jaar, dus de motor-BPM is nihil. Bij invoer uit Duitsland betaal je geen invoerrechten of BTW voor een gebruikte motor — alleen RDW-keuring en kentekenregistratie.</p>
      <h3>Wat is het verschil tussen de Monolever en de Paralever R 100 GS?</h3><p>Alle R 100 GS-en hebben Paralever; de R 100 GS was in 1987 juist de eerste BMW ermee. De term Monolever hoort bij de voorganger R 80 G/S. Let bij aankoop wel op de staat van de kruiskoppeling en de rubber balg van de cardan.</p>
      <h3>Waar moet ik specifiek op letten bij een R 100 GS?</h3><p>De cross-spaak tubeless velgen (scheurtjes rond de nippels), de Paralever-cardan, het oliefilterhuis-gebied, de laadspanning en de originaliteit van Paris-Dakar-onderdelen. Verder is het een onverwoestbare, volledig restaureerbare motor.</p></section>
    <div class="page-cta"><h2>Op zoek naar een R 100 GS?</h2><p>Een goede R 100 GS kopen draait om velgen, cardan en originaliteit — en om het juiste exemplaar vinden in het ruime Duitse aanbod. Wij beoordelen precies die punten ter plaatse en regelen het hele importtraject met een eerlijke rijklaar-prijs vooraf.</p><a href="/contact" class="page-cta-btn">Plan intake-gesprek<span class="arrow" aria-hidden="true">&rarr;</span></a><p class="page-cta-note">Binnen 24 uur reactie · Geen verkoopdruk</p></div>
    <div class="related"><h3>Verder lezen</h3><ul>
      <li><a href="/kennisbank/bmw-r80-r100-airhead-koopgids">BMW R 80 / R 100 airhead — brede koopgids</a></li>
      <li><a href="/kennisbank/bmw-boxermotoren-gids">BMW boxermotoren — van airhead tot ShiftCam</a></li>
      <li><a href="/kennisbank/bmw-motor-importeren-duitsland">BMW-motor importeren uit Duitsland</a></li>
      <li><a href="/kennisbank/motor-bpm-importeren">BPM bij motorimport — zo werkt het</a></li>
    </ul></div>
  </div></article>
</BaseLayout>
