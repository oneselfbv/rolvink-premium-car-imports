---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AuthorByline from '../../components/AuthorByline.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Kennisbank', url: '/kennisbank' },
  { name: 'Japanse veiling-grades' },
];

const publishedDate = '2026-05-27';
const updatedDate = '2026-05-27';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Japanse auction grades uitgelegd — wat betekent grade 4, 4.5 en 5?',
  description: 'Volledige uitleg van de Japanse auction-grade-schaal: van 1 tot 6/S plus letter-codes. Wat de scores betekenen, wat wij accepteren en wat we categorisch weigeren.',
  datePublished: publishedDate,
  dateModified: updatedDate,
  author: {
    '@type': 'Person',
    name: 'Theo Rolvink',
    url: 'https://www.rolvinkpremiumcarimports.nl/over/',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Rolvink Premium Car Imports',
    logo: {
      '@type': 'ImageObject',
      url: 'https://www.rolvinkpremiumcarimports.nl/favicon.svg',
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': 'https://www.rolvinkpremiumcarimports.nl/kennisbank/japanse-veiling-grades/',
  },
  image: 'https://www.rolvinkpremiumcarimports.nl/og-image.jpg',
};

const accepted = [
  { num: '6', title: 'Showroom-staat / S', body: 'Vrijwel nieuwe staat, soms als showroom-/demonstratiewagen aangeboden. Onder de 10.000 km, zonder enige gebruikssporen. Komt zelden voor in oudere bouwjaren. Wordt door sommige veilinghuizen aangeduid als grade S in plaats van 6.' },
  { num: '5', title: 'Vrijwel nieuwstaat', body: 'Minder dan 30.000 km. Geen krassen of deuken. Volledig originele staat. Interieur als nieuw. Service-historie zonder uitzondering compleet. Zeer zeldzaam in oudere bouwjaren.' },
  { num: '4.5', title: 'Uitstekende staat', body: 'Onder 100.000 km. Slechts minimale gebruikssporen. Geen reparatie-historie. Interieur in zeer goede staat. Volledige service-historie. Onze voorkeurs-grade voor zeldzame uitvoeringen.' },
  { num: '4', title: 'Goede staat', body: 'Normale gebruikssporen passend bij km-stand en bouwjaar. Geen bekende schade- of herstelhistorie. Eventueel lichte stenen op voorkant of kleine parkeer-tikjes. Volledig functioneel, mechanisch in orde.' },
];

const rejected = [
  { num: '3.5', title: 'Gemiddelde staat', body: 'Zichtbare gebruikssporen, deuken of krassen. Mogelijk minor reparaties nodig. Niet onbruikbaar, maar te risicovol voor onze klant — vaak verborgen issues die pas thuis blijken.' },
  { num: '3', title: 'Onder gemiddeld', body: 'Duidelijke schade of significante gebruikssporen. Lakwerk inferieur. Onderhoudshistorie incompleet. Geschikt voor opknappers, niet voor wie een goede daily wil rijden.' },
  { num: '2', title: 'Slechte staat', body: 'Aanzienlijke schade, grote roest of onderhoudsachterstand. Strikt voor doe-het-zelvers of parts donors. Niet voor onze klanten.' },
  { num: '1', title: 'Zeer slecht / sloop', body: 'Total loss of nagenoeg onbruikbaar. Wordt vaak voor onderdelen aangeboden. Niet relevant voor onze service.' },
];

const letterCodes = [
  { code: 'R', meaning: 'Grote reparatie geregistreerd — vaak chassis-schade of significante carrosseriereparatie. Zelfs als de auto er kosmetisch goed uitziet, is de structurele integriteit aangetast.' },
  { code: 'RA', meaning: 'Lichte reparatie — bv. kleine deuken hersteld, lakwerk bijgewerkt. Minder ingrijpend dan R, maar nog steeds een rode vlag voor onze service.' },
  { code: 'A', meaning: 'Aanvullende notitie op het sheet — bijvoorbeeld over interieur-conditie, banden, of bekende issues. Geen automatische afwijzing, maar wel grondige duiding nodig.' },
  { code: 'X', meaning: 'Voertuig is niet onafhankelijk geïnspecteerd, of de inspectie was onvolledig. Onverkoopbaar voor onze service zonder volledige pre-bid inspectie.' },
  { code: 'XX', meaning: 'Voertuig is total loss verklaard of zwaar beschadigd. Geen scenario waarin wij dit aanraken.' },
];
---

<BaseLayout
  title="Japanse auction grades uitgelegd | Rolvink"
  description="Volledige uitleg van de Japanse auction-grade-schaal: van 1 tot 6/S plus letter-codes. Wat de scores betekenen en welke grades wij wel of niet sourcen."
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} slot="head" />

  <article class="cornerstone-page">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />

      <header class="article-header">
        <div class="section-eyebrow">Proces</div>
        <h1>Japanse auction <span class="accent">grades</span> uitgelegd.</h1>
        <p class="lead">Hoe Japanse veilinghuizen de conditie van een auto beoordelen, wat de scores van 1 tot 6/S inhouden, en welke letter-codes een directe rode vlag zijn. Onze acceptatiegrens en waarom we daar consequent aan vasthouden.</p>
        <div class="article-meta">
          <span>Gepubliceerd: 27 mei 2026</span>
          <span>·</span>
          {publishedDate !== updatedDate && (
            <>
              <span>Bijgewerkt: {new Date(updatedDate).toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
              <span>·</span>
            </>
          )}
          <span>Leestijd: ongeveer 6 minuten</span>
        </div>
      </header>

      <AuthorByline variant="top" />

      <section class="content-section">
        <h2>Hoe het systeem werkt</h2>
        <p>Bijna alle gebruikte auto's in Japan wisselen van eigenaar via veilingen. De drie grootste netwerken zijn <strong>USS</strong>, <strong>JU</strong> en <strong>JAA</strong>, met regionale veilinghuizen zoals CAA, ARAI en ZIP onder de motorkap. Elk voertuig krijgt voorafgaand aan de veiling een gestandaardiseerd <strong>auction sheet</strong> — een onafhankelijk inspectierapport opgesteld door een keurmeester, niet door de verkoper.</p>
        <p>Op dit sheet staat een conditie-grade van 1 tot 6 (of S), met halve stappen voor 3.5 en 4.5. Daarnaast bestaan letter-codes voor afwijkingen: R, RA, A, X, XX. Voor een serieuze import is de grade-interpretatie cruciaal — een sheet correct lezen scheelt het verschil tussen een degelijke daily en een verborgen probleem.</p>
        <p>Wij sourcen uitsluitend grade <strong>4 of hoger, zonder R/RA/A/X/XX-codes</strong>. Hieronder de complete schaal met onze acceptatie-criteria.</p>
      </section>

      <section class="content-section">
        <h2>Wat wij sourcen — grade 4, 4.5, 5, 6/S</h2>
        <div class="grades-grid">
          {accepted.map((g) => (
            <article class="grade-card accepted">
              <span class="grade-tag ok">Wij sourcen</span>
              <div class="grade-num">{g.num}</div>
              <h3>{g.title}</h3>
              <p>{g.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="content-section">
        <h2>Wat wij weigeren — grade 3.5 en lager</h2>
        <div class="grades-grid">
          {rejected.map((g) => (
            <article class="grade-card rejected">
              <span class="grade-tag no">Wij weigeren</span>
              <div class="grade-num">{g.num}</div>
              <h3>{g.title}</h3>
              <p>{g.body}</p>
            </article>
          ))}
        </div>
        <p class="reasoning">Onder grade 4 nemen de risico's op verborgen issues exponentieel toe. Een grade 3.5 lijkt kosmetisch nog acceptabel, maar verbergt vaak elektronica-issues, lakwerk-correcties of subtiele schade-historie die pas thuis blijkt. Wij doen daar niet aan mee.</p>
      </section>

      <section class="content-section">
        <h2>Letter-codes — directe rode vlaggen</h2>
        <p>Naast het numerieke grade kan een auction sheet één of meer letter-codes bevatten. Deze codes overschrijven het numerieke grade voor onze acceptatie: een grade-4 auto met R-flag wordt niet door ons gesourced.</p>
        <table class="codes-table">
          <thead>
            <tr><th>Code</th><th>Betekenis</th></tr>
          </thead>
          <tbody>
            {letterCodes.map((c) => (
              <tr>
                <td><strong>{c.code}</strong></td>
                <td>{c.meaning}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>

      <section class="content-section">
        <h2>Waarom geen compromis op grade?</h2>
        <p>De Japanse veiling-grade is een van de meest betrouwbare conditie-indicatoren in de wereldwijde gebruikte-auto-handel. Inspecteurs werken volgens gestandaardiseerde protocollen, ze zijn onafhankelijk van de verkoper, en hun reputatie binnen het netwerk staat of valt bij de accuratesse van hun werk.</p>
        <p>Dat maakt grade 4 de natuurlijke ondergrens voor wat een liefhebbersauto kan zijn: normaal gebruik, geen bekende schade- of herstelhistorie, mechanisch in orde. Onder die grens bewegen we ons in opknapper-territorium — een ander spel met andere klantverwachtingen, en niet wat wij leveren.</p>
        <p>Voor klassiekers (>25 jaar) hanteren wij dezelfde grens, alhoewel de definitie van "normale gebruikssporen" daar realistischer is. Een 25-jaar oude Mercedes R107 met enkele kleine deuken kan goed in een grade 4 vallen — wat past bij de leeftijd.</p>
      </section>

      <section class="content-section">
        <h2>Onze werkwijze met grades</h2>
        <ol class="step-list">
          <li>
            <h3>1. Auction sheet vertaling</h3>
            <p>Voor elke kandidaat-auto vertalen wij het volledige auction sheet inclusief alle Japanse notities. Veel inspecteurs schrijven kleine opmerkingen handgeschreven; die nuances bevatten vaak meer informatie dan het numerieke grade alleen.</p>
          </li>
          <li>
            <h3>2. Pre-bid inspectierapport waar nodig</h3>
            <p>Voor zeldzame uitvoeringen of borderline-cases vragen wij een aanvullend pre-bid inspectierapport aan via onze Japanse agent. Kost €80-€150 maar voorkomt dure verrassingen.</p>
          </li>
          <li>
            <h3>3. Foto-analyse</h3>
            <p>Veiling-foto's worden door ons karakter voor karakter bekeken — vooral op subtiele tekenen van lakwerk-reparaties, deuk-correcties, verschillende panel-fitments. Met ervaring herken je veel.</p>
          </li>
          <li>
            <h3>4. Walk-away bij twijfel</h3>
            <p>Bij elke twijfel: walk-away. De volgende veiling is meestal binnen één tot twee weken. Eén dag wachten is altijd goedkoper dan een verkeerd gekochte auto.</p>
          </li>
        </ol>
      </section>

      <AuthorByline variant="bottom" />

      <div class="page-cta">
        <h2>Vragen over een specifiek auction sheet?</h2>
        <p>Stuur ons een veilingaanbieding — wij geven u onze interpretatie binnen 24 uur.</p>
        <a href="/contact" class="page-cta-btn">
          Plan intake-gesprek
          <span class="arrow" aria-hidden="true">→</span>
        </a>
        <p class="page-cta-note">Binnen 24 uur reactie · Geen verkoopdruk</p>
      </div>

      <div class="related">
        <h3>Verder lezen</h3>
        <ul>
          <li><a href="/kennisbank/auto-importeren-japan">Auto importeren uit Japan — complete gids</a></li>
          <li><a href="/kennisbank/bpm-importauto-2026">BPM voor importauto's — gids 2026</a></li>
          <li><a href="/bron/japan">Sourcing uit Japan — wat we typisch sourcen</a></li>
          <li><a href="/kennisbank/faq-japan">FAQ — Auto importeren uit Japan</a></li>
        </ul>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .cornerstone-page { padding: 64px 0 96px; }
  .article-header { max-width: 760px; margin-bottom: 48px; }
  .cornerstone-page h1 { font-size: 56px; font-weight: 600; margin-bottom: 24px; line-height: 1.05; }
  .lead { font-size: 19px; color: var(--color-text-secondary); margin-bottom: 16px; line-height: 1.65; }
  .article-meta { font-size: 13px; color: var(--color-text-tertiary); display: flex; gap: 8px; }

  .content-section { max-width: 920px; margin-bottom: 56px; }
  .content-section h2 { font-size: 32px; font-weight: 600; margin-bottom: 20px; line-height: 1.15; }
  .content-section h3 { font-size: 18px; font-weight: 600; margin-bottom: 6px; }
  .content-section p { font-size: 16px; color: var(--color-text-secondary); line-height: 1.7; margin-bottom: 16px; max-width: 760px; }
  .content-section a { color: var(--color-copper-text); text-decoration: underline; }
  .content-section strong { color: var(--color-text-primary); font-weight: 600; }

  .grades-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; margin-bottom: 24px; }
  .grade-card { background: var(--color-cream); padding: 28px 28px; border-left: 3px solid var(--color-copper-text); }
  .grade-card.accepted { border-left-color: #1F4F30; }
  .grade-card.rejected { border-left-color: #722F37; opacity: 0.9; }
  .grade-tag { display: inline-block; padding: 4px 12px; background: var(--color-white); font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase; margin-bottom: 14px; font-weight: 500; }
  .grade-tag.ok { color: #1F4F30; }
  .grade-tag.no { color: #722F37; }
  .grade-num { font-family: var(--font-serif); font-size: 40px; font-weight: 500; color: var(--color-charcoal-dark); margin-bottom: 6px; line-height: 1; }
  .grade-card h3 { font-family: var(--font-display); font-size: 17px; font-weight: 600; margin-bottom: 10px; letter-spacing: -0.01em; }
  .grade-card p { font-size: 13px; color: var(--color-text-secondary); line-height: 1.55; margin-bottom: 0; max-width: none; }

  .reasoning {
    margin-top: 20px;
    padding: 14px 18px;
    background: var(--color-cream-warm);
    border-left: 2px solid var(--color-copper-text);
    font-size: 14px !important;
    color: var(--color-text-tertiary) !important;
  }

  .codes-table { width: 100%; border-collapse: collapse; margin-bottom: 16px; font-size: 14px; max-width: 760px; }
  .codes-table th { background: var(--color-charcoal-dark); color: var(--color-cream); padding: 12px 14px; text-align: left; font-weight: 600; font-size: 13px; letter-spacing: 0.05em; }
  .codes-table td { padding: 12px 14px; border-bottom: 1px solid var(--color-border-soft); }
  .codes-table tbody td:first-child { width: 80px; font-family: var(--font-display); font-size: 16px; }

  .step-list { padding-left: 0; list-style: none; max-width: 760px; }
  .step-list li { padding: 20px 0; border-bottom: 1px solid var(--color-border-soft); }
  .step-list li:last-child { border-bottom: none; }

  .page-cta { margin-top: 80px; padding: 56px 40px; background: var(--color-charcoal-dark); color: var(--color-cream); text-align: center; }
  .page-cta h2 { color: var(--color-cream); font-size: 32px; margin-bottom: 12px; }
  .page-cta p { color: rgba(245, 241, 234, 0.85); margin-bottom: 24px; font-size: 16px; }
  .page-cta-btn { display: inline-flex; align-items: center; gap: 12px; padding: 18px 36px; background: var(--color-copper-text); color: var(--color-charcoal-dark); font-size: 14px; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; text-decoration: none; transition: transform 0.2s, background 0.2s; }
  .page-cta-btn:hover { transform: translateY(-2px); background: #d18a3f; }
  .page-cta-btn .arrow { font-size: 18px; }
  .page-cta-note { margin-top: 16px; font-size: 12px; color: rgba(245, 241, 234, 0.6); }

  .related { max-width: 760px; margin-top: 64px; padding-top: 32px; border-top: 1px solid var(--color-border-medium); }
  .related h3 { font-size: 14px; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-copper-text); margin-bottom: 16px; }
  .related ul { list-style: none; padding: 0; }
  .related li { padding: 8px 0; }
  .related a { color: var(--color-text-primary); text-decoration: none; font-size: 16px; transition: color 0.2s; }
  .related a:hover { color: var(--color-copper-text); }

  @media (max-width: 768px) {
    .cornerstone-page h1 { font-size: 36px; }
    .content-section h2 { font-size: 24px; }
    .grades-grid { grid-template-columns: 1fr; }
    .page-cta { padding: 36px 24px; }
  }

  /* Verder-lezen links zichtbaar als links (auditor: UI) */
  .related a, .related-block a { color: var(--color-copper-text); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .related a:hover, .related-block a:hover { color: var(--color-charcoal-dark); }
</style>
