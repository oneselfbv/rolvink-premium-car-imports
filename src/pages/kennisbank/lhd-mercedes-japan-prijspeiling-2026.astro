---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AuthorByline from '../../components/AuthorByline.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Kennisbank', url: '/kennisbank' },
  { name: 'LHD Mercedes Japan — prijspeiling juni 2026' },
];

const publishedDate = '2026-06-04';
const updatedDate = '2026-06-04';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Wat kost een linksgestuurde Mercedes uit Japan echt? — prijspeiling juni 2026',
  description: 'Echte veilingprijzen van linksgestuurde (LHD) Mercedessen uit Japan, juni 2026, afgezet tegen de Nederlandse markt. Van courante E-Klasse tot G 63 AMG, met indicatieve rijklaar-prijzen.',
  datePublished: publishedDate,
  dateModified: updatedDate,
  author: { '@type': 'Person', name: 'Theo Rolvink', url: 'https://www.rolvinkpremiumcarimports.nl/over/' },
  publisher: { '@type': 'Organization', name: 'Rolvink Premium Imports', logo: { '@type': 'ImageObject', url: 'https://www.rolvinkpremiumcarimports.nl/favicon.svg' } },
  mainEntityOfPage: { '@type': 'WebPage', '@id': 'https://www.rolvinkpremiumcarimports.nl/kennisbank/lhd-mercedes-japan-prijspeiling-2026/' },
  image: 'https://www.rolvinkpremiumcarimports.nl/og-image.jpg',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Is een linksgestuurde auto uit Japan in Nederland gewoon te gebruiken?', acceptedAnswer: { '@type': 'Answer', text: 'Ja. LHD (stuur links) is de Nederlandse en Europese standaard. Geen ombouw, geen verzekeringstoeslag, geen praktische nadelen.' } },
    { '@type': 'Question', name: 'Hoe lang duurt zo een import?', acceptedAnswer: { '@type': 'Answer', text: 'Doorgaans 8 tot 12 weken, van veilingbod tot Nederlands kenteken.' } },
    { '@type': 'Question', name: 'Wat betekent grade 4?', acceptedAnswer: { '@type': 'Answer', text: 'De grade is de conditiescore die een onafhankelijke inspecteur op de Japanse veiling toekent. Wij sourcen uitsluitend grade 4 of hoger.' } },
    { '@type': 'Question', name: 'Kan ik ook een specifiek model laten zoeken?', acceptedAnswer: { '@type': 'Answer', text: 'Ja. Geef het type, bouwjaar en budget door, dan zoeken wij in de lopende veilingen een passend LHD-exemplaar met grade 4 of hoger, inclusief een eerlijke rijklaar-prijs vooraf.' } },
    { '@type': 'Question', name: 'Zijn deze prijzen een garantie?', acceptedAnswer: { '@type': 'Answer', text: 'Nee, het is een momentopname. Hamerprijzen, koers en BPM verschillen per auto en per veiling.' } },
  ],
};
---

<BaseLayout
  title="Wat kost een LHD Mercedes uit Japan? Prijspeiling juni 2026 — Rolvink"
  description="Echte veilingprijzen van linksgestuurde Mercedessen uit Japan (juni 2026), afgezet tegen de Nederlandse markt. Van E-Klasse tot G 63 AMG, met rijklaar-voorbeelden."
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <article class="cornerstone-page">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />

      <header class="article-header">
        <div class="section-eyebrow">Marktdata</div>
        <h1>Wat kost een linksgestuurde Mercedes uit Japan <span class="accent">echt</span>?</h1>
        <p class="lead">Wij volgen de Japanse veilingen op linksgestuurde (LHD) auto's met conditie grade 4 of hoger. Deze prijspeiling van juni 2026 toont met echte cijfers wat zulke auto's daar opbrengen, en wat een vergelijkbaar exemplaar in Nederland kost.</p>
        <div class="article-meta">
          <span>Gepubliceerd: 4 juni 2026</span>
          <span>·</span>
          <span>Leestijd: ongeveer 7 minuten</span>
        </div>
      </header>

      <AuthorByline variant="top" />

      <div class="disclaimer">
        <strong>Cijfers zijn een momentopname, geen garantie.</strong> Alle bedragen zijn gebaseerd op openbare veilingdata (Pacific Coast JDM, CarVector, Japan Car Direct) en Nederlandse vraagprijzen (Marktplaats), peildatum juni 2026. Hamerprijzen, wisselkoers en BPM verschillen per individueel exemplaar; rijklaar-prijzen zijn indicatief. Geen fiscaal, technisch of juridisch advies — voor exacte cijfers raadplegen wij Belastingdienst, RDW en gespecialiseerde werkplaatsen.
      </div>

      <nav class="toc">
        <h2>In deze peiling</h2>
        <ol>
          <li><a href="#lhd-standaard">LHD is gewoon de Nederlandse standaard</a></li>
          <li><a href="#methode">Hoe wij meten</a></li>
          <li><a href="#aanbod">Wat staat er nu aan LHD-aanbod?</a></li>
          <li><a href="#courant">Verkoopprijzen — het courante segment</a></li>
          <li><a href="#premium">Verkoopprijzen — het premium segment</a></li>
          <li><a href="#rijklaar">Wat kost het rijklaar in Nederland?</a></li>
          <li><a href="#conclusie">Conclusie — waar zit de waarde?</a></li>
          <li><a href="#faq">Veelgestelde vragen</a></li>
        </ol>
      </nav>

      <section id="lhd-standaard" class="content-section">
        <h2>Eerst even dit: LHD is gewoon de Nederlandse standaard</h2>
        <p>De meest gestelde vraag bij Japanse import: <em>"rijdt die auto dan niet aan de verkeerde kant?"</em> Nee. <strong>LHD staat voor Left Hand Drive — het stuur links — en dat is precies de Nederlandse en Europese standaard.</strong> Een linksgestuurde import uit Japan is hier een volstrekt normale auto: zonder ombouw te verzekeren, te parkeren en te rijden.</p>
        <p>Het bijzondere is juist dat LHD-auto's in Japan een niche zijn (daar rijdt men rechtsgestuurd). Ze werden ooit als LHD geleverd aan expats en liefhebbers en komen nu via de veilingen vrij — vaak met lage kilometerstanden, weinig roest en een strenge keuringshistorie (de Japanse Shaken).</p>
      </section>

      <section id="methode" class="content-section">
        <h2>Hoe wij meten</h2>
        <p>Wij kijken uitsluitend naar <strong>grade 4 of hoger</strong> — de hoogste conditiescores op de Japanse veilingschaal — en alleen naar linksgestuurde exemplaren. De verkoopprijzen hieronder komen uit de veiling-statistieken (volledige yen), omgerekend tegen de koers van begin juni 2026: <strong>&yen;1.000.000 &asymp; &euro;5.355</strong>. Lotnummers en exacte data laten wij weg; het gaat om het prijsbeeld.</p>
      </section>

      <section id="aanbod" class="content-section">
        <h2>Wat staat er nu aan LHD-aanbod?</h2>
        <p>Een momentopname van het actuele LHD-aanbod (grade 4+) op de Japanse veilingen:</p>
        <table class="cost-table">
          <thead><tr><th>Merk</th><th>LHD-units grade 4+</th><th>Kenmerk</th></tr></thead>
          <tbody>
            <tr><td>Mercedes-Benz</td><td>~100</td><td>Volop aanbod, sterk premium-gewogen</td></tr>
            <tr><td>BMW</td><td>~20</td><td>Schaars; vooral M-modellen, 6-serie, klassiekers</td></tr>
          </tbody>
        </table>
        <p>Binnen het Mercedes-aanbod is bijna de helft S-Klasse, G-Klasse, SL, AMG en Maybach. De courante modellen — E-Klasse, CLS, GLK — zijn er ook, maar in kleinere aantallen. <strong>Voor wie een zeldzame LHD-uitvoering zoekt die in Nederland nauwelijks te vinden is, is Japan dus juist een sterke bron.</strong></p>
      </section>

      <section id="courant" class="content-section">
        <h2>Echte verkoopprijzen — het courante segment</h2>
        <p>Hamerprijzen van recent verkochte LHD-Mercedessen, grade 4+ (juni 2026):</p>
        <table class="cost-table">
          <thead><tr><th>Model</th><th>Jaar</th><th>Km</th><th>Grade</th><th>Verkocht (&yen;)</th><th>&asymp; &euro; hammer</th></tr></thead>
          <tbody>
            <tr><td>E 350 Avantgarde (sedan)</td><td>2009</td><td>~110.000</td><td>4</td><td>1.700.000</td><td>&euro;9.105</td></tr>
            <tr><td>E 300 4Matic Avantgarde</td><td>2016</td><td>44.000</td><td>4</td><td>1.329.000</td><td>&euro;7.120</td></tr>
          </tbody>
        </table>
        <p>Een E 300 uit 2016 met <strong>44.000 km</strong> voor ruim &euro;7.000 (hammer) bestaat in Nederland praktisch niet — hier liggen vergelijkbare W212/W213-exemplaren met die kilometerstand zelden onder de &euro;20.000.</p>
      </section>

      <section id="premium" class="content-section">
        <h2>Echte verkoopprijzen — het premium segment</h2>
        <p>Hier is het LHD-aanbod uit Japan op zijn sterkst, en hier zijn de bedragen navenant:</p>
        <table class="cost-table">
          <thead><tr><th>Model</th><th>Jaar</th><th>Km</th><th>Grade</th><th>Verkocht (&yen;)</th><th>&asymp; &euro; hammer</th></tr></thead>
          <tbody>
            <tr><td>AMG G 63</td><td>2021</td><td>11.000</td><td>5</td><td>16.425.000</td><td>&euro;87.975</td></tr>
            <tr><td>AMG G 450d Manufaktur</td><td>2025</td><td>3.000</td><td>6</td><td>18.140.000</td><td>&euro;97.160</td></tr>
            <tr><td>AMG SL 63 4M+</td><td>2024</td><td>2.000</td><td>5</td><td>15.485.000</td><td>&euro;82.940</td></tr>
            <tr><td>Maybach GLS 600</td><td>2023</td><td>8.000</td><td>5</td><td>15.920.000</td><td>&euro;85.270</td></tr>
            <tr><td>AMG GT 4-deurs 53 4M+</td><td>2023</td><td>10.000</td><td>5</td><td>10.760.000</td><td>&euro;57.630</td></tr>
            <tr><td>AMG C 63 S E Performance</td><td>2024</td><td>5.000</td><td>5</td><td>9.570.000</td><td>&euro;51.260</td></tr>
          </tbody>
        </table>
        <p>Juist deze modellen — de G-Klasse en de AMG-uitvoeringen — zijn in Nederland schaars en prijsvast. Een G 63 uit 2021 staat hier al snel op &euro;150.000 of meer.</p>
      </section>

      <section id="rijklaar" class="content-section">
        <h2>Wat kost het rijklaar in Nederland?</h2>
        <p>De hamerprijs is niet de eindprijs. Daarbovenop komen veilingkosten, zeevracht (samen de CIF-waarde), 10% invoerrecht, 21% btw, BPM, RDW-keuring en kentekening. Twee indicatieve voorbeelden:</p>
        <h3>Mercedes SL 500 (R230), ~2007, grade 4</h3>
        <ul class="bullet-list">
          <li>Inkoop + transport tot Rotterdam: &plusmn; &euro;9.500 – &euro;11.500</li>
          <li>Invoerrecht, btw, BPM, RDW: &plusmn; &euro;5.000 – &euro;6.800</li>
          <li><strong>Rijklaar in Nederland: &plusmn; &euro;14.700 – &euro;18.300</strong></li>
          <li>Vergelijkbare SL 500 op de Nederlandse markt: <strong>&euro;19.500 – &euro;22.000</strong></li>
        </ul>
        <h3>Mercedes E 300 4Matic, 2016, grade 4, 44.000 km</h3>
        <ul class="bullet-list">
          <li>Indicatieve rijklaar-prijs via import: &plusmn; &euro;15.500 – &euro;16.500</li>
          <li>Vergelijkbare E-Klasse in NL (zelfde bouwjaar): <strong>&euro;18.000 – &euro;22.000</strong></li>
        </ul>
        <p>Let op: de <strong>BPM</strong> is de grootste variabele en hangt af van CO&#8322; en leeftijd. Bij 4Matic-V6-uitvoeringen valt die hoger uit — wat de aantrekkelijkheid van het courante middensegment drukt. Voor een exacte berekening gebruiken wij altijd de actuele BPM-grondslag (zie onze <a href="/kennisbank/bpm-importauto-2026">BPM-gids</a>).</p>
      </section>

      <section id="conclusie" class="content-section">
        <h2>Conclusie: waar zit de waarde?</h2>
        <ol class="recommendation-list">
          <li><strong>Zeldzaamheid loont.</strong> LHD-modellen die in Nederland schaars zijn (G-Klasse, SL, AMG, Maybach) liggen in Japan ruim voor het oprapen.</li>
          <li><strong>Lage kilometerstanden.</strong> Japanse exemplaren hebben structureel minder kilometers en minder corrosie.</li>
          <li><strong>De zwakke yen helpt.</strong> Bij &yen;1.000.000 &asymp; &euro;5.355 is de inkoop in euro's gunstiger dan een jaar terug — vooral op de duurdere modellen telt dat aan.</li>
          <li><strong>Het courante midden is krapper.</strong> Een gewone E 350 of CLS 350 kan, maar de marge tussen rijklaar-prijs en NL-markt is daar smal; lage kilometerstand en lage BPM maken het verschil.</li>
        </ol>
      </section>

      <section id="faq" class="content-section">
        <h2>Veelgestelde vragen</h2>
        <h3>Is een linksgestuurde auto uit Japan in Nederland gewoon te gebruiken?</h3>
        <p>Ja. LHD (stuur links) is de Nederlandse en Europese standaard. Geen ombouw, geen verzekeringstoeslag, geen praktische nadelen.</p>
        <h3>Hoe lang duurt zo'n import?</h3>
        <p>Doorgaans 8 tot 12 weken, van veilingbod tot Nederlands kenteken.</p>
        <h3>Wat betekent "grade 4"?</h3>
        <p>De grade is de conditiescore die een onafhankelijke inspecteur op de Japanse veiling toekent. Wij sourcen uitsluitend grade 4 of hoger. Zie ook onze <a href="/kennisbank/japanse-veiling-grades">uitleg van de auction grades</a>.</p>
        <h3>Kan ik ook een specifiek model laten zoeken?</h3>
        <p>Ja. Geef het type, bouwjaar en budget door, dan zoeken wij in de lopende veilingen een passend LHD-exemplaar met grade 4 of hoger — inclusief een eerlijke rijklaar-prijs vooraf.</p>
        <h3>Zijn deze prijzen een garantie?</h3>
        <p>Nee, het is een momentopname. Hamerprijzen, koers en BPM verschillen per auto en per veiling.</p>
      </section>

      <div class="page-cta">
        <h2>Een specifiek model op het oog?</h2>
        <p>Vertel ons type, bouwjaar, kleur en budget — wij screenen de Japanse veilingen gericht op linksgestuurde grade 4+ exemplaren en rekenen vooraf een eerlijke rijklaar-prijs uit.</p>
        <a href="/contact" class="page-cta-btn">
          Plan intake-gesprek
          <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
        <p class="page-cta-note">Binnen 24 uur reactie · Geen verkoopdruk</p>
      </div>

      <div class="related">
        <h3>Verder lezen</h3>
        <ul>
          <li><a href="/kennisbank/recente-japan-realisaties">Japans LHD-aanbod per merk</a></li>
          <li><a href="/kennisbank/auto-importeren-japan">Auto importeren uit Japan — complete gids</a></li>
          <li><a href="/kennisbank/bpm-importauto-2026">BPM voor importauto's — gids 2026</a></li>
          <li><a href="/kennisbank/mercedes-e-klasse-w212">Mercedes E-Klasse W212 — koopgids</a></li>
          <li><a href="/kennisbank/lhd-rhd-groene-markering">LHD versus RHD bij Japanse veilingen</a></li>
        </ul>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .cornerstone-page { padding: 64px 0 96px; }
  .article-header { max-width: 760px; margin-bottom: 32px; }
  .cornerstone-page h1 { font-size: 56px; font-weight: 600; margin-bottom: 24px; line-height: 1.05; }
  .lead { font-size: 19px; color: var(--color-text-secondary); margin-bottom: 16px; line-height: 1.65; }
  .article-meta { font-size: 13px; color: var(--color-text-tertiary); display: flex; gap: 8px; }

  .disclaimer { max-width: 760px; padding: 18px 22px; margin-bottom: 48px; background: var(--color-cream-warm); border-left: 3px solid var(--color-copper-text); font-size: 14px; line-height: 1.6; color: var(--color-text-secondary); }
  .disclaimer strong { color: var(--color-text-primary); }

  .toc { background: var(--color-cream-warm); padding: 28px 32px; border-left: 3px solid var(--color-copper-text); margin-bottom: 56px; max-width: 760px; }
  .toc h2 { font-size: 14px; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-copper-text); margin-bottom: 16px; }
  .toc ol { padding-left: 24px; }
  .toc li { padding: 5px 0; font-size: 15px; }
  .toc a { color: var(--color-copper-text); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; transition: color 0.2s; }
  .toc a:hover { color: var(--color-charcoal-dark); }

  .content-section { max-width: 760px; margin-bottom: 56px; }
  .content-section h2 { font-size: 32px; font-weight: 600; margin-bottom: 20px; line-height: 1.15; scroll-margin-top: 80px; }
  .content-section h3 { font-size: 20px; font-weight: 600; margin-top: 28px; margin-bottom: 8px; }
  .content-section p { font-size: 16px; color: var(--color-text-secondary); line-height: 1.7; margin-bottom: 16px; }
  .content-section a { color: var(--color-copper-text); text-decoration: underline; }
  .content-section strong { color: var(--color-text-primary); font-weight: 600; }
  .content-section em { font-style: italic; }

  .bullet-list { padding-left: 0; }
  .bullet-list li { padding: 8px 0; font-size: 16px; color: var(--color-text-secondary); line-height: 1.65; display: flex; gap: 12px; align-items: baseline; }
  .bullet-list li::before { content: "\2192"; color: var(--color-copper-text); font-weight: 600; flex-shrink: 0; }
  .bullet-list strong { color: var(--color-text-primary); }

  .recommendation-list { padding-left: 24px; }
  .recommendation-list li { padding: 12px 0; font-size: 16px; color: var(--color-text-secondary); line-height: 1.65; }
  .recommendation-list strong { color: var(--color-text-primary); }

  .cost-table { width: 100%; border-collapse: collapse; margin-bottom: 16px; font-size: 14px; }
  .cost-table th { background: var(--color-charcoal-dark); color: var(--color-cream); padding: 12px 14px; text-align: left; font-weight: 600; font-size: 13px; letter-spacing: 0.05em; }
  .cost-table td { padding: 10px 14px; border-bottom: 1px solid var(--color-border-soft); color: var(--color-text-secondary); }
  .cost-table tbody tr:hover { background: var(--color-cream-warm); }

  .page-cta { margin-top: 80px; padding: 56px 40px; background: var(--color-charcoal-dark); color: var(--color-cream); text-align: center; }
  .page-cta h2 { color: var(--color-cream); font-size: 32px; margin-bottom: 12px; }
  .page-cta p { color: rgba(245, 241, 234, 0.85); margin-bottom: 24px; font-size: 16px; }
  .page-cta-btn { display: inline-flex; align-items: center; gap: 12px; padding: 18px 36px; background: var(--color-copper-text); color: var(--color-charcoal-dark); font-size: 14px; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; text-decoration: none; transition: transform 0.2s, background 0.2s; }
  .page-cta-btn:hover { transform: translateY(-2px); background: #d18a3f; }
  .page-cta-btn .arrow { font-size: 18px; }
  .page-cta-note { margin-top: 16px; font-size: 12px; color: rgba(245, 241, 234, 0.6); }

  .related { max-width: 760px; margin-top: 64px; padding-top: 32px; border-top: 1px solid var(--color-border-medium); }
  .related h3 { font-size: 14px; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-copper-text); margin-bottom: 16px; }
  .related ul { list-style: none; padding: 0; }
  .related li { padding: 8px 0; }
  .related a { color: var(--color-copper-text); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; font-size: 16px; transition: color 0.2s; }
  .related a:hover { color: var(--color-charcoal-dark); }

  @media (max-width: 768px) {
    .cornerstone-page h1 { font-size: 36px; }
    .content-section h2 { font-size: 24px; }
    .toc { padding: 20px 22px; }
