---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AuthorByline from '../../components/AuthorByline.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Kennisbank', url: '/kennisbank' },
  { name: 'Japan LHD-aanbod per merk' },
];

const publishedDate = '2026-05-29';
const updatedDate = '2026-05-29';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Japans LHD-aanbod per merk — wat typisch verschijnt in grade 4+',
  description: 'Welke linksgestuurde grade 4+ uitvoeringen structureel op de Japanse veilingen verschijnen binnen onze scope: Mercedes-Benz, Porsche, BMW en Audi. Op observatie gebaseerd, geen marketing-schattingen.',
  datePublished: publishedDate,
  dateModified: updatedDate,
  author: { '@type': 'Person', name: 'Theo Rolvink', url: 'https://www.rolvinkpremiumcarimports.nl/over/' },
  publisher: { '@type': 'Organization', name: 'Rolvink Premium Car Imports', logo: { '@type': 'ImageObject', url: 'https://www.rolvinkpremiumcarimports.nl/favicon.svg' } },
  mainEntityOfPage: { '@type': 'WebPage', '@id': 'https://www.rolvinkpremiumcarimports.nl/kennisbank/recente-japan-realisaties/' },
  image: 'https://www.rolvinkpremiumcarimports.nl/og-image.jpg',
};

// Kwalitatieve beschikbaarheid binnen onze scope (LHD, grade 4+), op basis van
// doorlopende observatie van meerdere Japanse veilingbronnen. Geen vaste telling:
// het aanbod wisselt continu en ligt structureel hoger dan een enkele momentopname suggereert.
const brandOverview = [
  { brand: 'Mercedes-Benz', aanbod: 'Zeer ruim', note: 'De grootste LHD-pool — van S- en E-Klasse tot AMG en klassiekers.' },
  { brand: 'Porsche', aanbod: 'Ruim', note: 'Sterk gespreid over alle 911-generaties, plus Cayenne, Boxster, Cayman en Panamera.' },
  { brand: 'BMW', aanbod: 'Regelmatig', note: 'Vooral 5-Serie en M-segment; mainstream sneller via Duitsland.' },
  { brand: 'Audi', aanbod: 'Zeer schaars', note: 'LHD-Audi is in Japan een uitzondering — Duitsland is hier de logische route.' },
];

const mercedesBreakdown = [
  { model: 'S-Klasse (W221/W222)', aanbod: 'Ruim', jaarrange: '2001-2021', grades: '4 / 4.5 / 5' },
  { model: 'E-Klasse sedan (W211/W212/W213)', aanbod: 'Ruim', jaarrange: '1995-2021', grades: '4 / 4.5' },
  { model: 'G-Klasse / AMG G-Klasse', aanbod: 'Regelmatig', jaarrange: '1998-2024', grades: '4 / 4.5 / 5' },
  { model: 'CLS (W219/W218/C257)', aanbod: 'Regelmatig', jaarrange: '2007-2021', grades: '4 / 4.5' },
  { model: 'CL-Klasse (W215/W216)', aanbod: 'Regelmatig', jaarrange: '2005-2013', grades: '4 / 4.5' },
  { model: 'GLK / GLE / GLS', aanbod: 'Regelmatig', jaarrange: '2011-2021', grades: '4 / 4.5' },
  { model: 'SL (R230/R231)', aanbod: 'Incidenteel', jaarrange: '1999-2013', grades: '4 / 4.5' },
  { model: 'AMG-uitvoeringen (CLS / GLE53 e.a.)', aanbod: 'Incidenteel', jaarrange: '2011-2021', grades: '4 / 4.5' },
  { model: 'C-Klasse', aanbod: 'Incidenteel', jaarrange: '2000-2015', grades: '4 / 4.5' },
  { model: 'E-Klasse Estate (S212/S213)', aanbod: 'Schaars', jaarrange: '2012-2018', grades: '4 / 4.5' },
  { model: 'Maybach', aanbod: 'Schaars', jaarrange: '2017+', grades: '4' },
];

const porscheBreakdown = [
  { model: '911 (964/993/996/997/991/992)', aanbod: 'Ruim', jaarrange: '1992-heden', notes: 'Sterk verdeeld over alle generaties — air-cooled tot 992.' },
  { model: 'Cayenne', aanbod: 'Regelmatig', jaarrange: '2009-heden', notes: 'Turbo / S / GTS.' },
  { model: 'Boxster (986/987/981)', aanbod: 'Regelmatig', jaarrange: '2002-heden', notes: 'S-uitvoeringen veelgevraagd.' },
  { model: 'Panamera', aanbod: 'Incidenteel', jaarrange: '2012-heden', notes: 'Base, 4S en GTS — wij sourcen Panamera wel degelijk.' },
  { model: 'Cayman (987/981/718)', aanbod: 'Incidenteel', jaarrange: '2009-heden', notes: 'Cayman S en 718 (IMS-vrij 9A1).' },
  { model: 'Macan', aanbod: 'Schaars', jaarrange: '2015-heden', notes: 'Sportieve uitvoeringen incidenteel.' },
];

function aanbodClass(v) {
  const t = (v || '').toLowerCase();
  if (t.includes('zeer ruim') || t === 'ruim') return 'is-ruim';
  if (t.includes('regelmatig')) return 'is-regelmatig';
  if (t.includes('incidenteel')) return 'is-incidenteel';
  return 'is-schaars';
}

---

<BaseLayout
  title="Japans LHD-aanbod per merk — grade 4+ | Rolvink"
  description="Welke linksgestuurde grade 4+ uitvoeringen structureel op Japanse veilingen verschijnen voor Mercedes, Porsche, BMW en Audi. Op observatie gebaseerd."
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} slot="head" />

  <article class="cornerstone-page">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />

      <header class="article-header">
        <div class="section-eyebrow">Marktdata — Japan</div>
        <h1>Japans <span class="accent">LHD-aanbod</span> per merk.</h1>
        <p class="lead">Wat verschijnt er structureel op de Japanse veilingen in LHD, grade 4 of hoger, binnen onze sourcing-scope? Hieronder per merk wat je realistisch mag verwachten — gebaseerd op doorlopende observatie van meerdere veilingbronnen, niet op een momentopname. Het werkelijke aanbod wisselt continu en ligt over een maand gerekend ruim hoger dan één enkele lijst doet vermoeden.</p>
      </header>

      <AuthorByline variant="top" />

      <div class="disclaimer">
        <strong>Hoe dit is samengesteld:</strong> op basis van onze doorlopende screening van meerdere Japanse veilingbronnen (o.a. USS, JU, JAA, CAA, ARAI, TAA, ZIP, BAYAUC) en broker-platforms, gefilterd op <strong>linksgestuurd (LHD)</strong> en <strong>grade 4 of hoger</strong> — geen R/RA/A/X-classificaties, geen RHD. Dit is geen verkooplijst en geen vaste voorraad: het beschrijft welk type uitvoeringen met welke regelmaat langskomen. Voor de kostenkant: reken op een landed cost typisch 75-90% boven de hamerprijs (zie de <a href="/kennisbank/auto-importeren-japan/">complete kosten-uitleg</a>).
      </div>

      <nav class="toc" aria-label="Inhoud">
        <h2>In dit overzicht</h2>
        <ol>
          <li><a href="#totaal">Aanbod per merk — het grote beeld</a></li>
          <li><a href="#mercedes">Mercedes-Benz — de breedste LHD-pool</a></li>
          <li><a href="#porsche">Porsche — gespreid over alle generaties</a></li>
          <li><a href="#bmw">BMW — geconcentreerd in 5-Serie en M</a></li>
          <li><a href="#audi">Audi — Duitsland is de route</a></li>
          <li><a href="#hoe-lezen">Hoe dit overzicht te lezen</a></li>
        </ol>
      </nav>

      <section id="totaal" class="content-section">
        <h2>Aanbod per merk — het grote beeld</h2>
        <p>Binnen onze vier scope-merken verschilt de LHD-beschikbaarheid sterk. Mercedes en Porsche vormen het leeuwendeel van wat in LHD grade 4+ langskomt; BMW is geconcentreerder en Audi is in Japan een uitzondering.</p>
        <p>Ter illustratie van de schaal: op één veiling-aggregator alléén staan doorlopend in de orde van honderdvijftig linksgestuurde grade 4+ auto's tegelijk over alle merken — en dat is dus nog vóór de andere bronnen die wij parallel screenen. Het overgrote deel daarvan is Mercedes-Benz, met Porsche als sterke tweede; BMW volgt op afstand en Audi is met hooguit een enkel exemplaar de uitzondering die de regel bevestigt. Het werkelijke aanbod is daarmee fors groter dan een losse "recente verkopen"-lijst doet vermoeden.</p>
        <table class="cost-table">
          <thead>
            <tr><th>Merk</th><th>LHD grade 4+ aanbod</th><th>Toelichting</th></tr>
          </thead>
          <tbody>
            {brandOverview.map((b) => (
              <tr>
                <td>{b.brand}</td>
                <td><span class={`aanbod-badge ${aanbodClass(b.aanbod)}`}>{b.aanbod}</span></td>
                <td>{b.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p>Mercedes is veruit de grootste LHD-pool — breder dan de andere drie merken samen. Porsche heeft een gezond, gespreid aanbod over alle 911-generaties. BMW levert beperkter maar consistent, vooral in 5-Serie en M-segment. Audi is in LHD zo schaars dat Duitsland daar onze enige realistische route is.</p>
      </section>

      <section id="mercedes" class="content-section">
        <h2>Mercedes-Benz — de breedste LHD-pool</h2>
        <p>Mercedes biedt het grootste en meest gevarieerde LHD-aanbod. <strong>S-Klasse en E-Klasse zijn de best vertegenwoordigde modellijnen</strong> — wie een grote sedan zoekt, heeft hier doorlopend keuze. Ook de <strong>G-Klasse is opvallend sterk aanwezig</strong> (van G320/G550 tot G63 AMG). Een nuance ten opzichte van eerdere aannames: zelfs de <strong>E-Klasse Estate bestaat in LHD</strong> — schaars, maar incidenteel beschikbaar voor wie geduld heeft.</p>
        <table class="cost-table">
          <thead>
            <tr><th>Model</th><th>LHD-aanbod</th><th>Bouwjaarrange</th><th>Grades</th></tr>
          </thead>
          <tbody>
            {mercedesBreakdown.map((m) => (
              <tr>
                <td>{m.model}</td>
                <td><span class={`aanbod-badge ${aanbodClass(m.aanbod)}`}>{m.aanbod}</span></td>
                <td>{m.jaarrange}</td>
                <td>{m.grades}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p>Voor de bredere context: <a href="/merk/mercedes-benz/">onze Mercedes-focus</a> en de <a href="/kennisbank/mercedes-e-klasse-w212/">E-Klasse W212 koopgids</a>.</p>
      </section>

      <section id="porsche" class="content-section">
        <h2>Porsche — gespreid over alle generaties</h2>
        <p>Porsche is qua spreiding de rijkste groep — de 911 verschijnt in LHD over alle generaties van 964 tot 992, aangevuld met Cayenne, Boxster, Cayman en Panamera. <strong>Panamera sourcen wij wel degelijk</strong> (Base, 4S en GTS). Voor de breedste 911-keuze in LHD is Japan structureel de logische bron:</p>
        <table class="cost-table">
          <thead>
            <tr><th>Model</th><th>LHD-aanbod</th><th>Bouwjaarrange</th><th>Notes</th></tr>
          </thead>
          <tbody>
            {porscheBreakdown.map((p) => (
              <tr>
                <td>{p.model}</td>
                <td><span class={`aanbod-badge ${aanbodClass(p.aanbod)}`}>{p.aanbod}</span></td>
                <td>{p.jaarrange}</td>
                <td>{p.notes}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p>Voor de IMS-discussie bij 996/997.1 — niet relevant voor de 9A1-aandrijflijn vanaf 997.2 — zie de complete <a href="/kennisbank/porsche-ims-lager-996-997/">IMS-koopgids</a>. Voor het volledige 911-overzicht: <a href="/kennisbank/porsche-911-modelgids/">modelgids vijf generaties</a>. Voor een doorgerekende landed-cost vergelijking JP vs DE: <a href="/kennisbank/porsche-997-2-japan-vs-duitsland/">de cost-vergelijking</a>.</p>
      </section>

      <section id="bmw" class="content-section">
        <h2>BMW — geconcentreerd in 5-Serie en M</h2>
        <p>Het BMW-LHD aanbod is geconcentreerder dan dat van Mercedes of Porsche. Wat met regelmaat langskomt: 5-Serie sedan (E60/F10/G30), het M-segment (M3 F80, M4 F82, M5 F10/F90), 6-Serie coupé (F12/F13) en incidenteel X5/X6 M. Voldoende voor een specifieke uitvoeringswens; voor mainstream 530i / 540i / 730i is Duitsland sneller. Onze brede BMW-focus: <a href="/merk/bmw/">/merk/bmw</a>. Voor de 5-Serie F10/G30: <a href="/kennisbank/bmw-5-serie-f10-g30/">koopgids</a>.</p>
      </section>

      <section id="audi" class="content-section">
        <h2>Audi — Duitsland is de route</h2>
        <p>LHD-Audi is op de Japanse veilingen een uitzondering, geen pijplijn. Dit bevestigt wat onze <a href="/kennisbank/audi-quattro-rs-koopgids/">Audi quattro &amp; RS koopgids</a> stelt: voor Audi is Duitsland structureel de logische bron. RS3 / RS4 / RS6 / RS Q8 kunnen incidenteel via Japan komen — maar als zeldzame uitzondering, niet als betrouwbare stroom. Voor een RS-zoekopdracht: persoonlijke bezichtiging in Duitsland binnen 2-4 weken, of een Japan-watchlist voor een geduldig project zonder einddatum.</p>
      </section>

      <section id="hoe-lezen" class="content-section">
        <h2>Hoe dit overzicht te lezen</h2>
        <ul class="bullet-list">
          <li><strong>"Aanbod" beschrijft regelmaat, geen voorraad.</strong> Dit is wat met welke frequentie op de veilingen verschijnt — niet wat wij op stock hebben. Hammerprijzen en dus de uiteindelijke landed cost worden pas duidelijk per concreet exemplaar. Voor de doorrekening: <a href="/kennisbank/auto-importeren-japan/">Japan-import-gids</a> en <a href="/voorbeeld-traject/">voorbeeld-traject W212</a>.</li>
          <li><strong>Grade 4 of hoger is onze ondergrens.</strong> Alles met conditie 3.5 of lager filteren wij weg, evenals R / RA / A / X-classificaties. Dit is dus de bovenste laag van het Japanse aanbod, niet het volledige veilingvolume.</li>
          <li><strong>Alleen originele LHD.</strong> Bevestigd linksgestuurd via de auction sheet — geen RHD-conversies. Voor de achtergrond: <a href="/kennisbank/lhd-rhd-groene-markering/">LHD versus RHD bij Japanse veilingen</a>.</li>
          <li><strong>Meerdere bronnen gecombineerd.</strong> Geen enkel platform toont het complete Japanse aanbod. Onze sourcing combineert meerdere veiling- en broker-bronnen voor maximaal bereik — het werkelijke aanbod is daardoor groter dan één lijst suggereert.</li>
        </ul>
        <p>Voor de complete proces-uitleg: <a href="/kennisbank/auto-importeren-japan/">complete Japan-import-gids</a>. Voor de directe afweging Japan vs Duitsland: <a href="/route-advies/">route-advies-tool</a>. Voor onze sourcing-tarieven: <a href="/tarieven/">/tarieven</a>.</p>
      </section>

      <AuthorByline variant="bottom" />

      <div class="page-cta">
        <h2>Op zoek naar een specifieke uitvoering?</h2>
        <p>Vertel ons merk, model, uitvoering en budget. Wij screenen doorlopend meerdere Japanse veilingbronnen plus de Duitse markt en geven u realistische landed-cost-prognoses op basis van actuele marktdata — niet op basis van marketing-tabellen.</p>
        <a href="/contact" class="page-cta-btn">
          Plan intake-gesprek
          <span class="arrow" aria-hidden="true">→</span>
        </a>
        <p class="page-cta-note">Binnen 24 uur reactie · Geen verkoopdruk</p>
      </div>

      <div class="related-block">
        <h3>Verder lezen</h3>
        <ul>
          <li><a href="/kennisbank/auto-importeren-japan/">Auto importeren uit Japan — complete gids</a></li>
          <li><a href="/kennisbank/japanse-veiling-grades/">Japanse auction grades uitgelegd</a></li>
          <li><a href="/kennisbank/japanse-auction-sheet-lezen/">Japanse auction sheet lezen — complete gids</a></li>
          <li><a href="/kennisbank/lhd-rhd-groene-markering/">LHD versus RHD bij Japanse veilingen</a></li>
          <li><a href="/kennisbank/bpm-importauto-2026/">BPM voor importauto's — gids 2026</a></li>
          <li><a href="/kennisbank/porsche-997-2-japan-vs-duitsland/">997.2 — Japan vs Duitsland cost-vergelijking</a></li>
          <li><a href="/voorbeeld-traject/">Voorbeeld-traject W212 — volledig doorgerekend</a></li>
          <li><a href="/route-advies/">Route-advies — Japan of Duitsland?</a></li>
        </ul>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .cornerstone-page { padding: 64px 0 96px; }
  .article-header { max-width: 760px; margin-bottom: 32px; }
  .article-header h1 { font-family: var(--font-serif); font-size: 64px; font-weight: 500; letter-spacing: 0.02em; margin: 16px 0 24px; line-height: 1.05; }
  .article-header .lead { font-size: 19px; color: var(--color-text-secondary); line-height: 1.6; margin-bottom: 24px; }
  .article-meta { font-size: 13px; color: var(--color-text-tertiary); display: flex; gap: 8px; }

  .disclaimer { max-width: 800px; padding: 18px 22px; margin-bottom: 48px; background: var(--color-cream-warm); border-left: 3px solid var(--color-copper-text); font-size: 14px; line-height: 1.6; color: var(--color-text-secondary); }
  .disclaimer strong { color: var(--color-charcoal-dark); }
  .disclaimer a { color: var(--color-copper-text); }

  .toc { max-width: 760px; margin-bottom: 56px; padding: 24px 28px; background: var(--color-cream); border-left: 3px solid var(--color-copper-text); }
  .toc h2 { font-size: 14px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-copper-text); margin-bottom: 14px; font-weight: 600; }
  .toc ol { margin: 0; padding-left: 20px; }
  .toc li { padding: 4px 0; font-size: 15px; }
  .toc a { color: var(--color-copper-text); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; transition: color 0.2s; }
  .toc a:hover { color: var(--color-charcoal-dark); }

  .content-section { max-width: 900px; margin-bottom: 56px; }
  .content-section h2 { font-family: var(--font-display); font-size: 32px; font-weight: 600; margin-bottom: 20px; letter-spacing: -0.01em; }
  .content-section p { font-size: 17px; line-height: 1.65; color: var(--color-text-primary); margin-bottom: 18px; }
  .content-section a { color: var(--color-copper-text); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }

  .bullet-list { padding-left: 20px; margin-bottom: 18px; }
  .bullet-list li { font-size: 17px; line-height: 1.65; color: var(--color-text-primary); margin-bottom: 12px; }
  .bullet-list li strong { color: var(--color-charcoal-dark); }

  .cost-table { width: 100%; border-collapse: collapse; margin-bottom: 16px; font-size: 14px; }
  .cost-table th, .cost-table td { padding: 9px 10px; border-bottom: 1px solid var(--color-border-soft); text-align: left; }
  .cost-table th { background: var(--color-cream); color: var(--color-charcoal-dark); font-weight: 600; font-size: 13px; letter-spacing: 0.04em; }

  .page-cta { max-width: 760px; margin-top: 64px; padding: 36px 32px; background: var(--color-charcoal-dark); color: var(--color-cream); }
  .page-cta h2 { font-family: var(--font-display); font-size: 26px; font-weight: 600; margin-bottom: 12px; color: var(--color-cream); }
  .page-cta p { font-size: 15px; line-height: 1.55; margin-bottom: 20px; color: var(--color-cream-warm); }
  .page-cta-btn { display: inline-flex; align-items: center; gap: 12px; padding: 14px 22px; background: var(--color-copper-text); color: var(--color-charcoal-dark); font-size: 14px; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; text-decoration: none; transition: transform 0.2s, background 0.2s; }
  .page-cta-btn:hover { transform: translateY(-2px); background: #d18a3f; }
  .page-cta-note { font-size: 12px; color: var(--color-cream-warm); margin-top: 16px; margin-bottom: 0; opacity: 0.8; }

  .related-block { max-width: 760px; margin-top: 64px; padding-top: 48px; border-top: 1px solid var(--color-border-medium); }
  .related-block h3 { font-family: var(--font-display); font-size: 22px; font-weight: 600; margin-bottom: 20px; color: var(--color-text-primary); }
  .related-block ul { list-style: none; padding: 0; margin: 0; }
  .related-block li { padding: 10px 0 10px 20px; border-bottom: 1px solid var(--color-border-soft); position: relative; }
  .related-block li::before { content: "→"; position: absolute; left: 0; color: var(--color-copper-text); font-weight: 600; }
  .related-block a { color: var(--color-text-primary); text-decoration: none; font-size: 16px; transition: color 0.2s; }
  .related-block a:hover { color: var(--color-copper-text); }

  @media (max-width: 768px) {
    .article-header h1 { font-size: 44px; }
    .content-section h2 { font-size: 26px; }
    .content-section p, .bullet-list li { font-size: 16px; }
    .cost-table { font-size: 12px; }
    .cost-table th, .cost-table td { padding: 6px 8px; }
    .page-cta { padding: 28px 24px; }
  }

  /* Consistente list-markers — lijsten moeten als lijst leesbaar zijn (auditor) */
  .bullet-list, .pitfall-list { padding-left: 0; }
  .bullet-list li, .pitfall-list li { display: flex; gap: 12px; align-items: baseline; }
  .bullet-list li::before, .pitfall-list li::before { content: "\2192"; color: var(--color-copper-text); font-weight: 600; flex-shrink: 0; }

  /* Verder-lezen links zichtbaar als links (auditor: UI) */
  .related a, .related-block a { color: var(--color-copper-text); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .related a:hover, .related-block a:hover { color: var(--color-charcoal-dark); }

  /* Beschikbaarheids-badges — kleur-ritme in de datatabellen */
  .aanbod-badge { display: inline-block; padding: 3px 11px; font-size: 12px; font-weight: 600; letter-spacing: 0.02em; white-space: nowrap; }
  .aanbod-badge.is-ruim { background: var(--color-copper-text); color: var(--color-cream); }
  .aanbod-badge.is-regelmatig { background: rgba(154, 94, 40, 0.14); color: var(--color-copper-text); }
  .aanbod-badge.is-incidenteel { background: var(--color-cream-warm); color: var(--color-text-secondary); border: 1px solid var(--color-border-medium); }
  .aanbod-badge.is-schaars { background: transparent; color: var(--color-text-tertiary); border: 1px solid var(--color-border-medium); }
</style>
