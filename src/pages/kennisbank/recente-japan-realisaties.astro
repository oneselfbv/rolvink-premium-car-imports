---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AuthorByline from '../../components/AuthorByline.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Kennisbank', url: '/kennisbank' },
  { name: 'Recente Japan-realisaties' },
];

const publishedDate = '2026-05-29';
const updatedDate = '2026-05-29';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Recente Japan-realisaties — verified LHD-aanbod per merk',
  description: 'Geanonimiseerde snapshot van actueel LHD grade 4+ aanbod op Japanse veilingen binnen onze scope: Mercedes-Benz, BMW, Audi en Porsche. Verified data, geen marketing-schattingen.',
  datePublished: publishedDate,
  dateModified: updatedDate,
  author: { '@type': 'Person', name: 'Theo Rolvink', url: 'https://www.rolvinkpremiumcarimports.nl/over/' },
  publisher: { '@type': 'Organization', name: 'Rolvink Premium Car Imports', logo: { '@type': 'ImageObject', url: 'https://www.rolvinkpremiumcarimports.nl/favicon.svg' } },
  mainEntityOfPage: { '@type': 'WebPage', '@id': 'https://www.rolvinkpremiumcarimports.nl/kennisbank/recente-japan-realisaties/' },
  image: 'https://www.rolvinkpremiumcarimports.nl/og-image.jpg',
};

// Verified LHD grade 4+ live aanbod, snapshot 2026-05-29 via Pacific Coast JDM /auctions/
const snapshot = {
  totalLHD: 140,
  byBrand: [
    { brand: 'Mercedes-Benz', count: 90, share: 64 },
    { brand: 'Porsche', count: 28, share: 20 },
    { brand: 'BMW', count: 21, share: 15 },
    { brand: 'Audi', count: 1, share: '<1' },
  ],
};

const mercedesBreakdown = [
  { model: 'S-Klasse (W221/W222)', count: 20, jaarrange: '2001-2021', grades: '4 / 4.5 / 5' },
  { model: 'E-Klasse sedan (W211/W212/W213)', count: 12, jaarrange: '1995-2021', grades: '4 / 4.5' },
  { model: 'AMG G-Klasse', count: 7, jaarrange: '2004-2017', grades: '4 / 4.5' },
  { model: 'G-Klasse', count: 7, jaarrange: '1998-2024', grades: '4 / 4.5 / 5' },
  { model: 'CL-Klasse (W215/W216)', count: 5, jaarrange: '2005-2013', grades: '4 / 4.5' },
  { model: 'GLK-Klasse (X204)', count: 5, jaarrange: '2011-2015', grades: '4' },
  { model: 'CLS (W219/W218/C257)', count: 5, jaarrange: '2007-2021', grades: '4 / 4.5' },
  { model: 'SL (R230/R231)', count: 4, jaarrange: '1999-2013', grades: '4 / 4.5' },
  { model: 'AMG CLS', count: 4, jaarrange: '2011-2013', grades: '4 / 4.5' },
  { model: 'C-Klasse', count: 4, jaarrange: '2000-2015', grades: '4 / 4.5' },
  { model: 'Mercedes-AMG (GLE53 etc)', count: 2, jaarrange: '2021', grades: '4.5' },
  { model: 'GL-Klasse (X166)', count: 2, jaarrange: '2013', grades: '4' },
  { model: 'E-Klasse Estate (S212/S213)', count: 2, jaarrange: '2012-2018', grades: '4 / 4.5' },
  { model: 'Maybach', count: 1, jaarrange: '2017', grades: '4' },
];

const porscheBreakdown = [
  { model: '911 (964/993/996/997/991/992)', count: 11, jaarrange: '1992-2025', notes: 'Sterk verdeeld over alle generaties' },
  { model: 'Cayenne', count: 7, jaarrange: '2009-2012', notes: 'Turbo / S Hybrid / GTS' },
  { model: 'Boxster (986/987)', count: 5, jaarrange: '2002-2009', notes: 'M96/M97-IMS aandacht voor 996/997 pendanten' },
  { model: 'Panamera', count: 2, jaarrange: '2012-2013', notes: 'Base + 4S' },
  { model: 'Cayman 987', count: 1, jaarrange: '2009', notes: 'Cayman S 3.4L' },
  { model: '718 Boxster', count: 1, jaarrange: '2017+', notes: 'IMS-vrij 9A1-platform' },
  { model: 'Overig', count: 1, jaarrange: '—', notes: '—' },
];

const highlights = [
  { lot: '38015', auction: 'CAA Tokyo', date: '2026-06-02', merk: 'Mercedes-Benz', model: 'E-Klasse', uitvoering: 'E300 4MATIC (213080C)', jaar: 2016, km: '44.000', grade: '4' },
  { lot: '5022', auction: 'TAA Kinki', date: '2026-06-02', merk: 'Mercedes-Benz', model: 'CL', uitvoering: 'CL550 BlueEFFICIENCY Grand Edition', jaar: 2013, km: '87.000', grade: '4.5' },
  { lot: '607', auction: 'ZIP Tokyo', date: '2026-05-30', merk: 'Mercedes-Benz', model: 'Mercedes-AMG GLE', uitvoering: 'GLE 53 4MATIC+ Coupé', jaar: 2021, km: '43.000', grade: '4.5' },
  { lot: '20233', auction: 'USS Nagoya', date: '2026-05-30', merk: 'Porsche', model: '911 (992)', uitvoering: 'Carrera T', jaar: 2025, km: '0', grade: '5' },
  { lot: '20213', auction: 'USS Nagoya', date: '2026-05-30', merk: 'Porsche', model: '911 (993)', uitvoering: 'Carrera S', jaar: 1997, km: '46.000', grade: '4.5' },
  { lot: '83165', auction: 'USS Kyushu', date: '2026-05-30', merk: 'Porsche', model: '911 (991)', uitvoering: 'Carrera 4S', jaar: 2017, km: '28.000', grade: '4.5' },
  { lot: '13376', auction: 'USS Nagoya', date: '2026-05-30', merk: 'Porsche', model: '911 (992)', uitvoering: 'Carrera GTS', jaar: 2025, km: '3.000', grade: '4.5' },
];
---

<BaseLayout
  title="Recente Japan-realisaties — verified LHD-aanbod per merk | Rolvink"
  description="Geanonimiseerde snapshot van het actuele LHD grade 4+ aanbod op de Japanse veilingen voor Mercedes, BMW, Audi en Porsche. Verified data, geen marketing-schatting."
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} slot="head" />

  <article class="cornerstone-page">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />

      <header class="article-header">
        <div class="section-eyebrow">Marktdata — Japan</div>
        <h1>Recente <span class="accent">Japan-realisaties</span>.</h1>
        <p class="lead">Wat is er feitelijk op dit moment beschikbaar in Japan in LHD grade 4 of hoger binnen onze sourcing-scope? Hieronder een geanonimiseerde snapshot van 140 verified records — geen marketing-schattingen, geen "vanaf"-prijzen. Wat de Japanse veilingen daadwerkelijk te bieden hebben, per merk doorgerekend.</p>
        <div class="article-meta">
          <time datetime={publishedDate}>Gepubliceerd 29 mei 2026</time>
          {publishedDate !== updatedDate && (
            <>
              <span>·</span>
              <time datetime={updatedDate}>Bijgewerkt {new Date(updatedDate).toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
            </>
          )}
        </div>
      </header>

      <AuthorByline variant="top" />

      <div class="disclaimer">
        <strong>Bronvermelding:</strong> snapshot 29 mei 2026 via Pacific Coast JDM auction-platform, filter "Left Hand Drive" + "Scores 4 / 4.5 / 5 / 6" (onze grade 4+ ondergrens) per scope-merk. Geen kortere ondergrens, geen R/RA/A/X-classificaties, geen RHD-uitvoeringen. Dit is een live-aanbod-snapshot, geen historische verkooplijst — hammerprijzen volgen na realisatie. Voor verkooppijzen reken op een landed-cost typisch 75-90% boven hamer (zie <a href="/kennisbank/auto-importeren-japan/">complete kosten-uitleg</a>). Aantallen wijzigen wekelijks; deze pagina wordt maandelijks ververst.
      </div>

      <nav class="toc" aria-label="Inhoud">
        <h2>In dit overzicht</h2>
        <ol>
          <li><a href="#totaal">Totaaloverzicht — 140 LHD records binnen scope</a></li>
          <li><a href="#mercedes">Mercedes-Benz — 90 records per modellijn</a></li>
          <li><a href="#porsche">Porsche — 28 records per generatie</a></li>
          <li><a href="#bmw">BMW — 21 records</a></li>
          <li><a href="#audi">Audi — 1 record</a></li>
          <li><a href="#highlights">Notable highlights uit huidige snapshot</a></li>
          <li><a href="#hoe-lezen">Hoe deze cijfers te lezen</a></li>
        </ol>
      </nav>

      <section id="totaal" class="content-section">
        <h2>Totaaloverzicht — 140 LHD records binnen scope</h2>
        <p>Per scope-merk de verdeling van het LHD grade 4+ aanbod vandaag op de Japanse veilingen:</p>
        <table class="cost-table">
          <thead>
            <tr><th>Merk</th><th>LHD grade 4+</th><th>Verhouding</th></tr>
          </thead>
          <tbody>
            {snapshot.byBrand.map((b) => (
              <tr>
                <td>{b.brand}</td>
                <td>{b.count}</td>
                <td>{b.share}%</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p>Mercedes domineert met 64% — meer dan de andere drie merken samen. Porsche heeft een gezond aanbod over alle 911-generaties heen. BMW levert beperkter maar consistent — vooral 5-Serie en M-segment. Audi is met één record praktisch nul; voor Audi-sourcing is Duitsland onze enige realistische route.</p>
      </section>

      <section id="mercedes" class="content-section">
        <h2>Mercedes-Benz — 90 LHD grade 4+ records</h2>
        <p>Mercedes is verreweg de grootste LHD-pool. Notabel: <strong>S-Klasse is met 20 records de grootste enkele modellijn</strong>, voor E-Klasse (12). Een aanname-correctie ten opzichte van eerder werk — onze focus voor klanten lag op E-Klasse, maar S-Klasse biedt feitelijk meer keuze.</p>
        <table class="cost-table">
          <thead>
            <tr><th>Model</th><th>LHD-aanbod (n)</th><th>Bouwjaarrange</th><th>Grades</th></tr>
          </thead>
          <tbody>
            {mercedesBreakdown.map((m) => (
              <tr>
                <td>{m.model}</td>
                <td>{m.count}</td>
                <td>{m.jaarrange}</td>
                <td>{m.grades}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p>Een tweede aanname-correctie: <strong>E-Klasse Estate LHD bestaat wel</strong>. Twee records deze maand (W212 + W213 generatie). Eerder gecommuniceerd als "praktisch nul" — nauwkeuriger is "extreem schaars maar incidenteel beschikbaar". Voor specifieke wensen kan een station via Japan dus wél, met de geduldfactor die daar bij hoort. SL R230/R231 staat met 4 records lager dan eerder geschat (in de range van 4-6 per maand bij grade 4+ discipline, lager dan inclusieve cijfers met grade 3.5). Voor de bredere context: <a href="/merk/mercedes-benz/">onze Mercedes-focus</a> en de <a href="/kennisbank/mercedes-e-klasse-w212/">E-Klasse W212 koopgids</a>.</p>
      </section>

      <section id="porsche" class="content-section">
        <h2>Porsche — 28 LHD grade 4+ records</h2>
        <p>Porsche is op aanbod per maand de meest spreid-rijke groep — 11 911's verdeeld over alle generaties van 964 (1992) tot 992 (2025), plus Cayenne, Boxster, Cayman en Panamera. Voor de breedste 911-keuze in LHD is Japan structureel de logische bron:</p>
        <table class="cost-table">
          <thead>
            <tr><th>Model</th><th>LHD-aanbod (n)</th><th>Bouwjaarrange</th><th>Notes</th></tr>
          </thead>
          <tbody>
            {porscheBreakdown.map((p) => (
              <tr>
                <td>{p.model}</td>
                <td>{p.count}</td>
                <td>{p.jaarrange}</td>
                <td>{p.notes}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p>Voor de IMS-discussie bij 996/997.1 — niet relevant voor de 9A1-aandrijflijn vanaf 997.2 — zie de complete <a href="/kennisbank/porsche-ims-lager-996-997/">IMS-koopgids</a>. Voor het volledige 911-overzicht: <a href="/kennisbank/porsche-911-modelgids/">modelgids vijf generaties</a>. Voor een doorgerekende landed-cost vergelijking JP vs DE op deze 997.2: <a href="/kennisbank/porsche-997-2-japan-vs-duitsland/">de cost-vergelijking</a>.</p>
      </section>

      <section id="bmw" class="content-section">
        <h2>BMW — 21 LHD grade 4+ records</h2>
        <p>BMW-LHD aanbod is gecompresseerd. Onder de 21 records zien wij vooral 5-Serie sedan (E60/F10/G30), M-segment (M3 F80, M4 F82, M5 F10/F90), 6-Serie coupé F12/F13 en incidenteel X5/X6 M. Volume is voldoende voor klanten met een specifieke uitvoeringswens; voor mainstream 530i / 540i / 730i is Duitsland sneller. Onze brede BMW-focus: <a href="/merk/bmw/">/merk/bmw</a>. Voor de 5-Serie F10/G30: <a href="/kennisbank/bmw-5-serie-f10-g30/">koopgids</a>.</p>
      </section>

      <section id="audi" class="content-section">
        <h2>Audi — 1 LHD grade 4+ record</h2>
        <p>Eén verified LHD-Audi grade 4+ in heel mei 2026 binnen scope. Dit bevestigt expliciet wat onze <a href="/kennisbank/audi-quattro-rs-koopgids/">Audi quattro &amp; RS koopgids</a> stelt: voor Audi is Duitsland structureel de logische bron. RS3 / RS4 / RS6 / RS Q8 kunnen incidenteel via Japan komen — maar één eenheid per maand is geen pijplijn, het is een uitzondering. Voor een RS-zoekopdracht: persoonlijke bezichtiging in Duitsland binnen 2-4 weken, of een Japan-watchlist voor een geduldig project zonder einddatum.</p>
      </section>

      <section id="highlights" class="content-section">
        <h2>Notable highlights uit huidige snapshot</h2>
        <p>Een selectie uit de 140 records die opvallen door lage kilometerstanden, sterke uitvoering of zeldzaamheid:</p>
        <table class="cost-table">
          <thead>
            <tr><th>Merk</th><th>Model</th><th>Uitvoering</th><th>Jaar</th><th>Km</th><th>Grade</th><th>Auction</th></tr>
          </thead>
          <tbody>
            {highlights.map((h) => (
              <tr>
                <td>{h.merk}</td>
                <td>{h.model}</td>
                <td>{h.uitvoering}</td>
                <td>{h.jaar}</td>
                <td>{h.km}</td>
                <td>{h.grade}</td>
                <td>{h.auction}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p>De 911 992 Carrera T uit 2025 met 0 km grade 5 — een nieuw exemplaar via veiling — is een ongewone vondst. De 911 993 Carrera S uit 1997 met 46.000 km grade 4.5 is een typisch Japan-aanbod-voorbeeld: een 28-jaar-oude air-cooled klassieker in conditie die in Europa zelden voorkomt. De Mercedes-AMG GLE 53 4MATIC+ Coupé uit 2021 met 43.000 km is een moderne SUV-AMG die in Duitsland boven € 75.000 wordt aangeboden — interessante vergelijkingscase voor importanalyse.</p>
      </section>

      <section id="hoe-lezen" class="content-section">
        <h2>Hoe deze cijfers te lezen</h2>
        <ul class="bullet-list">
          <li><strong>"Aanbod" betekent live veilinglisting — geen verkocht.</strong> Wat hier staat is wat momenteel in de komende dagen onder de hamer komt. Hammerprijzen zijn nog niet bekend; de uiteindelijke landed cost wordt pas duidelijk na verkoop. Voor de complete kosten-doorrekening: <a href="/kennisbank/auto-importeren-japan/">Japan-import-gids</a> en <a href="/voorbeeld-traject/">voorbeeld-traject W212</a>.</li>
          <li><strong>Grade 4 of hoger is onze ondergrens.</strong> Alles met conditie 3.5 of lager filteren wij weg, evenals R / RA / A / X-classificaties. Wat hier staat is dus al de bovenste laag van het Japanse aanbod, niet het gehele veilingvolume.</li>
          <li><strong>LHD is gefilterd via Pacific Coast's "Left Hand Drive" checkbox.</strong> Dit zijn dus geen schattingen op chassis-code maar bevestigde linksgestuurde uitvoeringen. Voor de achtergrond hoe LHD wordt geïdentificeerd: <a href="/kennisbank/lhd-rhd-groene-markering/">LHD versus RHD bij Japanse veilingen</a>.</li>
          <li><strong>Dit is één bron — niet het complete Japanse aanbod.</strong> Pacific Coast aggregeert USS, JU, JAA, CAA, ARAI, TAA, ZIP en BAYAUC. JCD en andere broker-platforms hebben overlap, maar kunnen ook unieke listings tonen. Voor maximaal bereik combineert onze sourcing meerdere bronnen.</li>
          <li><strong>Snapshot ouderdom telt.</strong> Veilinglisting wijzigt wekelijks. Deze pagina wordt maandelijks bijgewerkt. Voor real-time data op uw specifieke zoekopdracht: <a href="/contact/">vraag een intake-gesprek</a>.</li>
        </ul>
        <p>Voor de complete proces-uitleg: <a href="/kennisbank/auto-importeren-japan/">Japan-import-cornerstone</a>. Voor de directe afweging Japan vs Duitsland: <a href="/route-advies/">route-advies-tool</a>. Voor onze sourcing-tarieven: <a href="/tarieven/">/tarieven</a>.</p>
      </section>

      <AuthorByline variant="bottom" />

      <div class="page-cta">
        <h2>Op zoek naar een specifieke uitvoering?</h2>
        <p>Vertel ons merk, model, uitvoering en budget. Wij screenen wekelijks meerdere Japanse veilingbronnen plus de Duitse markt en geven u realistische landed-cost-prognoses op basis van actuele markt­data — niet op basis van marketing-tabellen.</p>
        <a href="/contact" class="page-cta-btn">
          Plan intake-gesprek
          <span class="arrow" aria-hidden="true">→</span>
        </a>
        <p class="page-cta-note">Binnen 24 uur reactie · Geen verkoopdruk</p>
      </div>

      <div class="related-block">
        <h3>Verder lezen</h3>
        <ul>
          <li><a href="/kennisbank/auto-importeren-japan/">Auto importeren uit Japan — complete gids</a></li>
          <li><a href="/kennisbank/japanse-veiling-grades/">Japanse auction grades uitgelegd</a></li>
          <li><a href="/kennisbank/japanse-auction-sheet-lezen/">Japanse auction sheet lezen — complete gids</a></li>
          <li><a href="/kennisbank/lhd-rhd-groene-markering/">LHD versus RHD bij Japanse veilingen</a></li>
          <li><a href="/kennisbank/bpm-importauto-2026/">BPM voor importauto's — gids 2026</a></li>
          <li><a href="/kennisbank/porsche-997-2-japan-vs-duitsland/">997.2 — Japan vs Duitsland cost-vergelijking</a></li>
          <li><a href="/voorbeeld-traject/">Voorbeeld-traject W212 — volledig doorgerekend</a></li>
          <li><a href="/route-advies/">Route-advies — Japan of Duitsland?</a></li>
        </ul>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .cornerstone-page { padding: 64px 0 96px; }
  .article-header { max-width: 760px; margin-bottom: 32px; }
  .article-header h1 { font-family: var(--font-serif); font-size: 64px; font-weight: 500; letter-spacing: 0.02em; margin: 16px 0 24px; line-height: 1.05; }
  .article-header .lead { font-size: 19px; color: var(--color-text-secondary); line-height: 1.6; margin-bottom: 24px; }
  .article-meta { font-size: 13px; color: var(--color-text-tertiary); display: flex; gap: 8px; }

  .disclaimer { max-width: 800px; padding: 18px 22px; margin-bottom: 48px; background: var(--color-cream-warm); border-left: 3px solid var(--color-copper); font-size: 14px; line-height: 1.6; color: var(--color-text-secondary); }
  .disclaimer strong { color: var(--color-charcoal-dark); }
  .disclaimer a { color: var(--color-copper); }

  .toc { max-width: 760px; margin-bottom: 56px; padding: 24px 28px; background: var(--color-cream); border-left: 3px solid var(--color-copper); }
  .toc h2 { font-size: 14px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-copper); margin-bottom: 14px; font-weight: 600; }
  .toc ol { margin: 0; padding-left: 20px; }
  .toc li { padding: 4px 0; font-size: 15px; }
  .toc a { color: var(--color-text-primary); text-decoration: none; }
  .toc a:hover { color: var(--color-copper); text-decoration: underline; }

  .content-section { max-width: 900px; margin-bottom: 56px; }
  .content-section h2 { font-family: var(--font-display); font-size: 32px; font-weight: 600; margin-bottom: 20px; letter-spacing: -0.01em; }
  .content-section p { font-size: 17px; line-height: 1.65; color: var(--color-text-primary); margin-bottom: 18px; }
  .content-section a { color: var(--color-copper); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }

  .bullet-list { padding-left: 20px; margin-bottom: 18px; }
  .bullet-list li { font-size: 17px; line-height: 1.65; color: var(--color-text-primary); margin-bottom: 12px; }
  .bullet-list li strong { color: var(--color-charcoal-dark); }

  .cost-table { width: 100%; border-collapse: collapse; margin-bottom: 16px; font-size: 14px; }
  .cost-table th, .cost-table td { padding: 9px 10px; border-bottom: 1px solid var(--color-border-soft); text-align: left; }
  .cost-table th { background: var(--color-cream); color: var(--color-charcoal-dark); font-weight: 600; font-size: 13px; letter-spacing: 0.04em; }

  .page-cta { max-width: 760px; margin-top: 64px; padding: 36px 32px; background: var(--color-charcoal-dark); color: var(--color-cream); }
  .page-cta h2 { font-family: var(--font-display); font-size: 26px; font-weight: 600; margin-bottom: 12px; color: var(--color-cream); }
  .page-cta p { font-size: 15px; line-height: 1.55; margin-bottom: 20px; color: var(--color-cream-warm); }
  .page-cta-btn { display: inline-flex; align-items: center; gap: 12px; padding: 14px 22px; background: var(--color-copper); color: var(--color-charcoal-dark); font-size: 14px; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; text-decoration: none; transition: transform 0.2s, background 0.2s; }
  .page-cta-btn:hover { transform: translateY(-2px); background: #d18a3f; }
  .page-cta-note { font-size: 12px; color: var(--color-cream-warm); margin-top: 16px; margin-bottom: 0; opacity: 0.8; }

  .related-block { max-width: 760px; margin-top: 64px; padding-top: 48px; border-top: 1px solid var(--color-border-medium); }
  .related-block h3 { font-family: var(--font-display); font-size: 22px; font-weight: 600; margin-bottom: 20px; color: var(--color-text-primary); }
  .related-block ul { list-style: none; padding: 0; margin: 0; }
  .related-block li { padding: 10px 0 10px 20px; border-bottom: 1px solid var(--color-border-soft); position: relative; }
  .related-block li::before { content: "→"; position: absolute; left: 0; color: var(--color-copper); font-weight: 600; }
  .related-block a { color: var(--color-text-primary); text-decoration: none; font-size: 16px; transition: color 0.2s; }
  .related-block a:hover { color: var(--color-copper); }

  @media (max-width: 768px) {
    .article-header h1 { font-size: 44px; }
    .content-section h2 { font-size: 26px; }
    .content-section p, .bullet-list li { font-size: 16px; }
    .cost-table { font-size: 12px; }
    .cost-table th, .cost-table td { padding: 6px 8px; }
    .page-cta { padding: 28px 24px; }
  }
</style>
