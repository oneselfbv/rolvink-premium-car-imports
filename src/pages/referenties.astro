---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Referenties' },
];
---

<BaseLayout
  title="Referenties — Rolvink Premium Car Imports"
  description="Klantverhalen en geleverde sourcing-trajecten van Rolvink Premium Car Imports."
  noIndex={true}
>
  <section class="referenties-page">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />

      <div class="section-eyebrow">Referenties</div>
      <h1>Eerste klantverhalen <span class="accent">volgen</span>.</h1>
      <p class="lead">Op deze pagina komen straks de geleverde sourcing-trajecten — met toestemming van de klant, foto's van de auto, het auctie-sheet of dealer-rapport, de doorlooptijd, en wat we onderweg tegenkwamen.</p>

      <div class="manifesto">
        <p>Een referentie-pagina vooraf vullen met fictieve cases of vage "voorbeelden" past niet bij hoe wij werken. Pas wanneer we een traject van begin tot eind hebben afgerond en de klant tevreden zijn auto in handen heeft, vragen we toestemming om het verhaal hier te delen — uitgewerkt, eerlijk en met foto's.</p>
        <p>Tot die tijd is dit een eerlijke witte plek.</p>
      </div>

      <div class="cta-row">
        <a href="/werkwijze" class="cta-secondary">Bekijk de werkwijze</a>
        <a href="/contact" class="cta">Start uw zoekopdracht<span class="arrow">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .referenties-page { padding: 64px 0 96px; }
  .referenties-page h1 {
    font-size: 64px;
    font-weight: 600;
    margin-bottom: 24px;
    line-height: 1.05;
  }
  .lead {
    font-size: 18px;
    color: var(--color-text-secondary);
    max-width: 640px;
    margin-bottom: 56px;
    line-height: 1.6;
  }
  .manifesto {
    max-width: 680px;
    padding: 40px 0;
    border-top: 1px solid var(--color-border-medium);
    border-bottom: 1px solid var(--color-border-medium);
    margin-bottom: 56px;
  }
  .manifesto p {
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 1.45;
    color: var(--color-text-primary);
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: 20px;
  }
  .manifesto p:last-child {
    margin-bottom: 0;
    color: var(--color-copper-text);
    font-style: italic;
    font-size: 19px;
  }
  .cta-row {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    align-items: center;
  }

  @media (max-width: 768px) {
    .referenties-page h1 { font-size: 40px; }
    .manifesto p { font-size: 18px; }
  }
</style>
