---
import BaseLayout from '../layouts/BaseLayout.astro';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://www.rolvinkpremiumcarimports.nl/over#theo',
  name: 'Theo Rolvink',
  jobTitle: 'Oprichter & Sourcing-consultant',
  worksFor: {
    '@type': 'Organization',
    '@id': 'https://www.rolvinkpremiumcarimports.nl/#organization',
    name: 'Rolvink Premium Car Imports',
  },
  knowsAbout: [
    'BMW',
    'Mercedes-Benz',
    'Audi',
    'Porsche',
    'Vehicle import',
    'BPM',
    'RDW-keuring',
    'Japanese auto auctions',
    'USS auction inspection',
    'JU auction',
    'JAA auction',
    'Sourcing',
    'Motoren',
    'Youngtimer'
  ],
  url: 'https://www.rolvinkpremiumcarimports.nl/over',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Welsum',
    addressRegion: 'Overijssel',
    addressCountry: 'NL',
  },
  nationality: { '@type': 'Country', name: 'Netherlands' },
  description: 'Oprichter van Rolvink Premium Car Imports, een persoonlijke sourcing-consultancy voor Duitse premium-autos uit Europa en Japan. Jarenlange ervaring in de in- en verkoop van bijzondere autos en motoren.',
};
---

<BaseLayout
  title="Over Theo Rolvink — Rolvink Premium Car Imports"
  description="Persoonlijke sourcing-consultancy voor Duitse premium-auto's. Jarenlange ervaring in de in- en verkoop van bijzondere voertuigen, vanuit Welsum."
>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} slot="head" />

  <section class="over-page">
    <div class="container">
      <div class="section-eyebrow">Over</div>
      <h1>Theo Rolvink</h1>
      <p class="lead">Een persoonlijke sourcing-consultancy is per definitie afhankelijk van de persoon. Hier het verhaal.</p>

      <article class="prose">
        <p>Mijn passie voor premium auto's en motoren is geen recente keuze, maar een rode draad die al jarenlang door mijn leven loopt. Ik heb in die jaren <strong>uitgebreide ervaring opgebouwd met de in- en verkoop van bijzondere voertuigen</strong> — altijd met een focus op kwaliteit, uitvoering en historie. Wat begon als een persoonlijke obsessie voor techniek en esthetiek, is uitgegroeid tot Rolvink Premium Car Imports.</p>

        <p>Het idee achter het bedrijf is bewust kleinschalig. Niet zoveel mogelijk auto's leveren, maar het <em>juiste</em> exemplaar vinden voor de juiste eigenaar. Geen massa-import, geen snelle handel, geen volume-druk. Wel: een persoonlijke sourcing-aanpak waarin selectie, transparantie en geduld centraal staan.</p>

        <p>Vanuit Welsum (gemeente Olst-Wijhe) werk ik als onafhankelijk import-consultant. Mijn netwerk in Duitsland en directe lijnen met de grote Japanse veilinghuizen — <strong>USS, JU en JAA</strong> — vormen de basis voor elke zoekopdracht. Beide bronmarkten kennen hun eigen sterktes: Duitsland voor het volledige modelspectrum en snelle doorlooptijd, Japan voor performance-uitvoeringen, klassiekers en lage-km exemplaren. In het intake-gesprek bepalen we samen welke route past bij wat u zoekt.</p>

        <h2>Wat u krijgt</h2>

        <p>Persoonlijke begeleiding van eerste gesprek tot levering aan huis. Transparantie over elke kostenpost — geen verborgen marges. Eerlijke beoordeling van wat een specifieke uitvoering werkelijk waard is en welke valkuilen ik zie per modelreeks. Een directe lijn met mij, geen call-center, geen tussenpersonen.</p>

        <h2>Hoe ik selecteer</h2>

        <p>Bij elke kandidaat-auto kijk ik naar dezelfde criteria: <strong>volledige onderhoudshistorie</strong>, <strong>kilometerstand consistent met service-stempels</strong>, <strong>geen bekende schade- of herstelhistorie</strong> (geen R/RA/A/X-codes op Japanse veiling-sheets, geen <em>Unfallfahrzeug</em>-notitie op Duitse rapporten), en bekende zwakke punten per modelgeneratie expliciet doorgechecked. Onder grade 4 op de Japanse veilingschaal komt geen auto in mijn aanbod — daaronder nemen risico's op verborgen issues exponentieel toe.</p>

        <h2>Wat ik niet ben</h2>

        <p>Geen volume-handelaar. Geen occasion-dealer met haast-opdrachten. Geen import-portal waar honderden auto's door elkaar staan zonder selectie of context. Wel iemand die obsessief research doet, transparant communiceert, en alleen voertuigen aanraakt die door mij persoonlijk zijn beoordeeld.</p>

        <p>Onze service is op afspraak — geen showroom, geen druk, geen verkoopgesprek. Zo krijgt elke zoekopdracht de onverdeelde aandacht die het verdient.</p>

        <p>De rest is een gesprek waard.</p>

        <p class="signature">— Theo Rolvink, Welsum</p>
      </article>

      <div style="margin-top: 64px;">
        <a href="/contact" class="cta">Plan een gesprek<span class="arrow">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .over-page { padding: 80px 0 80px; }
  .over-page h1 { font-family: var(--font-serif); font-size: 88px; font-weight: 500; letter-spacing: 0.04em; margin-bottom: 16px; }
  .lead { font-size: 19px; color: var(--color-text-secondary); max-width: 640px; margin-bottom: 56px; line-height: 1.5; font-style: italic; font-family: 'EB Garamond', serif; font-size: 22px; }
  .prose { max-width: 680px; }
  .prose p { font-size: 17px; line-height: 1.7; color: var(--color-text-primary); margin-bottom: 24px; }
  .prose h2 { font-size: 28px; margin: 48px 0 16px; font-weight: 600; }
  .prose strong { font-weight: 600; color: var(--color-charcoal-dark); }
  .prose em { font-style: italic; }
  .signature { font-family: var(--font-serif); font-size: 16px; color: var(--color-copper); margin-top: 40px; letter-spacing: 0.04em; }

  @media (max-width: 768px) {
    .over-page h1 { font-size: 56px; }
  }
</style>
