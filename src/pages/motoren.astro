---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbs = [{ name: 'Home', url: '/' }, { name: 'Motoren' }];

const modellen = [
  { href: '/kennisbank/bmw-r1300gs-koopgids', title: 'R 1300 GS', tag: 'Adventure · 2023+', desc: 'De nieuwste GS met 1300 ShiftCam-boxer. Grootste euro-voordeel.' },
  { href: '/kennisbank/bmw-r1250gs-koopgids', title: 'R 1250 GS', tag: 'Adventure · 2019-2024', desc: 'Het volumemodel. ShiftCam-boxer, ~€5.000 voordeel uit Duitsland.' },
  { href: '/kennisbank/bmw-r1150gs-koopgids', title: 'R 1150 GS', tag: 'Klassiek · 1999-2005', desc: 'De oilhead-klassieker. Let op de Integral ABS servorem.' },
  { href: '/kennisbank/bmw-rninet-koopgids', title: 'R nineT', tag: 'Modern classic', desc: 'De laatste lucht/oliegekoelde boxer. Customizing-icoon.' },
  { href: '/kennisbank/bmw-s1000-koopgids', title: 'S 1000 RR / XR / R', tag: 'Sport', desc: 'De viercilinder superbike-familie: RR, adventure-sport XR en roadster R.' },
  { href: '/kennisbank/bmw-k1600-koopgids', title: 'K 1600 GT / GTL', tag: 'Luxe tourer', desc: 'De fluwelen zescilinder. Niche met trouwe kopers en mooie marge.' },
  { href: '/kennisbank/bmw-f850gs-f750gs-koopgids', title: 'F 750 / 850 / 900 GS', tag: 'Middensegment', desc: 'De toegankelijke GS met tweecilinder. Lichter en betaalbaarder.' },
  { href: '/kennisbank/bmw-r80-r100-airhead-koopgids', title: 'R 80 / R 100 airhead', tag: 'Collector', desc: 'De luchtgekoelde klassiekers. R 80 G/S vond het adventure-genre uit.' },
];
const gidsen = [
  { href: '/kennisbank/bmw-motor-importeren-duitsland', title: 'Importeren uit Duitsland', desc: 'Prijzen per model, het proces en waarom Duitsland de bron is.' },
  { href: '/kennisbank/bmw-motoren-prijspeiling-2026', title: 'Prijspeiling DE vs NL', desc: 'Live prijsvergelijking per modelfamilie (juni 2026).' },
  { href: '/kennisbank/motor-bpm-importeren', title: 'Motor-BPM', desc: 'Waarom motor-BPM veel lager is dan auto-BPM.' },
  { href: '/kennisbank/bmw-boxermotoren-gids', title: 'Boxermotoren techniekgids', desc: 'Van airhead tot ShiftCam, met zwakke punten per generatie.' },
  { href: '/kennisbank/bmw-k-serie-motoren-gids', title: 'K-serie techniekgids', desc: 'Van flying brick tot de zescilinder K 1600.' },
  { href: '/kennisbank/faq-motor-importeren', title: 'FAQ motoren', desc: 'De meest gestelde vragen, kort beantwoord.' },
];
---
<BaseLayout
  title="BMW-motoren importeren uit Duitsland — Rolvink Premium Imports"
  description="Persoonlijke sourcing van BMW-motoren uit Duitsland: van R 1250 GS tot klassieke airhead. Groot aanbod, lage motor-BPM, hele import geregeld tot NL-kenteken."
>
  <section class="moto-page">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />
      <div class="section-eyebrow">Nieuw — Motoren</div>
      <h1>BMW-motoren importeren uit <span class="accent">Duitsland</span>.</h1>
      <p class="lead">Duitsland heeft de grootste tweedehands-motormarkt van Europa — meer keuze, scherpere prijzen en op recente BMW's een voordeel tot circa €5.000. Wij sourcen de juiste motor, beoordelen de modelspecifieke zwakke punten, en regelen de hele import tot Nederlands kenteken. Met 35 jaar BMW-passie als basis.</p>

      <div class="usps">
        <div class="usp"><strong>Groot aanbod</strong><span>14.000+ BMW-motoren op de Duitse markt — gerichte keuze in uitvoering en kleur.</span></div>
        <div class="usp"><strong>Lage motor-BPM</strong><span>Veel lager en simpeler dan auto-BPM — bij oudere motoren vaak een paar honderd euro.</span></div>
        <div class="usp"><strong>Snel &amp; binnen de EU</strong><span>Geen invoerrechten, geen zeevracht. Doorlooptijd doorgaans 1-3 weken.</span></div>
      </div>

      <h2>Kies je model</h2>
      <div class="card-grid">
        {modellen.map((m) => (
          <a href={m.href} class="moto-card">
            <span class="card-tag">{m.tag}</span>
            <h3>{m.title}</h3>
            <p>{m.desc}</p>
            <span class="card-link">Bekijk koopgids →</span>
          </a>
        ))}
      </div>

      <h2>Importeren, kosten &amp; techniek</h2>
      <div class="card-grid">
        {gidsen.map((g) => (
          <a href={g.href} class="moto-card subtle">
            <h3>{g.title}</h3>
            <p>{g.desc}</p>
            <span class="card-link">Lees verder →</span>
          </a>
        ))}
      </div>

      <div class="page-cta">
        <h2>Een BMW-motor op het oog?</h2>
        <p>Vertel ons model, bouwjaar, uitvoering en budget — wij screenen mobile.de en Kleinanzeigen.de, beoordelen de staat, en regelen de hele import met een eerlijke rijklaar-prijs vooraf.</p>
        <a href="/contact" class="page-cta-btn">Plan intake-gesprek<span class="arrow" aria-hidden="true">→</span></a>
        <p class="page-cta-note">Binnen 24 uur reactie · Geen verkoopdruk</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .moto-page { padding: 64px 0 96px; }
  .moto-page h1 { font-size: 52px; font-weight: 600; margin-bottom: 20px; line-height: 1.06; max-width: 860px; }
  .moto-page h1 .accent { color: var(--color-copper-text); }
  .lead { font-size: 19px; color: var(--color-text-secondary); line-height: 1.65; max-width: 820px; margin-bottom: 40px; }
  .moto-page h2 { font-size: 28px; font-weight: 600; margin: 48px 0 20px; }

  .usps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 16px; }
  .usp { background: var(--color-cream-warm); border-left: 3px solid var(--color-copper-text); padding: 20px 22px; }
  .usp strong { display: block; color: var(--color-text-primary); font-size: 16px; margin-bottom: 6px; }
  .usp span { font-size: 14px; color: var(--color-text-secondary); line-height: 1.55; }

  .card-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .moto-card { display: flex; flex-direction: column; background: var(--color-white); border: 1px solid var(--color-border-soft); border-left: 3px solid var(--color-copper-text); padding: 24px 24px 22px; text-decoration: none; color: inherit; transition: transform 0.2s, box-shadow 0.2s; }
  .moto-card:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(0,0,0,0.08); }
  .moto-card.subtle { border-left-color: var(--color-border-medium); }
  .card-tag { font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-copper-text); font-weight: 600; margin-bottom: 8px; }
  .moto-card h3 { font-size: 21px; font-weight: 600; margin-bottom: 8px; }
  .moto-card p { font-size: 14px; color: var(--color-text-secondary); line-height: 1.55; margin-bottom: 16px; flex-grow: 1; }
  .card-link { font-size: 13px; font-weight: 600; color: var(--color-copper-text); }

  .page-cta { margin-top: 72px; padding: 56px 40px; background: var(--color-charcoal-dark); color: var(--color-cream); text-align: center; }
  .page-cta h2 { color: var(--color-cream); margin: 0 0 12px; }
  .page-cta p { color: rgba(245,241,234,0.85); margin-bottom: 24px; font-size: 16px; }
  .page-cta-btn { display: inline-flex; align-items: center; gap: 12px; padding: 18px 36px; background: var(--color-copper-text); color: var(--color-charcoal-dark); font-size: 14px; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; text-decoration: none; transition: transform 0.2s, background 0.2s; }
  .page-cta-btn:hover { transform: translateY(-2px); background: #d18a3f; }
  .page-cta-note { margin-top: 16px; font-size: 12px; color: rgba(245,241,234,0.6); }

  @media (max-width: 880px) {
    .usps, .card-grid { grid-template-columns: 1fr; }
    .moto-page h1 { font-size: 34px; }
  }
</style>
