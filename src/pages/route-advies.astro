  ruim: { label: 'Ruim aanbod', icon: '●●●', cssClass: 'level-best', desc: 'Wekelijks LHD-aanbod (4+ per maand)' },
  regelmatig: { label: 'Regelmatig', icon: '●●', cssClass: 'level-good', desc: 'Maandelijks 1-3 LHD-units beschikbaar' },
  incidenteel: { label: 'Incidenteel', icon: '●', cssClass: 'level-ok', desc: 'Eens per 1-3 maanden' },
  zeldzaam: { label: 'Zeldzaam', icon: '○', cssClass: 'level-warn', desc: 'Eens per half jaar of langer' },
  niet: { label: 'Geen aanbod', icon: '×', cssClass: 'level-no', desc: 'Praktisch geen LHD-aanbod' },
